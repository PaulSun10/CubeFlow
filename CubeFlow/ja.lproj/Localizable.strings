"algs.item.f2l.title" = "F2L";
"algs.item.f2l.description" = "F2L は、コーナーとエッジをペアにしてそれらを一緒に挿入することで、最初の 2 つのレイヤーを解決します。";
"algs.item.oll.title" = "OLL";
"algs.item.oll.description" = "OLL は、上面が 1 つの単色になるように、すべての最後のレイヤー ピースの向きを調整します。";
"algs.item.pll.title" = "PLL";
"algs.item.pll.description" = "PLL は向きが揃った最後の層のピースを並べ替えます。";
"algs.item.advancedf2l.title" = "Advanced F2L";
"algs.item.advancedf2l.description" = "Advanced F2L は、特定の最初の 2 層のケースに特化したソリューションで標準ペア挿入を拡張します。";
"algs.item.coll.title" = "COLL";
"algs.item.coll.description" = "COLL は、エッジがすでに方向付けられている場合に、最後のレイヤーのすべてのコーナーを解決して方向付けします。";
"algs.item.wv.title" = "Winter Variation (WV)";
"algs.item.wv.description" = "Winter variation は、最後のレイヤーのすべてのエッジの向きを調整しながら、最後の F2L ペアを解決します。";
"algs.item.sv.title" = "Summer Variation (SV)";
"algs.item.sv.description" = "Summer variation は、最後のレイヤーの角をすべて方向付けしながら、最後の F2L ペアを解決します。";
"algs.item.cls.title" = "Corner Last Slot (CLS)";
"algs.item.cls.description" = "CLS は最後の F2L スロットを解きながら最後の層を制御します。";
"algs.item.sbls.title" = "Second Block Last Slot";
"algs.item.sbls.description" = "Second Block Last Slot は Roux の第2ブロック最後のスロットを仕上げ、後続を整えます。";
"algs.item.cmll.title" = "CMLL";
"algs.item.cmll.description" = "CMLL は Roux で最初の2ブロック後に最後の層のコーナーを解きます。";
"algs.item.4a.title" = "Edge Orientation (4a)";
"algs.item.4a.description" = "Edge Orientation (4a) は Roux の最終エッジ解法前に残りエッジを向き付けます。";
"algs.item.zbll.title" = "ZBLL";
"algs.item.zbll.description" = "ZBLL はエッジが向き付け済みのとき、最後の層を1手順で解きます。";
"algs.item.vls.title" = "VLS";
"algs.item.vls.description" = "VLS は、最後のレイヤーの角をすべて方向付けしながら、最後の F2L ペアを解決します。";
"algs.item.ollcp.title" = "OLLCP";
"algs.item.ollcp.description" = "OLLCP は最後の層を向き付けながらコーナー permutation も制御します。";
"algs.item.zbls.title" = "ZBLS";
"algs.item.zbls.description" = "ZBLS は最後の F2L ペアを解きながら最後の層のエッジを向き付けます。";
"algs.item.1lll.title" = "1LLL";
"algs.item.1lll.description" = "1LLL は、最後の層全体を単一のアルゴリズムで解決します。";
"algs.item.ortegaoll.title" = "Ortega OLL";
"algs.item.ortegaoll.description" = "Ortega OLL は、並べ替えの前に、すべてのステッカーを 2x2 の最終レイヤーに配置します。";
"algs.item.ortegapbl.title" = "Ortega PBL";
"algs.item.ortegapbl.description" = "Ortega PBL は向きが揃った後、2x2 の両層を並べ替えます。";
"algs.item.cll.title" = "CLL";
"algs.item.cll.description" = "CLL は1層目を保ったまま 2x2 の最後の層のコーナーを1手順で解きます。";
"algs.item.eg1.title" = "EG-1";
"algs.item.eg1.description" = "EG-1 は、隣接するスワップ指向の最初のレイヤー状態の後の 2x2 の最後のレイヤーを解決します。";
"algs.item.eg2.title" = "EG-2";
"algs.item.eg2.description" = "EG-2 は、対角線のスワップ指向の最初のレイヤー状態の後の 2x2 の最後のレイヤーを解決します。";
"algs.item.ollparity.title" = "OLL Parity";
"algs.item.ollparity.description" = "4x4 OLL Parity は最後の層の奇数層向きパリティを直します。";
"algs.item.pllparity.title" = "PLL Parity";
"algs.item.pllparity.description" = "4x4 PLL Parity は最後の層の奇数層 permutation パリティを直します。";
"algs.item.l2e.title" = "Last Two Edges (L2E)";
"algs.item.l2e.description" = "L2E は 5x5 の最後の2つの dedge を解きます。";
"algs.item.l2c.title" = "Last Two Centers (L2C)";
"algs.item.l2c.description" = "L2C は 5x5 の最後の2つのセンターを解きます。";
"algs.item.lin.title" = "Lin";
"algs.item.lin.description" = "Lin は parity-aware な PLL 段階を中心にした Square-1 終盤フレームワークです。";
"algs.item.sq1cs.title" = "復形";
"algs.item.sq1cs.description" = "Square-1 Cube Shape アルゴリズムは、形状状態を立方体形状に変換します。";
"algs.item.sq1co.title" = "Square-1 CO";
"algs.item.sq1co.description" = "SQ1 CO は復形後に Square-1 のコーナーを向き付けます。";
"algs.item.sq1eo.title" = "Square-1 EO";
"algs.item.sq1eo.description" = "SQ1 EO は最終 permutation 前に Square-1 のエッジを向き付けます。";
"algs.item.sq1cp.title" = "Square-1 CP";
"algs.item.sq1cp.description" = "SQ1 CP は向き付け後に Square-1 のコーナーを並べ替えます。";
"algs.item.sq1parity.title" = "Square-1 Parity";
"algs.item.sq1parity.description" = "SQ1 Parity は Square-1 終盤のパリティ専用ケースを扱います。";
"algs.item.sq1linpll.title" = "SQ1 Lin PLL";
"algs.item.sq1linpll.description" = "Lin PLL はパリティなしの Square-1 終盤 permutation を解きます。";
"algs.item.sq1linparitypll.title" = "SQ1 Lin Parity PLL";
"algs.item.sq1linparitypll.description" = "Lin Parity PLL はパリティありの Square-1 終盤 permutation を解きます。";
"algs.item.sq1ep.title" = "Square-1 EP";
"algs.item.sq1ep.description" = "SQ1 EP は最終段階で Square-1 のエッジを並べ替えます。";
"algs.item.sq1linpll1.title" = "SQ1 Lin PLL+1";
"algs.item.sq1linpll1.description" = "Lin PLL+1 は追加の parity-aware セットアップを含む Square-1 Lin ケースを解きます。";
"algs.item.megaminxoll.title" = "Megaminx OLL";
"algs.item.megaminxoll.description" = "Megaminx OLL は Megaminx の最終層を向き付けます。";
"algs.item.megaminxpll.title" = "Megaminx PLL";
"algs.item.megaminxpll.description" = "Megaminx PLL は Megaminx の最終層を並べ替えます。";
"algs.item.megaminxeo.title" = "Megaminx EO";
"algs.item.megaminxeo.description" = "Megaminx EO は終盤で重要なエッジを向き付けます。";
"algs.item.megaminxco.title" = "Megaminx CO";
"algs.item.megaminxco.description" = "Megaminx CO は Megaminx の最終層コーナーを向き付けます。";
"algs.item.megaminxep.title" = "Megaminx EP";
"algs.item.megaminxep.description" = "Megaminx EP は Megaminx の最終層エッジを並べ替えます。";
"algs.item.megaminxcp.title" = "Megaminx CP";
"algs.item.megaminxcp.description" = "Megaminx CP は Megaminx の最終層コーナーを並べ替えます。";
