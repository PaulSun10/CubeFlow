"algs.info.ortegaoll.title" = "Informazioni su Ortega OLL";
"algs.info.ortegaoll.subtitle" = "Panoramica, riconoscimento e pratica di Ortega OLL";
"algs.info.ortegaoll.overview.p1" = "Set di algoritmi per praticare riconoscimento ed esecuzione di Ortega OLL.";
"algs.info.ortegaoll.context.p1" = "Ortega OLL viene usato come classificazione pratica nello speedcubing. In CubeFlow segue la struttura di SpeedCubeDB per rendere lo studio più ordinato.";
"algs.info.ortegaoll.structure.b1" = "Questa classificazione contiene **7 casi**";
"algs.info.ortegaoll.structure.b2" = "Inizia dai casi frequenti o facili da riconoscere.";
"algs.info.ortegaoll.structure.b3" = "Raggruppare i casi per famiglie visive rende il riconoscimento più stabile rispetto a una lista piatta.";
"algs.info.ortegaoll.structure.b4" = "Nei solve reali contano anche grip, angolo e transizioni, non solo la lunghezza dell’algoritmo.";
"algs.info.ortegaoll.insights.p1" = "Studia questo set a piccoli blocchi e ripassa gli errori finché l’esecuzione diventa automatica.";
"algs.info.ortegaoll.insights.p2" = "Confronta i casi simili fianco a fianco per evitare confusioni durante il solve.";
"algs.info.ortegaoll.insights.p3" = "Usa il trainer per trasformare un riconoscimento lento in una reazione più naturale.";
"algs.info.ortegaoll.recognition.p1" = "Riconosci il pattern visivo principale, conferma i pezzi critici e scegli un angolo che mantenga una buona esecuzione.";
"algs.info.ortegaoll.recommended.p1" = "Consigliato ai cuber che conoscono già lo step precedente e vogliono una soluzione più pulita o più veloce.";
"algs.info.ortegaoll.quote.p1" = "Imparare Ortega OLL è più facile se lo tratti come famiglie di pattern, non come una lista casuale.";
