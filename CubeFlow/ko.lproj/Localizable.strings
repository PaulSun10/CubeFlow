"algs.item.f2l.title" = "F2L";
"algs.item.f2l.description" = "F2L은 모서리와 모서리를 쌍으로 연결하고 함께 삽입하여 처음 두 레이어를 해결합니다.";
"algs.item.oll.title" = "OLL";
"algs.item.oll.description" = "OLL은 모든 마지막 레이어 조각의 방향을 지정하여 윗면이 하나의 단색이 되도록 합니다.";
"algs.item.pll.title" = "PLL";
"algs.item.pll.description" = "PLL은 이미 방향이 지정된 후 모든 마지막 레이어 조각을 순열합니다.";
"algs.item.advancedf2l.title" = "Advanced F2L";
"algs.item.advancedf2l.description" = "고급 F2L은 특정 첫 번째 2계층 케이스에 대한 보다 전문화된 솔루션으로 표준 쌍 삽입을 확장합니다.";
"algs.item.coll.title" = "COLL";
"algs.item.coll.description" = "COLL은 가장자리의 방향이 이미 지정되어 있는 경우 모든 마지막 레이어 모서리를 해결하고 방향을 지정합니다.";
"algs.item.wv.title" = "Winter Variation (WV)";
"algs.item.wv.description" = "Winter Variation은 모든 마지막 레이어 가장자리의 방향을 지정하면서 마지막 F2L 쌍을 해결합니다.";
"algs.item.sv.title" = "Summer Variation (SV)";
"algs.item.sv.description" = "Summer Variation은 모든 마지막 레이어 모서리의 방향을 지정하면서 마지막 F2L 쌍을 해결합니다.";
"algs.item.cls.title" = "Corner Last Slot (CLS)";
"algs.item.cls.description" = "CLS는 단일 알고리즘으로 마지막 레이어를 제어하면서 최종 F2L 슬롯을 해결합니다.";
"algs.item.sbls.title" = "Second Block Last Slot";
"algs.item.sbls.description" = "두 번째 블록 마지막 슬롯은 마지막 레이어를 준비하면서 루에서 두 번째 블록의 마지막 슬롯을 마무리합니다.";
"algs.item.cmll.title" = "CMLL";
"algs.item.cmll.description" = "CMLL은 처음 두 블록이 완료된 후 Roux의 모든 마지막 레이어 모서리를 해결합니다.";
"algs.item.4a.title" = "Edge Orientation (4a)";
"algs.item.4a.description" = "모서리 방향(4a)은 최종 모서리 해결 단계 전에 Roux의 나머지 모서리 방향을 지정합니다.";
"algs.item.zbll.title" = "ZBLL";
"algs.item.zbll.description" = "ZBLL은 가장자리의 방향이 지정될 때 하나의 알고리즘으로 마지막 레이어를 해결합니다.";
"algs.item.vls.title" = "VLS";
"algs.item.vls.description" = "VLS는 모든 마지막 레이어 모서리의 방향을 지정하면서 마지막 F2L 쌍을 해결합니다.";
"algs.item.ollcp.title" = "OLLCP";
"algs.item.ollcp.description" = "OLLCP는 모서리 순열을 유지하면서 마지막 레이어의 방향을 지정합니다.";
"algs.item.zbls.title" = "ZBLS";
"algs.item.zbls.description" = "ZBLS는 마지막 레이어 가장자리의 방향을 지정하면서 마지막 F2L 쌍을 해결합니다.";
"algs.item.1lll.title" = "1LLL";
"algs.item.1lll.description" = "1LLL은 단일 알고리즘으로 마지막 레이어 전체를 해결합니다.";
"algs.item.ortegaoll.title" = "Ortega OLL";
"algs.item.ortegaoll.description" = "Ortega OLL은 순열 전에 2x2에 대한 최종 레이어의 모든 스티커 방향을 지정합니다.";
"algs.item.ortegapbl.title" = "Ortega PBL";
"algs.item.ortegapbl.description" = "Ortega PBL은 오리엔테이션이 완료된 후 두 레이어를 2x2로 순열합니다.";
"algs.item.cll.title" = "CLL";
"algs.item.cll.description" = "CLL은 첫 번째 레이어를 유지하면서 하나의 알고리즘으로 2x2 마지막 레이어 모서리를 해결합니다.";
"algs.item.eg1.title" = "EG-1";
"algs.item.eg1.description" = "EG-1은 인접한 스왑 지향 첫 번째 레이어 상태 이후의 2x2 마지막 레이어를 해결합니다.";
"algs.item.eg2.title" = "EG-2";
"algs.item.eg2.description" = "EG-2는 대각선 스왑 지향 첫 번째 레이어 상태 이후 2x2 마지막 레이어를 해결합니다.";
"algs.item.ollparity.title" = "OLL Parity";
"algs.item.ollparity.description" = "4x4 OLL 패리티는 마지막 레이어의 홀수 레이어 방향 패리티를 수정합니다.";
"algs.item.pllparity.title" = "PLL Parity";
"algs.item.pllparity.description" = "4x4 PLL 패리티는 마지막 레이어의 홀수 레이어 순열 패리티를 수정합니다.";
"algs.item.l2e.title" = "Last Two Edges (L2E)";
"algs.item.l2e.description" = "L2E는 5x5에서 마지막 두 개의 데지를 해결합니다.";
"algs.item.l2c.title" = "Last Two Centers (L2C)";
"algs.item.l2c.description" = "L2C는 5x5에서 마지막 두 개의 중앙 부분을 해결합니다.";
"algs.item.lin.title" = "Lin";
"algs.item.lin.description" = "Lin은 패리티 인식 PLL 단계를 중심으로 한 Square-1 최종 게임 프레임워크입니다.";
"algs.item.sq1cs.title" = "큐브 모양";
"algs.item.sq1cs.description" = "Square-1 Cube Shape 알고리즘은 모양 상태를 큐브 모양으로 변환합니다.";
"algs.item.sq1co.title" = "Square-1 CO";
