"algs.info.sbls.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Second Block Last Slot.";
"algs.info.sbls.history.p1" = "Second Block Last Slot jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.sbls.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.sbls.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.sbls.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.sbls.size.b4" = "Często uczy się selektywnie, dla każdego przypadku, przez Roux rozwiązujących, którzy lubią dodatkową strukturę";
"algs.info.sbls.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.sbls.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.sbls.insights.p3" = "To sprawia, że SBLS jest szczególnie cenny dla Roux użytkowników zorientowanych na teorię, którzy lubią ukierunkowane optymalizacje, a nie gigantyczne obowiązkowe zestawy.";
"algs.info.sbls.recognition.p1" = "Rozpoznawanie SBLS opiera się na końcowej relacji drugiego bloku i określonej ścieżce wstawiania lub rozdzielczości, która najlepiej zachowuje pożądany kształt w następnej fazie.";
"algs.info.sbls.recommended.p1" = "Zalecane dla uznanych solwentów Roux, którzy już dobrze rozumieją strukturę drugiego bloku i chcą raczej selektywnego zaawansowanego podzbioru niż szerokiego przeglądu metod.";
"algs.info.sbls.quote.p1" = "„SBLS jest najbardziej przydatny, gdy drugi blok przestaje sprawiać wrażenie zadania budowlanego, a zaczyna wydawać się szansą na zaprojektowanie lepszego wykończenia”.";
"algs.info.cmll.title" = "O CMLL";
"algs.info.cmll.subtitle" = "Definicja, historia i skuteczność CMLL";
"algs.info.cmll.section.overview" = "Przegląd";
"algs.info.cmll.section.history" = "Kontekst";
"algs.info.cmll.section.size" = "Rozmiar i efektywność";
"algs.info.cmll.section.insights" = "Najważniejsze punkty";
"algs.info.cmll.section.recognition" = "Rozpoznawanie";
"algs.info.cmll.section.recommended" = "Polecane dla";
"algs.info.cmll.section.quote" = "Notatka";
"algs.info.cmll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania CMLL.";
"algs.info.cmll.history.p1" = "CMLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.cmll.size.b1" = "Ta klasyfikacja zawiera **42 algorytmów**";
"algs.info.cmll.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.cmll.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.cmll.size.b4" = "Jeden z najważniejszych formalnych kamieni milowych algorytmu w Roux";
"algs.info.cmll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.cmll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.cmll.insights.p3" = "Pokazuje również, dlaczego Roux może pozostać wydajne przy stosunkowo niewielkim rozproszeniu ostatniej warstwy: czysto rozwiązuj rogi, a następnie pozwól, aby końcowa faza krawędzi zrobiła resztę.";
"algs.info.cmll.recognition.p1" = "CMLL jest rozpoznawany po wzorze narożnika ostatniej warstwy po zbudowaniu dwóch bloków Roux. W praktyce wiele rozwiązań wykorzystuje kształty narożników górnych i niewielką ilość informacji bocznych, aby szybko zamknąć obudowę.";
"algs.info.cmll.recommended.p1" = "Zalecane dla każdego poważnego rozwiązania Roux. W porównaniu z wieloma opcjonalnymi zaawansowanymi podzbiorami, CMLL jest znacznie bliższy kamieniowi milowemu metody podstawowej niż niszowemu projektowi pobocznemu.";
"algs.info.cmll.quote.p1" = "„CMLL sprawia wrażenie potężnego, ponieważ zapewnia Roux bardzo zdyscyplinowane środkowe zakończenie: rogi są wykańczane zdecydowanie, a metoda może przejść bezpośrednio do ostatecznej pracy nad krawędzią”.";
"algs.info.4a.title" = "O Edge Orientation (4a)";
"algs.info.4a.subtitle" = "Definicja, historia i skuteczność 4a";
"algs.info.4a.section.overview" = "Przegląd";
"algs.info.4a.section.history" = "Kontekst";
"algs.info.4a.section.size" = "Rozmiar i efektywność";
