"algs.info.cls.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Corner Last Slot (CLS).";
"algs.info.cls.history.p1" = "Corner Last Slot (CLS) jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.cls.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.cls.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.cls.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.cls.size.b4" = "Zwykle uczy się selektywnie, a nie w ramach pojedynczego projektu na raz";
"algs.info.cls.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.cls.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.cls.insights.p3" = "Studiowanie CLS pomaga również w zbudowaniu bardziej spójnego spojrzenia na teorię sześcianu: struktura szczelin, kontrola narożników i kompresja ostatniej warstwy stają się częścią jednej, ciągłej decyzji.";
"algs.info.cls.recognition.p1" = "Rozpoznanie CLS zależy od odczytania ostatniej pary wraz ze stanem narożnika, który chcesz zachować lub rozwiązać. W porównaniu z zestawami w stylu WV obciążenie rozpoznawaniem jest większe, ponieważ liczy się więcej informacji o narożnikach.";
"algs.info.cls.recommended.p1" = "Zalecane dla zaawansowanych solwerów CFOP, którzy już korzystają z systemów z ostatnim slotem i chcą zbadać przypadki, które wykonują znacznie więcej pracy niż zwykłe wstawki lub proste podzbiory z pomijaniem OLL.";
"algs.info.cls.quote.p1" = "„CLS przypomina, że ostatni slot to nie tylko koniec F2L; w odpowiednim przypadku to już początek mety.”";
