"algs.info.zbll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania ZBLL.";
"algs.info.zbll.history.p1" = "ZBLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.zbll.size.b1" = "Ta klasyfikacja zawiera **472 algorytmów**";
"algs.info.zbll.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.zbll.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.zbll.size.b4" = "Szczególnie przydatne w metodach takich jak **ZZ**, gdzie orientacja krawędzi zostaje zachowana po F2L";
"algs.info.zbll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.zbll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.zbll.insights.p3" = "Zbiory te są następnie dzielone dalej na **podzbiory**. W pełnej klasyfikacji każdy podzbiór zawiera **12 przypadków** odpowiadających różnym **cyklom krawędziowym**, które mogą wystąpić, gdy przypadek COLL pozostaje taki sam.";
"algs.info.zbll.recognition.p1" = "ZBLL przypadki rozpoznawane są poprzez identyfikację zarówno podstawowego **COLL przypadku**, jak i odpowiadającego mu **cyklu krawędziowego**. Wzór narożników określa rodzinę główną, podczas gdy permutacja krawędzi określa dokładny przypadek w tej rodzinie.";
"algs.info.zbll.recommended.p1" = "Polecany dla kostek, które znają już **full PLL i OLL** i chcą bardziej zaawansowanych, jednowarstwowych rozwiązań ostatniej warstwy. Jest szczególnie odpowiedni dla **ZZ** solwerów, ale może być również przydatny dla **CFOP** użytkowników, którzy chcą zmniejszyć liczbę kroków w ostatniej warstwie i zbadać bardziej wydajne wykończenia.";
"algs.info.zbll.quote.p1" = "\"Większość sześcianów nie uczy się ZBLL od razu. Budują go **podzbiór po podzbiorze**, zaczynając od przypadków, które oferują najwyraźniejszą **wartość praktyczną**.\"";
