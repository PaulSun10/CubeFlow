"algs.info.1lll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania 1LLL.";
"algs.info.1lll.history.p1" = "1LLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.1lll.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.1lll.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.1lll.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.1lll.size.b4" = "Pułap wydajności jest niezwykle wysoki, ale obciążenie nauką jest również jednym z największych w speedcubingu";
"algs.info.1lll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.1lll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.1lll.insights.p3" = "Mimo to myślenie w kategoriach 1LLL może być przydatne. Pomaga to wyjaśnić, dlaczego zestawy takie jak COLL, OLLCP i ZBLL wydają się ze sobą powiązane: wszystkie zmierzają do tego samego celu, jakim jest zmniejszenie ostatniej warstwy do coraz mniejszej liczby znaczących decyzji.";
"algs.info.1lll.recognition.p1" = "Rozpoznawanie w 1LLL zależy całkowicie od użytego podzbioru. Niektóre rodziny zaczynają od zorientowanych krawędzi, niektóre od warunków ostatniego slotu, a niektóre od szerszych wzorów w stylu OLL plus dodatkowe szczegóły permutacji.";
"algs.info.1lll.recommended.p1" = "Zalecane dla zaawansowanych, zorientowanych na teorię rozwiązań, którzy już rozumieją główne rodziny ostatniej warstwy i chcą zobaczyć, jak te systemy pasują do większej, jednolitej struktury, a nie dla każdego, kto szuka małego, praktycznego następnego zestawu.";
"algs.info.1lll.quote.p1" = "„1LLL to mniej zestaw, którego się uczysz, a bardziej horyzont, który wyjaśnia, dlaczego tak wiele zaawansowanych systemów ostatniej warstwy dąży do tego samego pomysłu: rozwiązać wszystko na raz”.";
