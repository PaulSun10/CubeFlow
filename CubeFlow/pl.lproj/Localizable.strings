"algs.info.oll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania OLL.";
"algs.info.oll.history.p1" = "OLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.oll.size.b1" = "Ta klasyfikacja zawiera **57 algorytmów**";
"algs.info.oll.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.oll.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.oll.size.b4" = "Służy do konwersji ostatniej warstwy do stanu, który można zakończyć za pomocą **PLL**";
"algs.info.oll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.oll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.oll.insights.p3" = "Nawet wśród zaawansowanych rozwiązań nie wszystkie przypadki OLL wydają się równe. Niektóre są niezwykle ergonomiczne i szybkie, podczas gdy inne zapamiętuje się bardziej na podstawie wskazówek rozpoznawczych i nawyków konfiguracyjnych niż na podstawie liczby ruchów.";
"algs.info.oll.recognition.p1" = "OLL rozpoznaje się po wzorze orientacji ostatniej warstwy: kształcie utworzonym przez zorientowane krawędzie plus orientacja widocznych narożników górnej warstwy. Skuteczne rozpoznawanie zwykle łączy kształt górnej części twarzy z naklejkami bocznymi.";
"algs.info.oll.recommended.p1" = "Polecany dla kostek, które już znają **full PLL** i chcą kompletnej, dwuetapowej ostatniej warstwy. Pełne OLL jest głównym praktycznym ulepszeniem dla CFOP i warunkiem wstępnym zrozumienia bardziej zaawansowanych systemów ostatniej warstwy.";
"algs.info.oll.quote.p1" = "„Nauka OLL nie polega na zapamiętywaniu 57 przypadkowych obrazków, a bardziej na budowaniu pewności siebie dzięki garstce **rodzin rozpoznawania**, które powtarzają się w całym zestawie”.";
"algs.info.f2l.title" = "O F2L";
