"algs.info.wv.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Winter Variation (WV).";
"algs.info.wv.history.p1" = "Winter Variation (WV) jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.wv.size.b1" = "Ta klasyfikacja zawiera **27 algorytmów**";
"algs.info.wv.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.wv.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.wv.size.b4" = "Często uczył się przed większymi rodzinami z ostatnim gniazdem, ponieważ zestaw jest kompaktowy i praktyczny";
"algs.info.wv.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.wv.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.wv.insights.p3" = "Ze względu na swój rozmiar i praktyczną zaletę WV często pełni rolę bramy. Soliści, którzy to lubią, często sięgają po **VLS**, **ZBLS** lub inne systemy ostatniego slotu uwzględniające orientację krawędziową.";
"algs.info.wv.recognition.p1" = "WV rozpoznaje się patrząc na ostatnią parę i potwierdzając, że krawędzie ostatniej warstwy są już zorientowane. Od tego momentu struktura pary i kierunek wstawiania określają dokładny przypadek.";
"algs.info.wv.recommended.p1" = "Zalecane dla kostek ze stabilnym F2L, które chcą mieć swój pierwszy poważny podzbiór na ostatnim slocie. Jest to szczególnie dobre dla solwerów CFOP, którzy już zauważają orientację krawędzi podczas rozwiązywania i chcą efektywniejszych przejść do ostatniej warstwy.";
"algs.info.wv.quote.p1" = "„Zimowa odmiana to często pierwszy moment, w którym osoba rozwiązująca zdaje sobie sprawę, że ostatni slot może zdziałać więcej niż tylko ukończenie F2L — może też po cichu uprościć całą ostatnią warstwę”.";
