"algs.info.vls.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania VLS.";
"algs.info.vls.history.p1" = "VLS jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.vls.size.b1" = "Ta klasyfikacja zawiera **432 algorytmów**";
"algs.info.vls.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.vls.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.vls.size.b4" = "Powszechnie nauczane, zaczynając od **Odmiany zimowe**, a następnie rozszerzając podzbiór po podzbiorze";
"algs.info.vls.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.vls.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.vls.insights.p3" = "Ponieważ VLS bierze udział w podejmowaniu decyzji w ostatniej chwili, jego praktyczna siła zależy w dużej mierze od szybkości rozpoznawania. Teoretycznie mocny przypadek jest użyteczny tylko wtedy, gdy osoba rozwiązująca może go wykryć bez niszczenia przepływu F2L.";
"algs.info.vls.recognition.p1" = "VLS rozpoznaje się, patrząc na sparowane elementy ostatniej szczeliny wraz ze stanem orientacji pozostałych krawędzi i narożników ostatniej warstwy. Skuteczne rozpoznawanie zależy od jednoczesnego zobaczenia zarówno wzoru szczeliny, jak i orientacji ostatniej warstwy.";
"algs.info.vls.recommended.p1" = "Zalecane dla zaawansowanych **CFOP** solwerów, którzy mają już stabilne F2L i chcą zredukować kroki ostatniej warstwy z ostatniego slotu. Jest to szczególnie atrakcyjne dla kostek, które korzystają z podzbiorów ostatniego slotu, takich jak **WV**, **ZBLS** i systemów pokrewnych.";
"algs.info.vls.quote.p1" = "\"VLS jest potężny, ponieważ nie wymaga osobnego cudu w ostatniej warstwie. Pyta, czy sama ostatnia para może spokojnie zapewnić szybsze wykończenie. \"";
"algs.info.wv.title" = "O Winter Variation (WV)";
