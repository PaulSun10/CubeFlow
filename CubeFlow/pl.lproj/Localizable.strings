"algs.info.pllparity.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.pllparity.structure.b4" = "Istnieje wiele wariantów, ale dla większości rozwiązań wystarczy mały, niezawodny zestaw narzędzi";
"algs.info.pllparity.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.pllparity.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.pllparity.insights.p3" = "Ponieważ parzystość PLL często pojawia się pod koniec rozwiązania, cenne jest spokojne wykonanie. Zamknięcie w tym miejscu może wymazać wiele dobrej pracy z wcześniejszych faz.";
"algs.info.pllparity.recognition.p1" = "Poszukaj zredukowanej ostatniej warstwy, w której pozostała permutacja wymagałaby zamiany pojedynczej pary krawędzi lub w inny sposób naruszałaby normalną parzystość 3x3.";
"algs.info.pllparity.recommended.p1" = "Zalecane dla każdego rozwiązywania 4x4. Najpierw naucz się jednego niezawodnego algorytmu, a następnie dodawaj szybsze warianty tylko wtedy, gdy często rozwiązujesz zdarzenie.";
"algs.info.pllparity.quote.p1" = "PLL parzystość nie jest dziwna PLL; taka jest cena udawania, że ​​sześcian o równej warstwie stał się 3x3.";
