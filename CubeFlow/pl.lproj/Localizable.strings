"algs.info.zbls.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania ZBLS.";
"algs.info.zbls.history.p1" = "ZBLS jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.zbls.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.zbls.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.zbls.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.zbls.size.b4" = "Zwykle uczy się selektywnie, ponieważ pełna rodzina jest zbyt duża, aby większość kostek mogła zająć się nią na raz";
"algs.info.zbls.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.zbls.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.zbls.insights.p3" = "Dla sześcianów zorientowanych na teorię ZBLS jest także jednym z najwyraźniejszych okien pokazujących, jak łączą się zaawansowane metody: struktura F2L, orientacja krawędzi i planowanie ostatniej warstwy spotykają się w jednym miejscu.";
"algs.info.zbls.recognition.p1" = "ZBLS jest rozpoznawany poprzez odczytanie ostatniej pary wraz z pożądanym wynikiem orientacji krawędzi. Dokładny przypadek zależy od sposobu ułożenia pary i od tego, jakie wstawienie zachowuje lub tworzy pożądany stan krawędzi.";
"algs.info.zbls.recommended.p1" = "Zalecane dla zaawansowanych solwerów CFOP z silnym F2L i poważnym zainteresowaniem systemami z ostatnim slotem. Jest to szczególnie istotne dla kostek, które już lubią WV lub chcą zrozumieć praktyczną stronę szerszej metody ZB.";
"algs.info.zbls.quote.p1" = "„ZBLS to miejsce, w którym ostatnie miejsce przestaje być zadaniem porządkowym, a zaczyna stać się pełną konfiguracją strategiczną dla ostatniej warstwy”.";
"algs.info.1lll.title" = "O 1LLL";
