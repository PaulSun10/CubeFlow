"algs.info.l2e.recognition.p1" = "Rozpoznawanie koncentruje się na tym, jak dwie pozostałe pary skrzydeł są podzielone na przód, tył i pozycję plasterka, a także na tym, czy krótka konfiguracja może zmienić stan w znajomy przypadek.";
"algs.info.l2e.recommended.p1" = "Zalecane, gdy możesz wygodnie ukończyć 5x5 centra i większość krawędzi, ale nadal tracisz czas na dwóch ostatnich krawędziach.";
"algs.info.l2e.quote.p1" = "L2E to mała brama pomiędzy budynkiem z dużej kostki a znanym wykończeniem 3x3.";
