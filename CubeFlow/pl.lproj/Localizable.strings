"algs.info.ortegaoll.title" = "O Ortega OLL";
"algs.info.ortegaoll.subtitle" = "Krok orientacji w metodzie 2x2 Ortegi";
"algs.info.ortegaoll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Ortega OLL.";
"algs.info.ortegaoll.context.p1" = "Ortega OLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.ortegaoll.structure.b1" = "Ta klasyfikacja zawiera **7 przypadków**";
"algs.info.ortegaoll.structure.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.ortegaoll.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.ortegaoll.structure.b4" = "Niska liczba algorytmów sprawia, że jest to silna metoda zapewniająca pierwszą prędkość";
"algs.info.ortegaoll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.ortegaoll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.ortegaoll.insights.p3" = "Dla wielu sześcianów Ortega OLL jest także pomostem do CLL i EG: uczy idei rozwiązywania najpierw orientacji, pozostawiając permutację dla mocniejszego ostatniego kroku.";
"algs.info.ortegaoll.recognition.p1" = "Rozpoznawanie odbywa się na podstawie wzoru zorientowanych naklejek na górnej powierzchni. Ponieważ jest tylko kilka przypadków, główną umiejętnością jest wybór kąta, który w naturalny sposób prowadzi do szybkiego rozpoznania PBL.";
"algs.info.ortegaoll.recommended.p1" = "Zalecane dla każdego, kto wykracza poza początkujący 2x2. Naucz się tego w PBL, a później zdecyduj, czy kontynuować naukę w CLL czy EG.";
"algs.info.ortegaoll.quote.p1" = "Ortega OLL jest niewielka, ale uczy jednego z najważniejszych 2x2 nawyków: zbuduj użyteczną twarz, a następnie zakończ od czytelnego stanu ostatniej warstwy.";
"algs.info.ortegapbl.title" = "O Ortega PBL";
"algs.info.ortegapbl.subtitle" = "Permutuj obie warstwy po orientacji Ortegi";
"algs.info.ortegapbl.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Ortega PBL.";
"algs.info.ortegapbl.context.p1" = "Ortega PBL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.ortegapbl.structure.b1" = "Ta klasyfikacja zawiera **6 przypadków**";
"algs.info.ortegapbl.structure.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.ortegapbl.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.ortegapbl.structure.b4" = "Szybkość rozpoznawania często ma większe znaczenie niż szybkość pierwotnego algorytmu";
"algs.info.ortegapbl.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.ortegapbl.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.ortegapbl.insights.p3" = "Ćwiczenie PBL na prawdziwych mieszadłach Ortegi jest lepsze niż wiercenie tylko rozwiązanych ustawień, ponieważ orientacja dolnej warstwy i kąt widzenia wpływają na szybkość pojawiania się obudowy.";
"algs.info.ortegapbl.recognition.p1" = "Sprawdź, czy górna warstwa ma pasek, czy dolna warstwa ma pasek i czy dwie warstwy wymagają zamiany sąsiadujących lub ukośnych.";
"algs.info.ortegapbl.recommended.p1" = "Polecany bezpośrednio po Ortedze OLL. Bez niezawodnego PBL Ortega będzie czuł się niekompletny, nawet jeśli orientacja będzie szybka.";
"algs.info.ortegapbl.quote.p1" = "PBL to nagroda Ortegi: zamiast narzucać rozwiązanie pierwszej warstwy, pozwalasz, aby ostateczny algorytm wyczyścił obie warstwy na raz.";
"algs.info.cll.title" = "O CLL";
"algs.info.cll.subtitle" = "Ostatnia warstwa w jednym spojrzeniu z rozwiązaną pierwszą warstwą";
"algs.info.cll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania CLL.";
"algs.info.cll.context.p1" = "CLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.cll.structure.b1" = "Ta klasyfikacja zawiera **40 przypadków**";
"algs.info.cll.structure.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.cll.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.cll.structure.b4" = "Często łatwiej kontrolować niż pełne EG, ponieważ dolna warstwa jest rozwiązana";
"algs.info.cll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.cll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.cll.insights.p3" = "Dobra CLL praktyka powinna uwzględniać planowanie pierwszej warstwy. Jeśli warstwa trwa zbyt długo, ostatnia warstwa z jednym spojrzeniem nie pozwoli zaoszczędzić dużo czasu.";
"algs.info.cll.recognition.p1" = "Rozpoznawanie łączy kształt orientacji ostatniej warstwy z permutacją narożników. Większość solwerów najpierw identyfikuje rodzinę orientacji, a następnie potwierdza, który wariant permutacji jest obecny.";
"algs.info.cll.recommended.p1" = "Zalecane, gdy Ortega czuje się komfortowo i chcesz poważnego uaktualnienia o 2x2 bez natychmiastowego podejmowania pełnego obciążenia edukacyjnego EG.";
"algs.info.cll.quote.p1" = "CLL to miejsce, w którym 2x2 zaczyna mniej przypominać zmniejszone 3x3, a bardziej przypominać własną łamigłówkę o jednym wyglądzie.";
"algs.info.eg1.title" = "O EG-1";
"algs.info.eg1.subtitle" = "EG przypadków z sąsiadującą zamianą dolnej warstwy";
"algs.info.eg1.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania EG-1.";
"algs.info.eg1.context.p1" = "EG-1 jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.eg1.structure.b1" = "Ta klasyfikacja zawiera **40 przypadków**";
"algs.info.eg1.structure.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.eg1.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.eg1.structure.b4" = "Wysoka wypłata, ale uznanie i AUF dyscyplina są wymagające";
"algs.info.eg1.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.eg1.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.eg1.insights.p3" = "Wiele osób rozwiązujących używa EG-1 wybiórczo przed nauczeniem się pełnego EG. Często jest to najbardziej praktyczny pierwszy krok poza CLL, ponieważ sąsiednie stany dolne są powszechne i czytelne.";
"algs.info.eg1.recognition.p1" = "Rozpoznawanie rozpoczyna się od relacji dolnej powierzchni, a następnie wykorzystuje wzór narożników górnej warstwy, aby wybrać dokładny algorytm.";
"algs.info.eg1.recommended.p1" = "Zalecane dla zaawansowanych 2x2 solwentów, którzy już znają CLL i chcą przekształcić łatwiejsze kompilacje twarzy w pełne wykończenia o jednym wyglądzie.";
"algs.info.eg1.quote.p1" = "EG-1 nagradza inny rodzaj szybkości: nie tylko szybkie skręcanie, ale także postrzeganie przydatnej, nierozwiązanej ściany jako kompletnego rozwiązania, które czeka, aby się wydarzyć.";
"algs.info.eg2.title" = "O EG-2";
"algs.info.eg2.subtitle" = "EG obudowy z ukośną wymianą dolnej warstwy";
"algs.info.eg2.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania EG-2.";
"algs.info.eg2.context.p1" = "EG-2 jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.eg2.structure.b1" = "Ta klasyfikacja zawiera **40 przypadków**";
"algs.info.eg2.structure.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.eg2.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.eg2.structure.b4" = "Zwykle traktowany jako późny zaawansowany zestaw 2x2";
"algs.info.eg2.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.eg2.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.eg2.insights.p3" = "Jeśli nauczysz się EG-2, przećwicz go, korzystając z kompilacji twarzy w stylu inspekcji, a nie tylko od izolowanych trenerów alg. Wartość pojawia się, gdy ściana i ostatni krok są planowane razem.";
"algs.info.eg2.recognition.p1" = "Najpierw rozpoznaj zależność przekątną na dolnej powierzchni, a następnie zidentyfikuj obudowę narożną górnej warstwy i wymagane AUF.";
"algs.info.eg2.recommended.p1" = "Zalecane dla poważnych osób rozwiązujących 2x2, które znają już CLL i EG-1 i chcą bardziej kompletnego zestawu narzędzi o jednym wyglądzie.";
"algs.info.eg2.quote.p1" = "EG-2 to nie tylko więcej algorytmów; jest to zobowiązanie do traktowania pierwszej ściany jako elastycznego punktu startu, a nie rozwiązanej warstwy.";
