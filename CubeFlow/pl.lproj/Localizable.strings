"algs.info.sarahsadvanced.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.sarahsadvanced.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.sarahsadvanced.insights.p3" = "Praktyczną ścieżką jest najpierw poznanie typowych lub ergonomicznych przypadków, a następnie poszerzanie zakresu, gdy planowanie pierwszej warstwy stanie się bardziej spójne.";
"algs.info.sarahsadvanced.recognition.p1" = "Rozpoznawanie rozpoczyna się po pierwszej warstwie: przeczytaj razem pozostały wzór narożników i pozycje środkowe, ponieważ zaawansowane wykończenie rozwiązuje oba.";
"algs.info.sarahsadvanced.recommended.p1" = "Zalecane dla osób rozwiązujących Skewb, które znają już Sarah's Początkujący lub Średniozaawansowany i chcą głębszego i szybszego systemu wykańczania.";
"algs.info.sarahsadvanced.quote.p1" = "Sarah's Advanced to wersja Skewb pójścia głęboko: mniej kroków, większa odpowiedzialność w rozpoznawaniu.";
