"algs.info.4a.section.recognition" = "Rozpoznawanie";
"algs.info.4a.section.recommended" = "Polecane dla";
"algs.info.4a.section.quote" = "Notatka";
"algs.info.4a.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Edge Orientation (4a).";
"algs.info.4a.history.p1" = "Edge Orientation (4a) jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.4a.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.4a.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.4a.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.4a.size.b4" = "Lepiej postrzegać to jako ukierunkowaną optymalizację niż ogólny kamień milowy w nauce";
"algs.info.4a.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.4a.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.4a.insights.p3" = "Dla osób, którym zależy na orientacji krawędzi, nawet mały zestaw taki jak ten może wyostrzyć sposób widzenia sześcianu i wyraźniej połączyć fazy pośrednie.";
"algs.info.4a.recognition.p1" = "Rozpoznawanie w 4a koncentruje się na odpowiednim wzorcu orientacji krawędzi oraz na tym, czy przypadek odpowiada dokładnemu stanowi, który podzbiór ma kontrolować.";
"algs.info.4a.recommended.p1" = "Zalecane dla zaawansowanych solwerów, którzy już korzystają z podejść uwzględniających orientację krawędziową i chcą raczej małego, bardzo specyficznego podzbioru niż nowej, szerokiej rodziny.";
"algs.info.4a.quote.p1" = "„Zestaw taki jak 4a jest przydatny nie dlatego, że jest ogromny, ale dlatego, że zmienia jeden bardzo specyficzny stan krawędzi w coś przewidywalnego i nadającego się do ponownego użycia”.";
