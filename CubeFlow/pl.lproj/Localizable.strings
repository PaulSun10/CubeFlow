"algs.info.pll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania PLL.";
"algs.info.pll.history.p1" = "PLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.pll.size.b1" = "Ta klasyfikacja zawiera **21 algorytmów**";
"algs.info.pll.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.pll.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.pll.size.b4" = "Używane po **OLL** lub innym kroku, który pozostawia zorientowaną ostatnią warstwę";
"algs.info.pll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.pll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.pll.insights.p3" = "W praktyce PLL nagradza pewność rozpoznawania bardziej niż surową liczbę algorytmów. Wyraźne rozpoznawanie **reflektorów**, **pasków** i bloków bocznych często pozwala zaoszczędzić więcej czasu niż wyeliminowanie jednego ruchu z algorytmu.";
"algs.info.pll.recognition.p1" = "PLL jest rozpoznawane poprzez obserwację permutacji już zorientowanych elementów ostatniej warstwy. Solwerzy zazwyczaj używają takich funkcji, jak **reflektory**, rozwiązane słupki, sąsiednie bloki i ogólne wzorce cyklu krawędzi, aby zidentyfikować przypadek.";
"algs.info.pll.recommended.p1" = "Zalecane dla każdego kostki wykraczającej poza metody ostatniej warstwy dla początkujących. Pełny PLL to jedna z najbardziej praktycznych inwestycji w CFOP i służy również jako podstawa dla bardziej zaawansowanych zestawów, takich jak **COLL**, **OLLCP** i **ZBLL**.";
"algs.info.pll.quote.p1" = "„Pełne PLL to często pierwszy moment, kiedy osoba rozwiązująca czuje, że ostatnia warstwa staje się naprawdę szybka, ponieważ sześcian może teraz ukończyć się w **jednym czystym kroku permutacji**.”";
