"algs.info.advancedf2l.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Advanced F2L.";
"algs.info.advancedf2l.history.p1" = "Advanced F2L jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.advancedf2l.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.advancedf2l.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.advancedf2l.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.advancedf2l.size.b4" = "Działa jako pomost pomiędzy intuicyjnym F2L a podzbiorami takimi jak **WV**, **VLS** lub **CLS**";
"algs.info.advancedf2l.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.advancedf2l.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.advancedf2l.insights.p3" = "To sprawia, że zestaw jest szczególnie praktyczny: natychmiast wzmacnia normalne rozwiązania, jednocześnie przygotowując świadomość wzorców potrzebną w bardziej formalnych systemach z ostatnim slotem.";
"algs.info.advancedf2l.recognition.p1" = "Rozpoznawanie w trybie Advanced F2L oznacza wystarczająco szybkie odczytanie relacji narożnika, krawędzi i otwartej szczeliny, aby zdecydować, czy przypadek najlepiej rozwiązać intuicyjnie, czy przy użyciu znanej płytki o wysokiej wydajności.";
"algs.info.advancedf2l.recommended.p1" = "Zalecane dla kostek, które mają już stabilną intuicyjność F2L i chcą usunąć powtarzające się wąskie gardła przed przejściem na znacznie większe zaawansowane systemy.";
"algs.info.advancedf2l.quote.p1" = "„W wersji zaawansowanej F2L intuicja przestaje być niejasna i zaczyna nabierać struktury: nadal rozumiesz sytuację, ale wiesz też dokładnie, które niezręczne przypadki zasługują na lepszą odpowiedź”.";
