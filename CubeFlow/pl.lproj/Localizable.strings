"algs.info.l2c.recognition.p1" = "Rozpoznawanie opiera się na układzie pozostałych środkowych elementów na dwóch ostatnich środkowych ścianach oraz na tym, czy można je połączyć w parę, zamienić miejscami lub wstawić w czystej sekwencji plasterków.";
"algs.info.l2c.recommended.p1" = "Zalecane dla osób rozwiązujących 5x5, które już rozumieją budowanie centrów, ale chcą mniej przerw w końcowych centrach.";
"algs.info.l2c.quote.p1" = "Dobry L2C zamienia ostatnie centra z mieszaniny elementów w krótki, zaplanowany etap budowy.";
