"algs.info.sv.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania Summer Variation (SV).";
"algs.info.sv.history.p1" = "Summer Variation (SV) jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.sv.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.sv.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.sv.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.sv.size.b4" = "Często uczymy się indywidualnie, a nie w ramach formalnego, jednorazowego projektu";
"algs.info.sv.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.sv.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.sv.insights.p3" = "Ta elastyczność może być w rzeczywistości zaletą: jeśli kilka przypadków naturalnie pasuje do Twoich rozwiązań, SV może ulepszyć zakończenia bez konieczności angażowania się w bardzo dużą liczbę algorytmów.";
"algs.info.sv.recognition.p1" = "Rozpoznawanie SV zależy od tych samych ogólnych składników, co inne podzbiory ostatniego gniazda: ostatecznej struktury pary, dostępnego kierunku wstawiania i stanu ostatniej warstwy, który chcesz zachować lub ulepszyć.";
"algs.info.sv.recommended.p1" = "Zalecane dla zaawansowanych graczy, którzy już lubią myślenie w stylu WV, VLS lub ZBLS i chcą kilku bardziej wydajnych opcji końcowego slotu bez przeskakiwania od razu do kolejnej ogromnej rodziny.";
"algs.info.sv.quote.p1" = "„Letnia odmiana nie polega na zapamiętywaniu słynnego stałego zestawu, a bardziej na zbieraniu skrzynek z ostatniego miejsca, które są po prostu zbyt wydajne, aby je zignorować”.";
"algs.info.zbls.title" = "O ZBLS";
