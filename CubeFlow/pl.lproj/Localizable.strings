"algs.info.ollcp.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania OLLCP.";
"algs.info.ollcp.history.p1" = "OLLCP jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.ollcp.size.b1" = "Ta klasyfikacja zawiera **331 algorytmów**";
"algs.info.ollcp.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.ollcp.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.ollcp.size.b4" = "Zwykle uczy się selektywnie, a nie od razu w pełnym zestawie";
"algs.info.ollcp.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.ollcp.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.ollcp.insights.p3" = "OLLCP pomaga również połączyć różne części teorii ostatniej warstwy. Kiedy zaczniesz myśleć o orientacji i permutacji narożników, zestawy takie jak COLL, ZBLL i zaawansowane systemy ostatniego slotu staną się łatwiejsze do powiązania ze sobą.";
"algs.info.ollcp.recognition.p1" = "OLLCP rozpoznaje się poprzez identyfikację kształtu **OLL**, a następnie określenie towarzyszącej mu **permutacji narożnika**. W porównaniu ze zwykłym OLL dodatkowym obciążeniem związanym z rozpoznawaniem jest cena płacona za redukcję końcowego etapu permutacji do EPLL.";
"algs.info.ollcp.recommended.p1" = "Zalecane dla zaawansowanych solwerów, którzy znają już **pełne PLL** i znaczną ilość **OLL** i którzy chcą bardziej realistycznej odskoczni między standardowym rozwiązywaniem ostatniej warstwy a bardzo dużymi systemami z jednym spojrzeniem.";
"algs.info.ollcp.quote.p1" = "„OLLCP jest atrakcyjne, ponieważ zachowuje znaną strukturę OLL, ale zadaje lepsze pytanie: czy to samo rozpoznanie może również rozwiązać zakręty za darmo?”";
