"algs.info.ollparity.structure.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.ollparity.structure.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.ollparity.structure.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.ollparity.structure.b4" = "Szerokie skręty i kontrola plasterków mają większe znaczenie niż zapamiętywanie wielu przypadków";
"algs.info.ollparity.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.ollparity.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.ollparity.insights.p3" = "Po ustaleniu parzystości rozwiązanie powraca do zwykłej logiki ostatniej warstwy w stylu 3x3.";
"algs.info.ollparity.recognition.p1" = "Rozpoznanie jest proste: po redukcji ostatnia warstwa wygląda tak, jakby jedna para krawędzi została odwrócona lub w przeciwnym razie stan OLL byłby niemożliwy na 3x3.";
"algs.info.ollparity.recommended.p1" = "Zalecane, gdy tylko zaczniesz rozwiązywać 4x4 z redukcją lub Yau. Jest to wiedza obowiązkowa, a nie opcjonalny zestaw zaawansowany.";
"algs.info.ollparity.quote.p1" = "4x4 OLL Parzystość to moment, w którym zredukowana kostka przypomina, że tak naprawdę nigdy nie była to 3x3.";
