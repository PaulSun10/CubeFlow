"algs.info.f2l.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania F2L.";
"algs.info.f2l.history.p1" = "F2L jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.f2l.size.b1" = "Ta klasyfikacja zawiera ** algorytmów**";
"algs.info.f2l.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.f2l.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.f2l.size.b4" = "Zaawansowane gałęzie ostatniego slotu, takie jak **WV**, **VLS** i **ZBLS**, wszystkie wyrastają ze struktury F2L";
"algs.info.f2l.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.f2l.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.f2l.insights.p3" = "Gdy solwer oswoi się ze strukturą F2L, wiele zaawansowanych systemów zaczyna mieć sens: triki z ostatnim slotem, wstawiania uwzględniające orientację krawędzi i przejścia jednym spojrzeniem, wszystkie opierają się na tej samej podstawowej logice par.";
"algs.info.f2l.recognition.p1" = "Rozpoznawanie F2L oznacza śledzenie docelowego narożnika, odpowiadającej mu krawędzi i ich stosunku do otwartych szczelin. Wydajne solwery identyfikują zarówno stan pary, jak i najlepszą ścieżkę wstawiania przed zakończeniem poprzedniej pary.";
"algs.info.f2l.recommended.p1" = "Polecany dla każdego kostki wychodzącej poza początkujące metody warstwa po warstwie. Silne F2L jest podstawą nie tylko dla **CFOP**, ale także dla zrozumienia wielu zaawansowanych systemów podzbiorów zbudowanych na ostatnim slocie.";
"algs.info.f2l.quote.p1" = "\"Szybkie F2L rzadko polega na znajomości większości algorytmów. Chodzi o wczesne dostrzeganie par, wybieranie dobrych miejsc i utrzymywanie kostki w ruchu dzięki **wyprzedzeniu**.\"";
