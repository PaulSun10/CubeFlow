"algs.info.coll.section.quote" = "Notatka";
"algs.info.coll.overview.p1" = "Zestaw algorytmów do ćwiczenia rozpoznawania i wykonania COLL.";
"algs.info.coll.history.p1" = "COLL jest używane w speedcubingu jako praktyczna klasyfikacja. W CubeFlow układ opiera się na strukturze SpeedCubeDB, żeby łatwiej było się uczyć.";
"algs.info.coll.size.b1" = "Ta klasyfikacja zawiera **42 algorytmów**";
"algs.info.coll.size.b2" = "Zacznij od przypadków częstych albo łatwych do rozpoznania.";
"algs.info.coll.size.b3" = "Grupowanie przypadków według rodzin wizualnych stabilizuje rozpoznawanie lepiej niż płaska lista.";
"algs.info.coll.size.b4" = "Najbardziej przydatne, gdy krawędzie ostatniej warstwy są już zorientowane";
"algs.info.coll.insights.p1" = "Ucz się tego zestawu małymi blokami i wracaj do błędów, aż wykonanie stanie się automatyczne.";
"algs.info.coll.insights.p2" = "Porównuj podobne przypadki obok siebie, żeby nie mylić bliskich wzorów podczas solve’a.";
"algs.info.coll.insights.p3" = "Wiele osób rozwiązujących uczy się COLL, grupując przypadki ze znanymi wzorami narożników w stylu OCLL. Gdy te rodziny będą stabilne, dodanie dodatkowych szczegółów permutacji narożników stanie się znacznie łatwiejsze.";
"algs.info.coll.recognition.p1" = "COLL jest rozpoznawane poprzez połączenie widocznego wzoru orientacji narożnika z permutacją narożnika. W praktyce wiele rozwiązań najpierw identyfikuje kształt w stylu OCLL, a następnie potwierdza, który to przypadek permutacji.";
"algs.info.coll.recommended.p1" = "Zalecane dla sześcianów, którzy już znają **pełne PLL**, czują się komfortowo z **OLL** i chcą łatwej w zarządzaniu ścieżki w kierunku bardziej wydajnego rozwiązywania ostatniej warstwy za pomocą jednego spojrzenia. Jest szczególnie atrakcyjny dla **ZZ** i zaawansowanych **CFOP** użytkowników.";
"algs.info.coll.quote.p1" = "„COLL często wydaje się być punktem, w którym zaawansowana teoria ostatniej warstwy staje się praktyczna: wystarczająco mała, aby się uczyć, ale wystarczająco silna, aby zauważalnie zmieniać zakończenia rozwiązywania”.";
