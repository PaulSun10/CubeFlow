"algs.info.zbll.overview.p1" = "Conjunto de algoritmos para practicar reconocimiento y ejecución de ZBLL.";
"algs.info.zbll.history.p1" = "ZBLL se usa como una clasificación práctica dentro del speedcubing. En esta app se organiza según la estructura de SpeedCubeDB para que sea más fácil estudiarlo.";
"algs.info.zbll.size.b1" = "Esta clasificación tiene **472 algoritmos**";
"algs.info.zbll.size.b2" = "Conviene empezar por los casos frecuentes o fáciles de reconocer.";
"algs.info.zbll.size.b3" = "Separar los casos por familias visuales hace el reconocimiento más estable que memorizarlos como una lista plana.";
"algs.info.zbll.size.b4" = "En solves reales importan también los agarres, el ángulo y la transición, no solo la longitud del algoritmo.";
"algs.info.zbll.insights.p1" = "ZBLL no consiste solo en aprender más casos: sirve para hacer el flujo del solve más corto y estable.";
"algs.info.zbll.insights.p2" = "Es más práctico aprenderlo por partes, empezando por formas frecuentes o casos que ya te frenan.";
