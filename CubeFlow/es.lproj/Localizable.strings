"algs.info.ortegaoll.title" = "Acerca de Ortega OLL";
"algs.info.ortegaoll.subtitle" = "Resumen, reconocimiento y práctica de Ortega OLL";
"algs.info.ortegaoll.overview.p1" = "Conjunto de algoritmos para practicar reconocimiento y ejecución de Ortega OLL.";
"algs.info.ortegaoll.context.p1" = "Ortega OLL se usa como una clasificación práctica dentro del speedcubing. En esta app se organiza según la estructura de SpeedCubeDB para que sea más fácil estudiarlo.";
"algs.info.ortegaoll.structure.b1" = "Esta clasificación tiene **7 casos**";
"algs.info.ortegaoll.structure.b2" = "Conviene empezar por los casos frecuentes o fáciles de reconocer.";
"algs.info.ortegaoll.structure.b3" = "Separar los casos por familias visuales hace el reconocimiento más estable que memorizarlos como una lista plana.";
"algs.info.ortegaoll.structure.b4" = "En solves reales importan también los agarres, el ángulo y la transición, no solo la longitud del algoritmo.";
"algs.info.ortegaoll.insights.p1" = "Ortega OLL no consiste solo en aprender más casos: sirve para hacer el flujo del solve más corto y estable.";
"algs.info.ortegaoll.insights.p2" = "Es más práctico aprenderlo por partes, empezando por formas frecuentes o casos que ya te frenan.";
"algs.info.ortegaoll.insights.p3" = "Después de añadir un algoritmo, comprueba si lo reconoces dentro de solves normales, no solo en práctica aislada.";
"algs.info.ortegaoll.recognition.p1" = "Para reconocer Ortega OLL, identifica primero la familia visual principal y luego confirma el caso exacto con orientación, permutación o bloques.";
"algs.info.ortegaoll.recommended.p1" = "Ortega OLL se recomienda cuando los pasos cercanos ya son estables. Cuanto más sólida sea la base, más valor tendrá este set en solves reales.";
"algs.info.ortegaoll.quote.p1" = "“Ortega OLL no se aprende de golpe: se construye caso por caso, empezando por lo que más valor aporta en solves reales.”";
