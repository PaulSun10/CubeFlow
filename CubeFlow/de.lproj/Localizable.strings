"algs.info.ortegaoll.title" = "Über Ortega OLL";
"algs.info.ortegaoll.subtitle" = "Überblick, Erkennung und Training für Ortega OLL";
"algs.info.ortegaoll.overview.p1" = "Algorithmus-Set zum Üben von Erkennung und Ausführung von Ortega OLL.";
"algs.info.ortegaoll.context.p1" = "Ortega OLL wird im Speedcubing als praktische Klassifikation verwendet. In CubeFlow ist es nach der SpeedCubeDB-Struktur organisiert, damit es leichter zu lernen ist.";
"algs.info.ortegaoll.structure.b1" = "Diese Klassifikation enthält **7 Fälle**";
"algs.info.ortegaoll.structure.b2" = "Beginne mit häufigen oder leicht erkennbaren Fällen.";
"algs.info.ortegaoll.structure.b3" = "Fälle nach visuellen Familien zu gruppieren stabilisiert die Erkennung besser als eine flache Liste.";
"algs.info.ortegaoll.structure.b4" = "In echten Solves zählen Griff, Winkel und Übergänge genauso wie die Algorithmuslänge.";
"algs.info.ortegaoll.insights.p1" = "Übe dieses Set in kleinen Blöcken und wiederhole Fehler, bis die Ausführung automatisch wird.";
"algs.info.ortegaoll.insights.p2" = "Vergleiche ähnliche Fälle nebeneinander, damit du nahe Muster im Solve nicht verwechselst.";
"algs.info.ortegaoll.insights.p3" = "Nutze den Trainer, um langsame Erkennung in eine natürlichere Reaktion zu verwandeln.";
"algs.info.ortegaoll.recognition.p1" = "Erkenne zuerst das wichtigste visuelle Muster, bestätige die kritischen Steine und wähle einen Winkel mit guter Ausführung.";
"algs.info.ortegaoll.recommended.p1" = "Empfohlen für Cuber, die den vorherigen Schritt bereits verstehen und sauberer oder schneller lösen möchten.";
"algs.info.ortegaoll.quote.p1" = "Ortega OLL lernt sich leichter, wenn du es als Musterfamilien siehst und nicht als zufällige Liste.";
