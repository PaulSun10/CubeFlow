"algs.info.zbll.title" = "حوالي ZBLL";
"algs.info.zbll.subtitle" = "التعريف والتاريخ وكفاءة ZBLL";
"algs.info.zbll.section.overview" = "نظرة عامة";
"algs.info.zbll.section.history" = "التاريخ";
"algs.info.zbll.section.size" = "الحجم والكفاءة";
"algs.info.zbll.section.insights" = "رؤى";
