"algs.info.vls.section.insights" = "رؤى";
"algs.info.vls.section.recognition" = "الاعتراف";
"algs.info.vls.section.recommended" = "الموصى بها ل";
"algs.info.vls.section.quote" = "اقتباس";
"algs.info.vls.overview.p1" = "**VLS**، اختصار لـ **Valk Last Slot**، يحل زوج F2L النهائي بطريقة توجه الطبقة الأخيرة أيضًا. عندما يعمل، فإنه يتخطى عادي OLL ويتدفق مباشرة إلى PLL أو أي طبقة نهائية مخفضة أخرى.";
"algs.info.vls.history.p1" = "المدخل الأكثر شهرة إلى VLS هو **Winter Variation**، الذي نشره **Lucas Winter** في عام 2005. وقد أدى العمل اللاحق الذي قام به محللون مثل **Mats Valk** و **Rowe Hessler** وآخرون إلى توسيع هذه الفكرة لتشمل عائلة VLS الأوسع المستخدمة اليوم.";
"algs.info.vls.size.b1" = "غالبًا ما يتم حسابها على أنها **432 خوارزمية** ذات مرايا، أو **216 حالة أساسية** بدون مرايا";
"algs.info.vls.size.b2" = "مبني على موقف الفتحة الأخيرة حيث تم تشكيل الزوج المستهدف بالفعل";
"algs.info.vls.size.b3" = "مصممة لحل الفتحة الأخيرة مع توجيه الطبقة النهائية أيضًا";
"algs.info.vls.size.b4" = "يتم تعلمها بشكل شائع بدءًا من **التباين الشتوي**، ثم توسيع المجموعة الفرعية بمجموعة فرعية";
"algs.info.vls.insights.p1" = "VLS هو أحد أوضح الأمثلة على مجموعة فرعية متقدمة عالية القيمة: فهو يهاجم الفتحة الأخيرة، والتي تعد بالفعل نقطة تحول رئيسية في الحل، ويحولها إلى جسر نحو طبقة أخيرة أقصر.";
"algs.info.vls.insights.p2" = "معظم أدوات الحل لا تقترب من VLS كمجموعة عملاقة واحدة. إنهم يبدأون بالمجموعات الفرعية الأسهل أو الأكثر شيوعًا، غالبًا من خلال Winter Variation، ولا يقررون إلا لاحقًا ما إذا كانت العائلة الأكبر تستحق دراسة أعمق.";
"algs.info.vls.insights.p3" = "نظرًا لأن VLS يعيش داخل عملية اتخاذ القرار في اللحظة الأخيرة، فإن قوتها العملية تعتمد بشكل كبير على سرعة التعرف. تكون الحالة القوية من الناحية النظرية مفيدة فقط إذا تمكن الحل من اكتشافها دون تدمير التدفق F2L.";
"algs.info.vls.recognition.p1" = "يتم التعرف على VLS من خلال النظر إلى قطع الفتحة الأخيرة المقترنة مع حالة الاتجاه لحواف وزوايا الطبقة الأخيرة المتبقية. يعتمد التعرف الفعال على رؤية كل من نمط الفتحة واتجاه الطبقة الأخيرة في وقت واحد.";
"algs.info.vls.recommended.p1" = "يوصى به لمحللي **CFOP** المتقدمين الذين لديهم بالفعل F2L مستقر ويريدون تقليل خطوات الطبقة الأخيرة من الفتحة الأخيرة. إنها جذابة بشكل خاص للمكعبات الذين يستمتعون بالمجموعات الفرعية ذات الفتحة الأخيرة مثل **WV** و**ZBLS** والأنظمة ذات الصلة.";
"algs.info.vls.quote.p1" = "\"VLS قوي لأنه لا يطلب معجزة منفصلة للطبقة الأخيرة. إنه يسأل عما إذا كان الزوج النهائي نفسه يمكنه إعداد لمسة نهائية أسرع بهدوء.\"";
"algs.info.wv.title" = "حوالي WV";
"algs.info.wv.subtitle" = "التعريف والتاريخ وكفاءة WV";
"algs.info.wv.section.overview" = "نظرة عامة";
"algs.info.wv.section.history" = "التاريخ";
"algs.info.wv.section.size" = "الحجم والكفاءة";
"algs.info.wv.section.insights" = "رؤى";
"algs.info.wv.section.recognition" = "الاعتراف";
"algs.info.wv.section.recommended" = "الموصى بها ل";
"algs.info.wv.section.quote" = "اقتباس";
"algs.info.wv.overview.p1" = "**WV**، اختصار لـ **Winter Variation**، يحل زوج F2L النهائي مع توجيه الطبقة الأخيرة أيضًا في الحالات التي تكون فيها حواف الطبقة الأخيرة موجهة بالفعل. ومن الناحية العملية، فهي واحدة من أكثر البوابات سهولة في الوصول إلى نظرية الفتحة الأخيرة المتقدمة.";
"algs.info.wv.history.p1" = "تم نشر Winter Variation بواسطة **Lucas Winter** في عام 2005 وسرعان ما أصبحت واحدة من أشهر المجموعات الفرعية المتقدمة ذات الفتحة الأخيرة. يتم التعامل معها الآن على نطاق واسع كخطوة أولى من F2L العادي إلى أنظمة أكبر مثل **VLS** و **ZBLS**.";
"algs.info.wv.size.b1" = "يُحسب عادةً على أنه **27 خوارزمية**";
"algs.info.wv.size.b2" = "ينطبق عندما يكون الزوج الأخير متاحًا و**حواف الطبقة الأخيرة موجهة بالفعل**";
"algs.info.wv.size.b3" = "يتخطى عادي OLL عن طريق إنهاء الفتحة وتوجيه الطبقة الأخيرة معًا";
"algs.info.wv.size.b4" = "غالبًا ما يتم تعلمها قبل عائلات الفتحة الأخيرة الأكبر حجمًا لأن المجموعة مدمجة وعملية";
"algs.info.wv.insights.p1" = "WV جذاب لأنه يوفر مكاسب واضحة في الكفاءة دون الحاجة إلى التزام كبير بالخوارزمية. بالنسبة للعديد من أدوات حل CFOP، فهي أول مجموعة فرعية متقدمة تبدو قابلة للتعلم ومفيدة على الفور.";
"algs.info.wv.insights.p2" = "تعلم المجموعة أيضًا تحولًا مفاهيميًا مهمًا: فالفتحة الأخيرة ليست مجرد شيء يتم الانتهاء منه بشكل نظيف، ولكنها أيضًا فرصة لتشكيل الطبقة الأخيرة قبل أن تبدأ.";
"algs.info.wv.insights.p3" = "نظرًا لحجمها ومردودها العملي، غالبًا ما تعمل WV كبوابة. يستمر المحللون الذين يستمتعون بها بشكل متكرر في استكشاف **VLS** أو **ZBLS** أو أنظمة الفتحة الأخيرة الأخرى التي تراعي التوجه الحافة.";
"algs.info.wv.recognition.p1" = "يتم التعرف على WV من خلال النظر إلى الزوج النهائي والتأكد من أن حواف الطبقة الأخيرة موجهة بالفعل. من هناك، يحدد هيكل الزوج واتجاه الإدخال الحالة الدقيقة.";
"algs.info.wv.recommended.p1" = "موصى به للمكعبات ذات F2L المستقرة والذين يريدون أول مجموعة فرعية جادة في الفتحة الأخيرة. إنه جيد بشكل خاص لمحللي CFOP الذين لاحظوا بالفعل اتجاه الحافة أثناء الحلول ويريدون انتقالات أكثر كفاءة إلى الطبقة الأخيرة.";
"algs.info.wv.quote.p1" = "\"غالبًا ما يكون تباين الشتاء هو اللحظة الأولى التي يدرك فيها القائم بالحل أن الفتحة الأخيرة يمكن أن تفعل أكثر من إنهاء F2L - ويمكنها أيضًا تبسيط الطبقة الأخيرة بأكملها بهدوء.\"";
"algs.info.sv.title" = "حول SV";
"algs.info.sv.subtitle" = "تعريف وتاريخ وكفاءة SV";
"algs.info.sv.section.overview" = "نظرة عامة";
"algs.info.sv.section.history" = "التاريخ";
"algs.info.sv.section.size" = "الحجم والكفاءة";
"algs.info.sv.section.insights" = "رؤى";
"algs.info.sv.section.recognition" = "الاعتراف";
"algs.info.sv.section.recommended" = "الموصى بها ل";
"algs.info.sv.section.quote" = "اقتباس";
"algs.info.sv.overview.p1" = "**SV**، والتي يطلق عليها عادةً **Summer Variation**، هي عائلة أصغر حجمًا ومتقدمة في الفتحة الأخيرة تتعلق بأفكار النمط WV. وهو يركز على حالات الفتحة النهائية المحددة حيث يوفر الإدخال المتخصص انتقالًا أنظف وأكثر كفاءة إلى الطبقة الأخيرة.";
"algs.info.sv.history.p1" = "على عكس WV، يُعرف SV بأنه حدث تاريخي واحد أقل شهرة باعتباره علامة مجتمعية لفرع مركّز من تقنيات الفتحة الأخيرة المتقدمة. لقد تطورت بشكل طبيعي حيث استمر المكعبون في توسيع المنطق الكامن وراء إدخالات الفتحة النهائية الفعالة.";
"algs.info.sv.size.b1" = "يتم التعامل معها عادةً على أنها **مجموعة فرعية مركزة**، وليس نظامًا مستقلاً عملاقًا";
"algs.info.sv.size.b2" = "أصغر وأكثر انتقائية من العائلات الكبيرة مثل **VLS**";
"algs.info.sv.size.b3" = "يكون أكثر فائدة عندما يتعرف المحلل بالفعل على بنية الفتحة النهائية بشكل مريح";
"algs.info.sv.size.b4" = "غالبًا ما يتم تعلم كل حالة على حدة وليس كمشروع رسمي شامل";
"algs.info.sv.insights.p1" = "من الأفضل فهم SV على أنه امتداد عملي للتفكير المتقدم في النقطة الأخيرة وليس مجموعة معالم عالمية. وتأتي قيمته من اختيار الحالات التي يكون فيها المردود واضحًا ويظل عبء الاعتراف تحت السيطرة.";
"algs.info.sv.insights.p2" = "نظرًا لاستخدام التسمية بشكل فضفاض قليلاً من مجموعات مثل PLL أو OLL، فغالبًا ما يواجه القائمون على الحل SV من خلال مجموعات الحالات المنسقة بدلاً من مسار تعليمي أساسي واحد.";
"algs.info.sv.insights.p3" = "يمكن أن تكون هذه المرونة في الواقع نقطة قوة: إذا كانت بعض الحالات تتلاءم بشكل طبيعي مع حلولك، فيمكن لـ SV تحسين النهايات دون مطالبتك بالالتزام بمجموعة كبيرة جدًا من الخوارزميات.";
"algs.info.sv.recognition.p1" = "يعتمد التعرف على SV على نفس المكونات العامة مثل المجموعات الفرعية الأخرى للفتحة الأخيرة: بنية الزوج النهائي، واتجاه الإدراج المتاح، وحالة الطبقة الأخيرة التي تريد الحفاظ عليها أو تحسينها.";
"algs.info.sv.recommended.p1" = "يوصى به لمحللي الحلول المتقدمين الذين يستمتعون بالفعل بالتفكير بأسلوب WV أو VLS أو ZBLS ويريدون عددًا قليلًا من خيارات الفتحة النهائية الأكثر كفاءة دون القفز مباشرة إلى عائلة ضخمة أخرى.";
"algs.info.sv.quote.p1" = "\"إن Summer Variation لا يتعلق بحفظ مجموعة ثابتة مشهورة بقدر ما يتعلق بجمع الحالات النهائية التي لا يمكن تجاهلها ببساطة.\"";
"algs.info.zbls.title" = "حول ZBLS";
"algs.info.zbls.subtitle" = "التعريف والتاريخ وكفاءة ZBLS";
"algs.info.zbls.section.overview" = "نظرة عامة";
"algs.info.zbls.section.history" = "التاريخ";
"algs.info.zbls.section.size" = "الحجم والكفاءة";
"algs.info.zbls.section.insights" = "رؤى";
"algs.info.zbls.section.recognition" = "الاعتراف";
"algs.info.zbls.section.recommended" = "الموصى بها ل";
"algs.info.zbls.section.quote" = "اقتباس";
"algs.info.zbls.overview.p1" = "**ZBLS**، اختصار لـ **ZB Last Slot**، يحل زوج F2L الأخير مع توجيه حواف الطبقة الأخيرة أيضًا. إنه أحد الجسور الرئيسية بين CFOP F2L العادي وعائلة **ZB** الأوسع لأنظمة كفاءة الطبقة الأخيرة.";
"algs.info.zbls.history.p1" = "نشأت ZBLS من **طريقة ZB** الأكبر التي طورها **Zbigniew Zborowski** و**Ron van Bruchem**. مع تطور الطريقة، نظمت مكعبات السرعة الجزء الأخير في عائلتها القابلة للتعلم، نظرًا لأنها قدمت كفاءة عملية حتى بدون تعلم كل ZBLL.";
"algs.info.zbls.size.b1" = "**عائلة كبيرة ذات فتحة أخيرة**، أكبر بكثير من المجموعات المدمجة مثل WV";
"algs.info.zbls.size.b2" = "تم تصميمه حول حل الفتحة الأخيرة مع ترك **EO كاملة** للطبقة الأخيرة";
"algs.info.zbls.size.b3" = "يعمل كأساس للنهايات التي تستمر حتى **ZBLL** أو غيرها من التشطيبات ذات المظهر الواحد";
"algs.info.zbls.size.b4" = "يتم تعلمه عادةً بشكل انتقائي نظرًا لأن العائلة بأكملها كبيرة جدًا بحيث لا يستطيع معظم المكعبات التعامل معها مرة واحدة";
"algs.info.zbls.insights.p1" = "ZBLS مهم لأنه يغير دور الفتحة الأخيرة. بدلاً من مجرد إنهاء F2L، يصبح الإدراج النهائي فرصة لإعداد حالة طبقة أخيرة أقوى بكثير حتى قبل بدء التعرف.";
"algs.info.zbls.insights.p2" = "من الناحية العملية، لا يتعامل العديد من المحللين مع ZBLS كمشروع ضخم واحد. إنهم يتعلمون أولاً الحالات الأكثر راحة أو تكرارًا، خاصة تلك التي تتصل بشكل طبيعي مع التعرف على النمط WV أو VLS.";
"algs.info.zbls.insights.p3" = "بالنسبة للمكعبات ذات التفكير النظري، تعد ZBLS أيضًا واحدة من أوضح النوافذ حول كيفية توصيل الأساليب المتقدمة: يجتمع هيكل F2L، واتجاه الحافة، وتخطيط الطبقة الأخيرة في مكان واحد.";
"algs.info.zbls.recognition.p1" = "يتم التعرف على ZBLS من خلال قراءة الزوج النهائي مع نتيجة اتجاه الحافة المطلوبة. تعتمد الحالة الدقيقة على كيفية ترتيب الزوج وما هو الإدخال الذي يحافظ على حالة الحافة التي تريدها أو ينشئها.";
"algs.info.zbls.recommended.p1" = "موصى به لحلول CFOP المتقدمة ذات F2L القوية والاهتمام الجاد بأنظمة الفتحة الأخيرة. إنها ذات صلة بشكل خاص بمستخدمي مكعبات الثلج الذين يستمتعون بالفعل بـ WV أو يريدون فهم الجانب العملي لطريقة ZB الأوسع.";
"algs.info.zbls.quote.p1" = "\"ZBLS هو المكان الذي تتوقف فيه الفتحة الأخيرة عن كونها مهمة تنظيف وتبدأ في أن تصبح إعدادًا استراتيجيًا كاملاً للطبقة الأخيرة.\"";
"algs.info.1lll.title" = "حوالي 1LLL";
"algs.info.1lll.subtitle" = "التعريف والتاريخ وكفاءة 1LLL";
"algs.info.1lll.section.overview" = "نظرة عامة";
"algs.info.1lll.section.history" = "التاريخ";
"algs.info.1lll.section.size" = "الحجم والكفاءة";
"algs.info.1lll.section.insights" = "رؤى";
"algs.info.1lll.section.recognition" = "الاعتراف";
"algs.info.1lll.section.recommended" = "الموصى بها ل";
"algs.info.1lll.section.quote" = "اقتباس";
"algs.info.1lll.overview.p1" = "**1LLL**، اختصار لـ **One-Look Last Layer**، ليست مجموعة ثابتة واحدة ولكنها فكرة شاملة: حل الطبقة الأخيرة بأكملها في خوارزمية واحدة من العديد من الحالات المعدة المختلفة. تعد العائلات مثل **ZBLL** من أشهر الأمثلة المنظمة.";
"algs.info.1lll.history.p1" = "أصبحت عبارة 1LLL اختصارًا مناسبًا للمجتمع حيث نظمت أجهزة Speedcubers أنظمة الطبقة الأخيرة ذات الكفاءة المتزايدة. وبدلاً من تسمية طريقة تاريخية واحدة، فهو يصف الهدف الأوسع المتمثل في طي الطبقة الأخيرة في لمسة نهائية واحدة معترف بها.";
"algs.info.1lll.size.b1" = "لا يوجد **لا يوجد عدد خوارزمية ثابت واحد**، لأن 1LLL عبارة عن مظلة تشمل عائلات متعددة";
"algs.info.1lll.size.b2" = "تتضمن المجموعات الفرعية المعروفة ضمن فكرة 1LLL **ZBLL** وأنظمة أخرى ذات مظهر واحد مكيفة الحافة";
"algs.info.1lll.size.b3" = "المساحة الإجمالية كبيرة للغاية، لذا فإن معظم المكعبات يتعلمون عائلات مختارة فقط";
"algs.info.1lll.size.b4" = "سقف كفاءتها مرتفع للغاية، لكن عبء التعلم هو أيضًا من بين الأثقل في مجال تكعيب السرعة";
"algs.info.1lll.insights.p1" = "من الأفضل التعامل مع 1LLL كمفهوم، وليس كمجموعة معالم عادية. إنها تمثل فكرة الطبقة الأخيرة المضغوطة بالكامل، ولكنها في الواقع تنقسم إلى العديد من الأنظمة الأصغر، ولكل منها تمييزها ومتطلباتها الأساسية.";
"algs.info.1lll.insights.p2" = "ولهذا السبب لا أحد تقريبًا يتعلم \"كامل 1LLL\" بالمعنى الحرفي للكلمة. وبدلاً من ذلك، يختار القائمون على الحل مجموعات فرعية منظمة تناسب طريقتهم وعادات التعرف عليهم ورغبتهم في الحفظ.";
"algs.info.1lll.insights.p3" = "ومع ذلك، فإن التفكير بمصطلحات 1LLL يمكن أن يكون مفيدًا. إنه يساعد في تفسير سبب شعور مجموعات مثل COLL وOLLCP وZBLL بالارتباط: فهي جميعها تتحرك نحو نفس الهدف المتمثل في تقليص الطبقة الأخيرة إلى قرارات ذات معنى أقل وأقل.";
"algs.info.1lll.recognition.p1" = "يعتمد التعرف على 1LLL كليًا على المجموعة الفرعية المستخدمة. تبدأ بعض العائلات من الحواف الموجهة، وبعضها من شروط الفتحة الأخيرة، وبعضها من أنماط نمط OLL الأوسع بالإضافة إلى تفاصيل التقليب الإضافية.";
"algs.info.1lll.recommended.p1" = "موصى به لمحللي الحلول المتقدمة ذوي التفكير النظري والذين يفهمون بالفعل عائلات الطبقة الأخيرة الرئيسية ويريدون معرفة كيف تتلاءم هذه الأنظمة مع إطار عمل أكبر ذو مظهر واحد، بدلاً من أي شخص يبحث عن مجموعة تالية عملية صغيرة.";
"algs.info.1lll.quote.p1" = "\"1LLL ليس مجموعة تنتهي من تعلمها بقدر ما هو أفق يشرح سبب استمرار العديد من أنظمة الطبقة الأخيرة المتقدمة في الدفع نحو نفس الفكرة: حل كل شيء مرة واحدة.\"";
"algs.info.advancedf2l.title" = "حول المتقدم F2L";
"algs.info.advancedf2l.subtitle" = "التعريف والتاريخ وكفاءة F2L المتقدمة";
"algs.info.advancedf2l.section.overview" = "نظرة عامة";
"algs.info.advancedf2l.section.history" = "التاريخ";
"algs.info.advancedf2l.section.size" = "الحجم والكفاءة";
"algs.info.advancedf2l.section.insights" = "رؤى";
"algs.info.advancedf2l.section.recognition" = "الاعتراف";
"algs.info.advancedf2l.section.recommended" = "الموصى بها ل";
"algs.info.advancedf2l.section.quote" = "اقتباس";
"algs.info.advancedf2l.overview.p1" = "** يشير F2L** المتقدم إلى الجانب الأكثر تنظيمًا لـ F2L بما يتجاوز الاقتران البديهي الأساسي. وهو يركز عادةً على الحالات الزوجية غير الملائمة، والإدراجات ذات الكفاءة الأعلى، وحالات الفتحة الأخيرة حيث يمكن لخوارزمية أكثر رسمية الحفاظ على التدفق أو تقليل عدد التحركات.";
"algs.info.advancedf2l.history.p1" = "مع نضوج CFOP، قام المكعبون تدريجيًا بفهرسة حالات F2L المحرجة التي كانت تستحق الحل باستخدام خوارزميات ثابتة بدلاً من الحدس المحض. بمرور الوقت، أصبحت هذه المجموعات بمثابة حل وسط عملي بين أنظمة F2L البديهية وأنظمة الفتحة الأخيرة الكبيرة.";
"algs.info.advancedf2l.size.b1" = "غالبًا ما يتم تنظيمها على هيئة **مجموعة حالات**، وليس مجموعة عالمية جامدة";
"algs.info.advancedf2l.size.b2" = "يركز عادةً على الإدخالات غير الملائمة، والحالات الزوجية الخاصة، ومواقف الفتحة الأخيرة الفعالة";
"algs.info.advancedf2l.size.b3" = "الهدف ليس مجرد عدد أقل من الحركات، ولكن أيضًا **نظرة أمامية** أفضل واستدارة أكثر وضوحًا";
"algs.info.advancedf2l.size.b4" = "يعمل كجسر بين F2L البديهية والمجموعات الفرعية مثل **WV** أو **VLS** أو **CLS**";
"algs.info.advancedf2l.insights.p1" = "F2L المتقدم مهم لأنه ليس كل زوج يستحق حله بسرعة. بعض الحالات تكون محرجة بدرجة كافية بحيث توفر الخوارزمية المستقرة كلاً من التحركات ووقت التفكير.";
"algs.info.advancedf2l.insights.p2" = "على عكس مجموعات الطبقة الأخيرة الكاملة، عادةً ما يتم تعلم F2L المتقدم بشكل انتهازي. يضيف القائمون على الحل الحالات واحدة تلو الأخرى عندما يلاحظون الأنماط التي تقاطع تدفقهم بشكل متكرر.";
"algs.info.advancedf2l.insights.p3" = "وهذا يجعل المجموعة عملية بشكل خاص: فهي تعزز الحلول العادية على الفور بينما تقوم أيضًا بإعداد الوعي بالنمط اللازم لأنظمة الفتحة الأخيرة الأكثر رسمية.";
"algs.info.advancedf2l.recognition.p1" = "التعرف في المتقدمة F2L يعني قراءة علاقة الزاوية والحافة والفتحة المفتوحة بسرعة كافية لتحديد ما إذا كان من الأفضل حل الحالة بشكل حدسي أو باستخدام إدراج معروف عالي الكفاءة.";
"algs.info.advancedf2l.recommended.p1" = "يوصى به للمكعبين الذين لديهم بالفعل حدس ثابت F2L ويريدون إزالة الاختناقات المتكررة قبل الالتزام بأنظمة متقدمة أكبر بكثير.";
"algs.info.advancedf2l.quote.p1" = "\"المستوى المتقدم F2L هو المكان الذي يتوقف فيه الحدس عن أن يكون غامضًا ويبدأ في أن يصبح منظمًا: لا تزال تفهم الفتحة، ولكنك تعرف أيضًا بالضبط الحالات المحرجة التي تستحق إجابة أفضل.\"";
"algs.info.cls.title" = "حوالي CLS";
"algs.info.cls.subtitle" = "التعريف والتاريخ وكفاءة CLS";
"algs.info.cls.section.overview" = "نظرة عامة";
"algs.info.cls.section.history" = "التاريخ";
"algs.info.cls.section.size" = "الحجم والكفاءة";
"algs.info.cls.section.insights" = "رؤى";
"algs.info.cls.section.recognition" = "الاعتراف";
"algs.info.cls.section.recommended" = "الموصى بها ل";
"algs.info.cls.section.quote" = "اقتباس";
"algs.info.cls.overview.p1" = "**CLS**، اختصار لـ **زوايا الفتحة الأخيرة**، يحل زوج F2L النهائي بينما يقوم أيضًا بحل زوايا الطبقة الأخيرة. إنها عائلة ذات فتحة أخيرة أكثر طموحًا من WV، لأن المردود ليس فقط التحكم في الاتجاه ولكن تقليل الطبقة الأخيرة المتبقية بشكل أقوى بكثير.";
"algs.info.cls.history.p1" = "CLS خرج من الجهد الأوسع لدفع المزيد من العمل إلى الفتحة النهائية. عندما اكتشف المكعبون كيف يمكن لإدخالات الفتحة الأخيرة أن تؤثر على الزوايا وكذلك الاتجاه، أصبح CLS أحد الفروع المميزة في شجرة العائلة المتقدمة تلك.";
"algs.info.cls.size.b1" = "**عائلة كبيرة للفتحة الأخيرة**، أكبر من مجموعات البوابات المدمجة مثل WV";
"algs.info.cls.size.b2" = "تم تصميمه حول حل الزوج النهائي مع حل بنية زاوية الطبقة الأخيرة أيضًا";
"algs.info.cls.size.b3" = "يمكن أن يؤدي مباشرة إلى تقليل تشطيبات الطبقة الأخيرة مع عمل أقل بكثير";
"algs.info.cls.size.b4" = "عادةً ما يتم تعلمه بشكل انتقائي وليس كمشروع واحد شامل";
"algs.info.cls.insights.p1" = "CLS جذاب لأنه يدفع الفتحة الأخيرة إلى ما هو أبعد من الإعداد وإلى حل الطبقة الأخيرة الحقيقية. وهذا يجعلها قوية من الناحية النظرية، حتى لو كان عبء التعلم الكامل كبيرًا جدًا بالنسبة لمعظم من يقومون بالحل.";
"algs.info.cls.insights.p2" = "من الناحية العملية، يتعامل العديد من المحللين مع CLS كعائلة من الحالات ذات القيمة العالية بدلاً من هدف الحفظ الكامل. أفضل الحالات هي تلك التي تظل التعرف عليها وبيئة العمل قابلة للإدارة في الحلول الحقيقية.";
"algs.info.cls.insights.p3" = "تساعد دراسة CLS أيضًا في بناء رؤية أكثر ترابطًا لنظرية التكعيب: تصبح بنية الفتحة والتحكم في الزاوية وضغط الطبقة الأخيرة جزءًا من قرار واحد مستمر.";
"algs.info.cls.recognition.p1" = "CLS يعتمد التعرف على قراءة الزوج النهائي مع حالة الزاوية التي تريد الحفاظ عليها أو حلها. بالمقارنة مع مجموعات النمط WV، يكون عبء التعرف أعلى لأن المزيد من معلومات الزاوية مهمة.";
"algs.info.cls.recommended.p1" = "يوصى به لمحللي CFOP المتقدمين الذين يستمتعون بالفعل بأنظمة الفتحة الأخيرة ويريدون استكشاف الحالات التي تقوم بعمل أكبر بكثير من الإدخالات العادية أو المجموعات الفرعية البسيطة OLL.";
"algs.info.cls.quote.p1" = "\"CLS هو تذكير بأن الفتحة الأخيرة ليست مجرد نهاية F2L؛ في الحالة الصحيحة، إنها بالفعل بداية النهاية.\"";
"algs.info.sbls.title" = "حول إس بي إل إس";
"algs.info.sbls.subtitle" = "تعريف وتاريخ وكفاءة SBLS";
"algs.info.sbls.section.overview" = "نظرة عامة";
"algs.info.sbls.section.history" = "التاريخ";
"algs.info.sbls.section.size" = "الحجم والكفاءة";
"algs.info.sbls.section.insights" = "رؤى";
"algs.info.sbls.section.recognition" = "الاعتراف";
"algs.info.sbls.section.recommended" = "الموصى بها ل";
"algs.info.sbls.section.quote" = "اقتباس";
"algs.info.sbls.overview.p1" = "**SBLS**، التي يتم توسيعها عادةً باسم **Second Block Last Slot**، هي عائلة موجهة نحو Roux تتعامل مع علاقة القطعة النهائية للكتلة الثانية بطريقة أكثر خوارزمية. إنه ينتمي إلى نفس الفكرة العامة مثل عمل الفتحة الأخيرة المتقدم في CFOP: استخدم الإدراج النهائي لتحسين ما يأتي بعد ذلك.";
"algs.info.sbls.history.p1" = "نظرًا لأن مستخدمي Roux قاموا بتحسين كفاءة الكتلة الثانية، فقد أثبتت بعض أنماط الفتحة النهائية المتكررة أنها تستحق الفهرسة. نشأ SBLS من هذا الضغط العملي لجعل نهاية الكتلة الثانية أكثر نظافة وأكثر اتساقًا قبل CMLL وLSE.";
"algs.info.sbls.size.b1" = "يتم التعامل معها عادةً على أنها **مجموعة فرعية متقدمة مركزة**، وليست متطلبًا أساسيًا عالميًا لـ Roux";
"algs.info.sbls.size.b2" = "يستهدف نهاية الكتلة الثانية، حيث يمكن للتشطيب النظيف أن يحسن بقية الحل";
"algs.info.sbls.size.b3" = "وتعتمد قيمته بشكل كبير على ما إذا كان التعرف سيظل سريعًا بدرجة كافية في الحلول المباشرة";
"algs.info.sbls.size.b4" = "غالبًا ما يتم تعلمها بشكل انتقائي، كل حالة على حدة، من خلال حلول Roux الذين يتمتعون ببنية إضافية";
"algs.info.sbls.insights.p1" = "SBLS هو Roux ما تفعله العديد من عائلات الفتحة الأخيرة CFOP: طريقة لجعل خطوة البناء النهائية تفعل أكثر من مجرد إنهاء الكتلة.";
"algs.info.sbls.insights.p2" = "نظرًا لأن Roux يعتمد بالفعل بشكل كبير على حدس بناء الكتل، نادرًا ما يكون SBLS أولوية أولى. تصبح جذابة لاحقًا، عندما يريد أحد الحلول عددًا قليلًا من النهايات الأكثر كفاءة دون التخلي عن التدفق الطبيعي للطريقة.";
"algs.info.sbls.insights.p3" = "وهذا يجعل SBLS ذو قيمة خاصة للمستخدمين ذوي التفكير النظري Roux الذين يستمتعون بالتحسينات المستهدفة بدلاً من المجموعات الإلزامية العملاقة.";
"algs.info.sbls.recognition.p1" = "يعتمد التعرف على SBLS على العلاقة النهائية للكتلة الثانية ومسار الإدراج أو الحل المحدد الذي يحافظ على الشكل الذي تريده للمرحلة التالية بشكل أفضل.";
"algs.info.sbls.recommended.p1" = "يوصى به لمحللي Roux الراسخين الذين يفهمون بالفعل بنية الكتلة الثانية جيدًا ويريدون مجموعة فرعية انتقائية متقدمة بدلاً من إصلاح شامل للطريقة.";
"algs.info.sbls.quote.p1" = "\"يكون SBLS مفيدًا للغاية عندما تتوقف الكتلة الثانية عن الشعور بأنها مهمة بناء وتبدأ في الشعور بأنها فرصة لتصميم تشطيب أفضل.\"";
"algs.info.cmll.title" = "حوالي CMLL";
"algs.info.cmll.subtitle" = "التعريف والتاريخ وكفاءة CMLL";
"algs.info.cmll.section.overview" = "نظرة عامة";
"algs.info.cmll.section.history" = "التاريخ";
"algs.info.cmll.section.size" = "الحجم والكفاءة";
"algs.info.cmll.section.insights" = "رؤى";
"algs.info.cmll.section.recognition" = "الاعتراف";
"algs.info.cmll.section.recommended" = "الموصى بها ل";
"algs.info.cmll.section.quote" = "اقتباس";
"algs.info.cmll.overview.p1" = "**CMLL**، اختصار لـ **زوايا الطبقة الأخيرة**، هي مرحلة Roux أساسية تعمل على حل جميع زوايا الطبقة الأخيرة في خوارزمية واحدة بعد اكتمال أول كتلتين. بمجرد الانتهاء من CMLL، يتم تقليل المكعب إلى مرحلة الحافة النهائية للطريقة.";
"algs.info.cmll.history.p1" = "تم تطوير CMLL كجزء أساسي من طريقة **Roux** وهي واحدة من مجموعات الخوارزميات الأكثر تميزًا المرتبطة بهذا النهج. يرتبط هيكلها ارتباطًا وثيقًا بالعائلات التي تركز على الزاوية مثل COLL، ولكنها تقع داخل تدفق الحل المختلف تمامًا لـ Roux.";
"algs.info.cmll.size.b1" = "يتم احتسابها عادةً على أنها **42 خوارزمية** في المجموعة الكاملة";
"algs.info.cmll.size.b2" = "يترك فقط مرحلة حل الحافة النهائية بعد الانتهاء";
"algs.info.cmll.size.b3" = "يعتمد التعرف بشكل كبير على الشكل وغالبًا ما يبدو مضغوطًا بمجرد تعلم العائلات";
"algs.info.cmll.size.b4" = "أحد أهم معالم الخوارزمية الرسمية في Roux";
"algs.info.cmll.insights.p1" = "CMLL عملي لأنه يعطي Roux لمسة نهائية نظيفة وقابلة للتكرار من خطوة واحدة دون إجبار الطريقة على بنية الطبقة الأخيرة التي تشبه CFOP.";
"algs.info.cmll.insights.p2" = "يجد العديد من المحللين أن CMLL يصبح أكثر قابلية للإدارة بمجرد التعرف على أنماطه العائلية القوية. المجموعة كبيرة، لكن الحالات لا تبدو مستقلة بنفس القدر بمجرد فهم تلك العائلات.";
"algs.info.cmll.insights.p3" = "ويوضح أيضًا لماذا يمكن أن تظل Roux فعالة مع تمدد قليل نسبيًا للطبقة الأخيرة: قم بحل الزوايا بشكل نظيف، ثم دع مرحلة الحافة النهائية تقوم بالباقي.";
"algs.info.cmll.recognition.p1" = "يتم التعرف على CMLL من خلال نمط الزاوية للطبقة الأخيرة بعد إنشاء الكتلتين Roux. من الناحية العملية، يستخدم العديد من أدوات الحل أشكال زوايا الوجه العلوي بالإضافة إلى كمية صغيرة من المعلومات الجانبية لقفل الحالة بسرعة.";
"algs.info.cmll.recommended.p1" = "يوصى به لأي حلال Roux جاد. بالمقارنة مع العديد من المجموعات الفرعية الاختيارية المتقدمة، CMLL أقرب بكثير إلى معلم الطريقة الأساسية من المشروع الجانبي المتخصص.";
"algs.info.cmll.quote.p1" = "\"CMLL يبدو قويًا لأنه يمنح Roux نهاية متوسطة منضبطة للغاية: يتم الانتهاء من الزوايا بشكل حاسم، ويمكن أن تتدفق الطريقة مباشرة إلى عملها النهائي.\"";
"algs.info.4a.title" = "حوالي 4 أ";
"algs.info.4a.subtitle" = "التعريف والتاريخ وكفاءة 4 أ";
"algs.info.4a.section.overview" = "نظرة عامة";
"algs.info.4a.section.history" = "التاريخ";
"algs.info.4a.section.size" = "الحجم والكفاءة";
"algs.info.4a.section.insights" = "رؤى";
"algs.info.4a.section.recognition" = "الاعتراف";
"algs.info.4a.section.recommended" = "الموصى بها ل";
"algs.info.4a.section.quote" = "اقتباس";
"algs.info.4a.overview.p1" = "يُستخدم **4a** بشكل شائع كتسمية مختصرة لمجموعة فرعية صغيرة **اتجاه الحافة**. لا يتمثل دورها في حل مرحلة مستقلة ضخمة، ولكن في تنظيف حالة حافة محددة جدًا بحيث تصبح خطوات التعرف أو الإنهاء لاحقًا أكثر كفاءة.";
"algs.info.4a.history.p1" = "مثل العديد من العلامات المختصرة المتخصصة في Speedcubing، انتشرت 4a من خلال الاستخدام المجتمعي أكثر من انتشارها من خلال منشور رسمي مشهور. إنها تظل موجودة لأن الحالات مضغوطة ومن السهل شرح المردود للمحللين المهتمين بالفعل بأساليب إدراك التوجه.";
"algs.info.4a.size.b1" = "**مجموعة فرعية متخصصة صغيرة**، وليست عائلة خوارزمية مستقلة كبيرة";
"algs.info.4a.size.b2" = "التركيز على النتائج الموجهة نحو الحافة بدلاً من التغطية الواسعة للطبقة الأخيرة";
"algs.info.4a.size.b3" = "يكون أكثر فائدة عند إقرانه بطريقة أو مجموعة فرعية تستفيد من حالات الحافة الخاضعة للتحكم";
"algs.info.4a.size.b4" = "يُنظر إليه بشكل أفضل على أنه تحسين مستهدف بدلاً من كونه معلمًا تعليميًا عامًا";
"algs.info.4a.insights.p1" = "4a هو نوع المجموعة الفرعية التي تهم المتخصصين أكثر من مجرد حل متوسط. حالاتها صغيرة بما يكفي للتعلم، ولكنها لا تستحق العناء إلا إذا كانت تناسب أسلوبًا أوسع أو أسلوب تخطيط تستخدمه بالفعل.";
"algs.info.4a.insights.p2" = "وهذا يجعله مثالًا جيدًا لنمط التكعيب الحديث: بمجرد تعلم المعالم الرئيسية، تأتي العديد من المكاسب اللاحقة من مجموعات فرعية صغيرة خاصة بالطريقة المحددة بدلاً من الأنظمة العالمية العملاقة.";
"algs.info.4a.insights.p3" = "بالنسبة إلى المحللين الذين يهتمون بعمق باتجاه الحافة، فحتى مجموعة صغيرة مثل هذه يمكن أن تزيد من حدة كيفية رؤيتهم للمكعب وربط المراحل المتوسطة بشكل أكثر نظافة.";
"algs.info.4a.recognition.p1" = "يتمحور التعرف في 4 أ على نمط اتجاه الحافة ذي الصلة وما إذا كانت الحالة تتطابق مع الحالة الدقيقة التي تم تصميم المجموعة الفرعية للتحكم فيها.";
"algs.info.4a.recommended.p1" = "يوصى به لمحللي الحلول المتقدمين الذين يستخدمون بالفعل أساليب مدركة لاتجاه الحافة ويريدون مجموعة فرعية صغيرة ومحددة للغاية بدلاً من عائلة جديدة واسعة.";
"algs.info.4a.quote.p1" = "\"إن مجموعة مثل 4a مفيدة ليس لأنها ضخمة، ولكن لأنها تحول حالة حافة محددة جدًا إلى شيء يمكن التنبؤ به وقابل لإعادة الاستخدام.\"";
