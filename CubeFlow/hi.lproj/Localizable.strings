"algs.info.4a.section.history" = "इतिहास";
"algs.info.4a.section.size" = "आकार एवं दक्षता";
"algs.info.4a.section.insights" = "अंतर्दृष्टि";
"algs.info.4a.section.recognition" = "मान्यता";
"algs.info.4a.section.recommended" = "के लिए अनुशंसित";
"algs.info.4a.section.quote" = "उद्धरण";
"algs.info.4a.overview.p1" = "**4a** का उपयोग आमतौर पर एक छोटे **एज-ओरिएंटेशन** उपसमुच्चय के लिए शॉर्टहैंड लेबल के रूप में किया जाता है। इसकी भूमिका एक विशाल स्टैंडअलोन चरण को हल करना नहीं है, बल्कि एक बहुत ही विशिष्ट किनारे की स्थिति को साफ करना है ताकि बाद में पहचान या समापन चरण अधिक कुशल हो जाएं।";
"algs.info.4a.history.p1" = "स्पीडक्यूबिंग में कई आला शॉर्टहैंड लेबल की तरह, 4ए एक प्रसिद्ध औपचारिक प्रकाशन से अधिक सामुदायिक उपयोग के माध्यम से फैला। यह जीवित है क्योंकि मामले कॉम्पैक्ट हैं और पहले से ही अभिविन्यास-जागरूक तरीकों में रुचि रखने वाले सॉल्वरों को भुगतान समझाना आसान है।";
"algs.info.4a.size.b1" = "एक **छोटा विशिष्ट उपसमुच्चय**, कोई प्रमुख स्टैंडअलोन एल्गोरिथम परिवार नहीं";
"algs.info.4a.size.b2" = "व्यापक अंतिम-परत कवरेज के बजाय किनारे-उन्मुखीकरण परिणामों पर ध्यान केंद्रित किया गया";
"algs.info.4a.size.b3" = "सबसे उपयोगी तब होता है जब इसे किसी ऐसी विधि या उपसमुच्चय के साथ जोड़ा जाता है जो नियंत्रित किनारे की स्थिति से लाभान्वित होता है";
"algs.info.4a.size.b4" = "इसे सामान्य शिक्षण मील के पत्थर की तुलना में लक्षित अनुकूलन के रूप में बेहतर देखा जाता है";
"algs.info.4a.insights.p1" = "4ए एक ऐसा उपसमुच्चय है जो औसत सॉल्वर की तुलना में विशेषज्ञों के लिए अधिक मायने रखता है। इसके मामले सीखने के लिए काफी छोटे हैं, लेकिन केवल तभी इसके लायक हैं जब वे आपके द्वारा पहले से उपयोग की जाने वाली व्यापक पद्धति या योजना शैली में फिट हों।";
"algs.info.4a.insights.p2" = "यह इसे आधुनिक क्यूबिंग पैटर्न का एक अच्छा उदाहरण बनाता है: एक बार जब मुख्यधारा के मील के पत्थर सीख लिए जाते हैं, तो बाद के कई लाभ विशाल सार्वभौमिक प्रणालियों के बजाय छोटे, विधि-विशिष्ट उपसमुच्चय से आते हैं।";
"algs.info.4a.insights.p3" = "सॉल्वरों के लिए जो किनारे के उन्मुखीकरण की गहराई से परवाह करते हैं, यहां तक कि इस तरह का एक छोटा सेट भी क्यूब को देखने के तरीके को तेज कर सकता है और मध्यवर्ती चरणों को अधिक सफाई से जोड़ सकता है।";
"algs.info.4a.recognition.p1" = "4ए में पहचान प्रासंगिक किनारे-अभिविन्यास पैटर्न पर केंद्रित है और क्या मामला उस सटीक स्थिति से मेल खाता है जिसे नियंत्रित करने के लिए सबसेट डिज़ाइन किया गया है।";
"algs.info.4a.recommended.p1" = "उन्नत सॉल्वरों के लिए अनुशंसित जो पहले से ही एज-ओरिएंटेशन-जागरूक दृष्टिकोण का उपयोग करते हैं और एक व्यापक नए परिवार के बजाय एक छोटा, अत्यधिक विशिष्ट उपसमूह चाहते हैं।";
"algs.info.4a.quote.p1" = "\"4ए जैसा सेट इसलिए उपयोगी नहीं है क्योंकि यह बहुत बड़ा है, बल्कि इसलिए क्योंकि यह एक बहुत ही विशिष्ट किनारे की स्थिति को पूर्वानुमानित और पुन: प्रयोज्य में बदल देता है।\"";
