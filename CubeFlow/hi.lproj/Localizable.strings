"algs.info.sbls.section.quote" = "उद्धरण";
"algs.info.sbls.overview.p1" = "**एसबीएलएस**, जिसे आमतौर पर **सेकंड ब्लॉक लास्ट स्लॉट** के रूप में विस्तारित किया जाता है, एक Roux-उन्मुख परिवार है जो दूसरे ब्लॉक के अंतिम टुकड़े के रिश्ते को अधिक एल्गोरिथम तरीके से संभालता है। यह CFOP में उन्नत अंतिम-स्लॉट कार्य के समान सामान्य विचार से संबंधित है: आगे जो आता है उसे बेहतर बनाने के लिए अंतिम प्रविष्टि का उपयोग करें।";
"algs.info.sbls.history.p1" = "जैसे ही Roux उपयोगकर्ताओं ने दूसरे-ब्लॉक दक्षता को परिष्कृत किया, कुछ आवर्ती अंतिम-स्लॉट पैटर्न सूचीबद्ध करने लायक साबित हुए। एसबीएलएस दूसरे ब्लॉक के अंत को CMLL और LSE से पहले अधिक साफ-सुथरा और अधिक सुसंगत बनाने के उस व्यावहारिक दबाव से विकसित हुआ।";
"algs.info.sbls.size.b1" = "आमतौर पर **केंद्रित उन्नत उपसमुच्चय** के रूप में माना जाता है, Roux के लिए सार्वभौमिक आधारभूत आवश्यकता नहीं";
"algs.info.sbls.size.b2" = "दूसरे ब्लॉक के अंत को लक्षित करता है, जहां एक साफ फिनिश बाकी समाधान को बेहतर बना सकती है";
"algs.info.sbls.size.b3" = "इसका मूल्य काफी हद तक इस बात पर निर्भर करता है कि लाइव सॉल्व्स में पहचान पर्याप्त तेज़ रहती है या नहीं";
"algs.info.sbls.size.b4" = "अक्सर अतिरिक्त संरचना का आनंद लेने वाले Roux सॉल्वरों द्वारा, मामले दर मामले, चुनिंदा तरीके से सीखा जाता है";
"algs.info.sbls.insights.p1" = "एसबीएलएस Roux के बराबर है, जो कई अंतिम-स्लॉट वाले परिवार CFOP के लिए हैं: अंतिम निर्माण चरण को केवल ब्लॉक खत्म करने से कहीं अधिक करने का एक तरीका।";
"algs.info.sbls.insights.p2" = "क्योंकि Roux पहले से ही ब्लॉकबिल्डिंग अंतर्ज्ञान पर बहुत अधिक निर्भर करता है, एसबीएलएस शायद ही पहली प्राथमिकता है। यह बाद में आकर्षक हो जाता है, जब एक सॉल्वर विधि के प्राकृतिक प्रवाह को छोड़े बिना कुछ अधिक कुशल अंत चाहता है।";
"algs.info.sbls.insights.p3" = "यह एसबीएलएस को सिद्धांत-दिमाग वाले Roux उपयोगकर्ताओं के लिए विशेष रूप से मूल्यवान बनाता है जो विशाल अनिवार्य सेटों के बजाय लक्षित अनुकूलन का आनंद लेते हैं।";
"algs.info.sbls.recognition.p1" = "एसबीएलएस मान्यता अंतिम दूसरे-ब्लॉक संबंध और विशिष्ट सम्मिलन या रिज़ॉल्यूशन पथ पर आधारित है जो अगले चरण के लिए आपके इच्छित आकार को सर्वोत्तम रूप से संरक्षित करता है।";
"algs.info.sbls.recommended.p1" = "स्थापित Roux सॉल्वरों के लिए अनुशंसित जो पहले से ही दूसरे-ब्लॉक संरचना को अच्छी तरह से समझते हैं और एक व्यापक विधि ओवरहाल के बजाय एक चयनात्मक उन्नत उपसमूह चाहते हैं।";
"algs.info.sbls.quote.p1" = "\"एसबीएलएस तब सबसे उपयोगी होता है जब दूसरा ब्लॉक एक निर्माण कार्य की तरह महसूस करना बंद कर देता है और बेहतर फिनिश इंजीनियर करने के अवसर की तरह महसूस करना शुरू कर देता है।\"";
