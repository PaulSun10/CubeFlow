"algs.info.coll.section.quote" = "उद्धरण";
"algs.info.coll.overview.p1" = "**COLL**, **अंतिम परत के कोनों** का संक्षिप्त रूप, पहले से ही उन्मुख किनारों को संरक्षित करते हुए सभी अंतिम-परत के कोनों को एक चरण में हल करता है। COLL केस के बाद, क्यूब को **EPLL** केस में से एक में घटा दिया जाता है।";
"algs.info.coll.history.p1" = "COLL बुनियादी अंतिम-परत प्रणालियों और बड़े वन-लुक परिवारों के बीच एक पुल के रूप में लोकप्रिय हो गया। यह **ZZ** जैसे एज-ओरिएंटेड तरीकों से निकटता से जुड़ा हुआ है, लेकिन CFOP सॉल्वर्स ने इसे ओसीएलएल प्लस PLL पर एक व्यावहारिक अपग्रेड के रूप में भी अपनाया है।";
"algs.info.coll.size.b1" = "**42 एल्गोरिदम** पूर्ण सेट में जब दर्पणों को अलग से गिना जाता है";
"algs.info.coll.size.b2" = "इसे अक्सर **24 मुख्य मामलों** के रूप में वर्णित किया जाता है जब दर्पण और व्युत्क्रमों को समूहीकृत किया जाता है";
"algs.info.coll.size.b3" = "पूरा होने के बाद केवल **4 ईपीएलएल मामले** छोड़ता है";
"algs.info.coll.size.b4" = "सबसे उपयोगी तब होता है जब अंतिम-परत के किनारे पहले से ही उन्मुख होते हैं";
"algs.info.coll.insights.p1" = "COLL OLL/PLL और बड़े वन-लुक सिस्टम के बीच एक प्राकृतिक मध्यबिंदु है। यह ZBLL जैसे सेट के भारी आकार के बिना वास्तविक दक्षता लाभ देता है।";
"algs.info.coll.insights.p2" = "क्योंकि यह कोनों को पूरी तरह से हल करता है, COLL सुरुचिपूर्ण अंत उत्पन्न कर सकता है और कभी-कभी एक हल किए गए घन या बहुत आसान ईपीएलएल में तत्काल छोड़ देता है। यह इसे उन सॉल्वरों के लिए विशेष रूप से आकर्षक बनाता है जो कुशल अंतिम-परत फिनिश का आनंद लेते हैं।";
"algs.info.coll.insights.p3" = "कई सॉल्वर परिचित ओसीएलएल-शैली कोने पैटर्न के साथ मामलों को समूहीकृत करके COLL सीखते हैं। एक बार जब वे परिवार स्थिर हो जाते हैं, तो अतिरिक्त कोने का क्रमपरिवर्तन विवरण जोड़ना बहुत आसान हो जाता है।";
"algs.info.coll.recognition.p1" = "COLL को कोने के क्रमपरिवर्तन के साथ दृश्यमान कोने अभिविन्यास पैटर्न को जोड़कर पहचाना जाता है। व्यवहार में, कई सॉल्वर पहले ओसीएलएल-शैली के आकार की पहचान करते हैं और फिर पुष्टि करते हैं कि यह कौन सा क्रमपरिवर्तन मामला है।";
"algs.info.coll.recommended.p1" = "क्यूबर्स के लिए अनुशंसित जो पहले से ही **पूर्ण PLL** जानते हैं, **OLL** के साथ सहज हैं, और अधिक कुशल वन-लुक लास्ट-लेयर सॉल्विंग की दिशा में एक प्रबंधनीय मार्ग चाहते हैं। यह **ZZ** और उन्नत **CFOP** उपयोगकर्ताओं के लिए विशेष रूप से आकर्षक है।";
"algs.info.coll.quote.p1" = "\"COLL अक्सर उस बिंदु की तरह महसूस होता है जहां उन्नत अंतिम-परत सिद्धांत व्यावहारिक हो जाता है: सीखने के लिए काफी छोटा, लेकिन समाधान के अंत को स्पष्ट रूप से बदलने के लिए पर्याप्त मजबूत।\"";
"algs.info.ollcp.title" = "OLLCP के बारे में";
