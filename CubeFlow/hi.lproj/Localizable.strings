"algs.info.megaminxpll.structure.b4" = "बड़ा उन्नत सेट; कई सॉल्वर पहले उपयोगी उपसमुच्चय सीखते हैं";
"algs.info.megaminxpll.insights.p1" = "Megaminx PLL एक स्पष्ट भुगतान देता है: दो के बजाय एक क्रमपरिवर्तन चरण। ट्रेडऑफ़ बहुत अधिक पहचान और याद रखने का भार है।";
"algs.info.megaminxpll.insights.p2" = "क्योंकि कई 3x3 PLL अवधारणाएं स्थानांतरित होती हैं, यह सेट अपने आकार से सुझाए गए से अधिक पहुंच योग्य महसूस कर सकता है, लेकिन केवल तभी जब आपके Megaminx अभिविन्यास चरण पहले से ही स्वचालित हों।";
"algs.info.megaminxpll.insights.p3" = "आंशिक PLL सामान्य है. उन मामलों को जानें जो पूरा होने से पहले धीमे EP+CP संयोजनों को प्रतिस्थापित करते हैं।";
"algs.info.megaminxpll.recognition.p1" = "मान्यता पांच-तरफा अंतिम परत के चारों ओर किनारे और कोने दोनों क्रमपरिवर्तन को पढ़ती है, जो आमतौर पर हल किए गए ब्लॉक या स्पष्ट चक्रों से शुरू होती है।";
"algs.info.megaminxpll.recommended.p1" = "उन्नत Megaminx सॉल्वरों के लिए अनुशंसित जिनके पास पहले से ही विश्वसनीय 4LLL है और अंतिम-परत के लुक को कम करना चाहते हैं।";
"algs.info.megaminxpll.quote.p1" = "Megaminx PLL उन्नत सॉल्वर का सौदा है: कम रूप, अधिक पहचान का दबाव।";
"algs.info.l3e.title" = "Pyraminx L3E के बारे में";
