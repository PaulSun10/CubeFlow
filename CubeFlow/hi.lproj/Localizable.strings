"algs.info.zbll.subtitle" = "ZBLL की परिभाषा, इतिहास और दक्षता";
"algs.info.zbll.section.overview" = "सिंहावलोकन";
"algs.info.zbll.section.history" = "इतिहास";
"algs.info.zbll.section.size" = "आकार एवं दक्षता";
"algs.info.zbll.section.insights" = "अंतर्दृष्टि";
