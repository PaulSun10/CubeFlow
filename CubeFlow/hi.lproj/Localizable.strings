"algs.info.megaminxep.structure.b3" = "CP के लिए कोनों को छोड़ते समय किनारों को क्रमबद्ध करता है";
"algs.info.megaminxep.structure.b4" = "छोटा सेट, लेकिन पाँच किनारों पर पहचान के लिए अभ्यास की आवश्यकता होती है";
"algs.info.megaminxep.insights.p1" = "EP उच्चतम-मूल्य वाले Megaminx सेटों में से एक है क्योंकि यह छोटा है और प्रत्येक 4LLL सॉल्व में दिखाई देता है।";
"algs.info.megaminxep.insights.p2" = "चूँकि केवल पाँच किनारे शामिल हैं, इसलिए मामलों को यादृच्छिक पैटर्न के बजाय चक्र के रूप में समझा जा सकता है।";
"algs.info.megaminxep.insights.p3" = "क्लीन EP अक्सर यह निर्धारित करता है कि आप कितनी आसानी से CP में प्रवेश करते हैं, खासकर यदि आपकी अंतिम AUF योजना कमजोर है।";
"algs.info.megaminxep.recognition.p1" = "अंतिम परत के चारों ओर हल किए गए किनारों की स्थिति देखें और शेष चक्र या स्वैप पैटर्न की पहचान करें।";
