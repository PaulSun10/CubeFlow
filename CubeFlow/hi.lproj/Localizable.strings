"algs.info.megaminxoll.overview.p1" = "**Megaminx OLL** अंतिम-लेयर एज ओरिएंटेशन और कॉर्नर ओरिएंटेशन को एक एकल ओरिएंटेशन चरण में जोड़ता है, Megaminx अंतिम परत को 4LLL से कम करके अधिक उन्नत 2-लुक या 3-लुक संरचना की ओर ले जाता है।";
"algs.info.megaminxoll.context.p1" = "स्पीडसॉल्विंग संसाधन पूर्ण Megaminx OLL को एक बहुत बड़े उन्नत सेट के रूप में वर्णित करते हैं। यहां तक ​​कि कई मजबूत सॉल्वर भी इसके कुछ हिस्सों का ही उपयोग करते हैं क्योंकि सीखने की लागत अधिक होती है।";
"algs.info.megaminxoll.structure.b1" = "Megaminx OLL में **178 मामले** हैं";
"algs.info.megaminxoll.structure.b2" = "EO और CO को जोड़ता है";
"algs.info.megaminxoll.structure.b3" = "उन्नत 2LLL-शैली Megaminx दृष्टिकोण का हिस्सा";
"algs.info.megaminxoll.structure.b4" = "बड़ा वैकल्पिक सेट; आंशिक सीखना सामान्य है";
"algs.info.megaminxoll.insights.p1" = "Megaminx OLL शक्तिशाली है लेकिन महंगा है। इसका मूल्य इस बात पर निर्भर करता है कि क्या घटी हुई लुक गणना वास्तव में F2L, S2L, और 4LLL निष्पादन पर उस अभ्यास समय को खर्च करने से बेहतर है।";
"algs.info.megaminxoll.insights.p2" = "आंशिक OLL अभी भी उपयोगी हो सकता है। उच्च-आवृत्ति या एर्गोनोमिक मामले पूरे सेट की मांग किए बिना समाधानों में सुधार कर सकते हैं।";
"algs.info.megaminxoll.insights.p3" = "क्योंकि Megaminx में 3x3 की तुलना में अधिक अंतिम-परत के टुकड़े हैं, पहचान ही असली बाधा है। एल्गोरिथम गणना केवल आधी चुनौती है।";
"algs.info.megaminxoll.recognition.p1" = "पहचान किनारे ओरिएंटेशन पैटर्न और पांच-कोने ओरिएंटेशन पैटर्न को एक मामले में जोड़ती है।";
"algs.info.megaminxoll.recommended.p1" = "Megaminx 4LLL मजबूत होने के बाद ही अनुशंसित किया जाता है और आप विशेष रूप से उन्नत अंतिम-परत संपीड़न में निवेश करना चाहते हैं।";
"algs.info.megaminxoll.quote.p1" = "Megaminx OLL एक लक्जरी सेट है: जब यह काम करता है तो सुंदर होता है, लेकिन केवल तभी इसके लायक होता है जब मूल बातें पहले से ही तेज हों।";
