"algs.info.zbll.section.recommended" = "के लिए अनुशंसित";
"algs.info.zbll.section.quote" = "उद्धरण";
"algs.info.zbll.overview.p1" = "**ZBLL**, **ज़बोरोव्स्की-ब्रूकेम लास्ट लेयर** का संक्षिप्त रूप, एक उन्नत एल्गोरिदम सेट है जिसका उपयोग **एक चाल में संपूर्ण अंतिम परत** को हल करने के लिए किया जाता है जब **सभी शीर्ष-परत किनारे पहले से ही उन्मुख होते हैं**। यह पहचान और क्रमपरिवर्तन को एक ही चरण में जोड़ता है, जो अक्सर बहुत कुशल अंतिम-परत समाधान उत्पन्न करता है।";
"algs.info.zbll.history.p1" = "ZBLL को 2000 के दशक की शुरुआत में **ज़बिग्न्यू ज़बोरोव्स्की** और **रॉन वैन ब्रुकेम** द्वारा ZB पद्धति के भाग के रूप में विकसित किया गया था। हालाँकि संबंधित वन-लुक लास्ट-लेयर विचार पहले से मौजूद थे, स्पीडक्यूबिंग समुदाय ने अंततः एल्गोरिदम के इस परिवार के लिए **“ZBLL”** नाम अपनाया।";
"algs.info.zbll.size.b1" = "कुल मिलाकर **472 एल्गोरिदम**";
"algs.info.zbll.size.b2" = "औसत चाल गिनती **12 एचटीएम** के आसपास है";
"algs.info.zbll.size.b3" = "सबसे प्रभावी तब जब **सभी अंतिम-परत किनारे पहले से ही उन्मुख हों**";
"algs.info.zbll.size.b4" = "**ZZ** जैसी विधियों में विशेष रूप से उपयोगी, जहां किनारे का अभिविन्यास F2L के बाद संरक्षित किया जाता है";
"algs.info.zbll.insights.p1" = "क्योंकि ZBLL इतना बड़ा सेट है, अधिकांश क्यूबर्स इसे एक साथ सीखने के बजाय धीरे-धीरे सीखते हैं। व्यवहार में, कई सॉल्वर **उपसमुच्चय** से शुरू होते हैं जो वास्तविक सॉल्व में स्पष्ट दक्षता लाभ देते हैं। कुछ समूह, जैसे **एस** और **एएस** मामले, अक्सर बाद में सीखे जाते हैं या पूरी तरह से छोड़ दिए जाते हैं, क्योंकि उनके विकल्प पहले से ही अपेक्षाकृत सरल होते हैं।";
"algs.info.zbll.insights.p2" = "ZBLL आमतौर पर अंतर्निहित **COLL केस** द्वारा व्यवस्थित किया जाता है: **टी, यू, एल, पाई, सुने, एंटी-सुने, और एच**। कुछ प्रणालियाँ एक अतिरिक्त **\"PLL\" या \"O\" समूह** का भी उल्लेख करती हैं, हालाँकि व्यवहार में इस समूह को हमेशा अलग से नहीं गिना जाता है, और इस सहित कुछ संग्रह, इसे अपने स्वयं के सेट के रूप में नहीं मानते हैं।";
"algs.info.zbll.insights.p3" = "फिर इन सेटों को **उपसमुच्चयों** में विभाजित किया जाता है। पूर्ण वर्गीकरण में, प्रत्येक उपसमुच्चय में **12 मामले** होते हैं, जो अलग-अलग **किनारे चक्रों** के अनुरूप होते हैं, जो तब हो सकते हैं जब COLL मामला समान रहता है।";
"algs.info.zbll.recognition.p1" = "ZBLL मामलों को अंतर्निहित **COLL मामले** और संबंधित **किनारे चक्र** दोनों की पहचान करके पहचाना जाता है। कोने का पैटर्न मुख्य परिवार को निर्धारित करता है, जबकि किनारे का क्रमपरिवर्तन उस परिवार के भीतर सटीक मामला निर्धारित करता है।";
"algs.info.zbll.recommended.p1" = "उन क्यूबर्स के लिए अनुशंसित जो पहले से ही **पूर्ण PLL और OLL** जानते हैं और अधिक उन्नत वन-लुक लास्ट-लेयर समाधान चाहते हैं। यह विशेष रूप से **ZZ** सॉल्वरों के लिए उपयुक्त है, लेकिन **CFOP** उपयोगकर्ताओं के लिए भी मूल्यवान हो सकता है जो अंतिम-परत चरण गिनती को कम करना चाहते हैं और अधिक कुशल फिनिश का पता लगाना चाहते हैं।";
"algs.info.zbll.quote.p1" = "\"अधिकांश क्यूबर्स एक बार में ZBLL नहीं सीखते हैं। वे इसे **सबसेट दर सबसेट** बनाते हैं, उन मामलों से शुरू करते हैं जो स्पष्ट **व्यावहारिक मूल्य** प्रदान करते हैं।\"";
"algs.info.pll.title" = "PLL के बारे में";
"algs.info.pll.subtitle" = "PLL की परिभाषा, इतिहास और दक्षता";
"algs.info.pll.section.overview" = "सिंहावलोकन";
"algs.info.pll.section.history" = "इतिहास";
"algs.info.pll.section.size" = "आकार एवं दक्षता";
"algs.info.pll.section.insights" = "अंतर्दृष्टि";
"algs.info.pll.section.recognition" = "मान्यता";
"algs.info.pll.section.recommended" = "के लिए अनुशंसित";
"algs.info.pll.section.quote" = "उद्धरण";
"algs.info.pll.overview.p1" = "**PLL**, **अंतिम परत के क्रमपरिवर्तन** का संक्षिप्त रूप, CFOP में मानक दो-दिखने वाली अंतिम-परत संरचना का अंतिम चरण है। अंतिम-परत के टुकड़ों के उन्मुख होने के बाद, PLL उनके शेष क्रमपरिवर्तन को **एक एल्गोरिदम** में हल करता है, और घन को समाप्त करता है।";
"algs.info.pll.history.p1" = "PLL ने 1980 के दशक में प्रारंभिक **फ़्रिडरिच पद्धति** के अंदर आकार लिया और आमतौर पर **हंस डॉकहॉर्न**, **एनेके ट्रीप** और बाद में **जेसिका फ़्रीडरिक** के काम से जुड़ा हुआ है। जैसे ही CFOP स्पीडक्यूबिंग के माध्यम से फैला, PLL कई सॉल्वरों के लिए मानक अंतिम चरण बन गया।";
"algs.info.pll.size.b1" = "**21 एल्गोरिदम** पूरे सेट में";
"algs.info.pll.size.b2" = "यदि दर्पण और व्युत्क्रमों को एक साथ समूहीकृत किया जाए तो इसे अक्सर **13 मुख्य मामलों** के रूप में वर्णित किया जाता है";
"algs.info.pll.size.b3" = "औसत इष्टतम लंबाई लगभग **11 से 12 एचटीएम** है";
"algs.info.pll.size.b4" = "**OLL** या किसी अन्य चरण के बाद उपयोग किया जाता है जो अंतिम परत को उन्मुख छोड़ देता है";
"algs.info.pll.insights.p1" = "PLL स्पीडक्यूबिंग में उच्चतम-मूल्य वाले एल्गोरिदम सेटों में से एक है क्योंकि पूरा सेट सीखने से तुरंत दूसरे क्रमपरिवर्तन चरण की आवश्यकता समाप्त हो जाती है। कई क्यूबर्स के लिए, यह शुरुआती तरीकों के बाद सीखा गया पहला बड़ा सेट है।";
"algs.info.pll.insights.p2" = "सेट को अक्सर व्यापक परिवारों में समूहीकृत किया जाता है जैसे **केवल किनारे वाले मामले**, **केवल कोने वाले मामले**, और मिश्रित क्रमपरिवर्तन। **T**, **J**, **R**, **G**, और **N** जैसे सामान्य नाम अब क्यूबिंग संस्कृति में गहराई से अंतर्निहित हो गए हैं।";
"algs.info.pll.insights.p3" = "व्यवहार में, PLL कच्चे एल्गोरिथम गणना की तुलना में आत्मविश्वासपूर्ण पहचान को अधिक पुरस्कृत करता है। **हेडलाइट्स**, **बार्स**, और साइड ब्लॉक्स से साफ पहचान अक्सर एल्गोरिदम से एक कदम आगे निकलने की तुलना में अधिक समय बचाती है।";
"algs.info.pll.recognition.p1" = "PLL को यह देखकर पहचाना जाता है कि पहले से ही उन्मुख अंतिम-परत के टुकड़ों को कैसे क्रमबद्ध किया जाता है। सॉल्वर आमतौर पर केस की पहचान करने के लिए **हेडलाइट्स**, सॉल्व्ड बार, आसन्न ब्लॉक और समग्र किनारे चक्र पैटर्न जैसी सुविधाओं का उपयोग करते हैं।";
"algs.info.pll.recommended.p1" = "शुरुआती अंतिम-परत विधियों से आगे बढ़ने वाले किसी भी क्यूबर के लिए अनुशंसित। पूर्ण PLL, CFOP में सबसे व्यावहारिक निवेशों में से एक है और **COLL**, **OLLCP**, और **ZBLL** जैसे अधिक उन्नत सेटों के लिए आधार के रूप में भी कार्य करता है।";
"algs.info.pll.quote.p1" = "\"पूर्ण PLL अक्सर पहला क्षण होता है जब एक सॉल्वर को लगता है कि अंतिम परत वास्तव में तेज़ हो गई है, क्योंकि क्यूब अब **एक स्वच्छ क्रमपरिवर्तन चरण** में समाप्त हो सकता है।\"";
"algs.info.oll.title" = "OLL के बारे में";
"algs.info.oll.subtitle" = "OLL की परिभाषा, इतिहास और दक्षता";
"algs.info.oll.section.overview" = "सिंहावलोकन";
"algs.info.oll.section.history" = "इतिहास";
"algs.info.oll.section.size" = "आकार एवं दक्षता";
"algs.info.oll.section.insights" = "अंतर्दृष्टि";
"algs.info.oll.section.recognition" = "मान्यता";
"algs.info.oll.section.recommended" = "के लिए अनुशंसित";
"algs.info.oll.section.quote" = "उद्धरण";
"algs.info.oll.overview.p1" = "**OLL**, **अंतिम परत के ओरिएंटेशन** का संक्षिप्त रूप, उनके क्रमपरिवर्तन को अनदेखा करते हुए सभी अंतिम-परत के टुकड़ों के अभिविन्यास को एक चरण में हल करता है। CFOP में, इसका उपयोग सामान्यतः F2L के बाद और PLL से पहले किया जाता है।";
"algs.info.oll.history.p1" = "PLL की तरह, OLL 1980 के दशक में शुरुआती **फ़्रिडरिच विधि** से विकसित हुआ। आधुनिक पूर्ण सेट को समय के साथ परिष्कृत किया गया क्योंकि स्पीडक्यूबर्स ने अंतिम परत की प्रत्येक अभिविन्यास स्थिति के लिए एल्गोरिदम एकत्र और अनुकूलित किया।";
"algs.info.oll.size.b1" = "**57 एल्गोरिदम** पूरे सेट में";
"algs.info.oll.size.b2" = "एक सामान्य मील का पत्थर **2-लुक OLL** है, जो सबसे पहले सीखने के भार को कम करता है";
"algs.info.oll.size.b3" = "औसत चाल गणना आमतौर पर **9 से 10 एचटीएम** के आसपास होती है";
"algs.info.oll.size.b4" = "अंतिम परत को एक ऐसी स्थिति में परिवर्तित करने के लिए उपयोग किया जाता है जिसे **PLL** के साथ समाप्त किया जा सकता है";
"algs.info.oll.insights.p1" = "OLL, CFOP में सबसे बड़ी छलांगों में से एक है क्योंकि यह एक बहु-चरण प्रक्रिया से अंतिम परत को PLL के बाद एक स्वच्छ अभिविन्यास चरण में बदल देता है। यही कारण है कि कई क्यूबर्स पूर्ण PLL में महारत हासिल करने के बाद इसे धीरे-धीरे सीखते हैं।";
"algs.info.oll.insights.p2" = "सेट आमतौर पर व्यापक आकार वाले परिवारों जैसे **डॉट**, **लाइन**, **क्रॉस**, और **कॉर्नर ओरिएंटेशन पैटर्न** द्वारा सीखा जाता है। इससे सॉल्वरों को 57 अलग-अलग मामलों को याद रखने के बजाय परतों में पहचान बनाने की सुविधा मिलती है।";
"algs.info.oll.insights.p3" = "उन्नत सॉल्वरों के बीच भी, सभी OLL मामले समान नहीं लगते। कुछ बेहद एर्गोनोमिक और तेज़ हैं, जबकि अन्य को कच्ची चाल गणना की तुलना में पहचान संकेतों और सेटअप आदतों द्वारा अधिक याद किया जाता है।";
"algs.info.oll.recognition.p1" = "OLL को अंतिम परत के ओरिएंटेशन पैटर्न द्वारा पहचाना जाता है: ओरिएंटेड किनारों द्वारा बनाई गई आकृति, साथ ही दृश्य शीर्ष-परत कोनों का ओरिएंटेशन। कुशल पहचान आमतौर पर शीर्ष-चेहरे के आकार को साइड स्टिकर के साथ जोड़ती है।";
"algs.info.oll.recommended.p1" = "क्यूबर्स के लिए अनुशंसित जो पहले से ही **पूर्ण PLL** जानते हैं और पूर्ण दो-चरणीय अंतिम परत चाहते हैं। पूर्ण OLL CFOP के लिए एक प्रमुख व्यावहारिक उन्नयन है और अधिक उन्नत अंतिम-परत प्रणालियों को समझने के लिए एक शर्त है।";
"algs.info.oll.quote.p1" = "\"सीखना OLL 57 यादृच्छिक चित्रों को याद करने के बारे में कम है और मुट्ठी भर **पहचान परिवारों** के साथ आत्मविश्वास बनाने के बारे में अधिक है जो पूरे सेट में दोहराए जाते हैं।\"";
"algs.info.f2l.title" = "F2L के बारे में";
"algs.info.f2l.subtitle" = "F2L की परिभाषा, इतिहास और दक्षता";
"algs.info.f2l.section.overview" = "सिंहावलोकन";
"algs.info.f2l.section.history" = "इतिहास";
"algs.info.f2l.section.size" = "आकार एवं दक्षता";
"algs.info.f2l.section.insights" = "अंतर्दृष्टि";
"algs.info.f2l.section.recognition" = "मान्यता";
"algs.info.f2l.section.recommended" = "के लिए अनुशंसित";
"algs.info.f2l.section.quote" = "उद्धरण";
"algs.info.f2l.overview.p1" = "**F2L**, **पहली दो परतें** का संक्षिप्त रूप, एक कोने-किनारे की जोड़ी को हल करता है और एक ही समय में इसे अपने स्लॉट में सम्मिलित करता है। आधुनिक CFOP में, यह दूसरी परत को अलग से हल करने के पुराने शुरुआती दृष्टिकोण को प्रतिस्थापित करता है और अंतिम परत से पहले तेजी से हल करने का मूल है।";
"algs.info.f2l.history.p1" = "कॉर्नर-एज पेयरिंग का विचार 1970 के दशक के अंत में सामने आया, विशेष रूप से **जॉन कॉनवे**, **डेविड सिंगमास्टर सर्कल**, और बाद के तरीकों से जुड़े काम में जो आधुनिक स्पीडक्यूबिंग नोटेशन से पहले के थे। यह **फ़्रिडरिच विधि** का केंद्र बन गया, जहां सहज ज्ञान युक्त F2L ने अंततः अधिक कठोर चरण-दर-चरण परत निर्माण का स्थान ले लिया।";
"algs.info.f2l.size.b1" = "**कोई एकल निश्चित पूर्ण सेट** नहीं है, क्योंकि F2L का अधिकांश भाग सहज रूप से हल किया जाता है";
"algs.info.f2l.size.b2" = "आमतौर पर अध्ययन किया जाने वाला उपसमुच्चय **41 अंतिम-स्लॉट मामले** है";
"algs.info.f2l.size.b3" = "मजबूत F2L आमतौर पर कच्चे एल्गोरिदम गणना की तुलना में **लुकहेड** के माध्यम से अधिक समय बचाता है";
"algs.info.f2l.size.b4" = "उन्नत अंतिम-स्लॉट शाखाएँ जैसे **WV**, **VLS**, और **ZBLS** सभी F2L संरचना से विकसित होती हैं";
"algs.info.f2l.insights.p1" = "F2L वह जगह है जहां से वास्तविक समाधान गति का एक बड़ा हिस्सा आता है। बेहतर जोड़ी निर्माण, बेहतर स्लॉट चयन, और सहज लुकआगे अक्सर आखिरी परत से एक कदम आगे बढ़ने की तुलना में अधिक मायने रखता है।";
"algs.info.f2l.insights.p2" = "अधिकांश क्यूबर्स सहज ज्ञान युक्त F2L से शुरू करते हैं, फिर अजीब मामलों के लिए चयनित एल्गोरिदम सीखते हैं। यही कारण है कि F2L शुद्ध अंतर्ज्ञान और औपचारिक एल्गोरिदम अध्ययन के बीच एक असामान्य स्थान पर बैठता है।";
"algs.info.f2l.insights.p3" = "एक बार जब एक सॉल्वर F2L संरचना के साथ सहज हो जाता है, तो कई उन्नत प्रणालियाँ समझ में आने लगती हैं: अंतिम-स्लॉट चालें, किनारे-अभिविन्यास-जागरूक आवेषण, और एक-लुक संक्रमण सभी एक ही मूल जोड़ी तर्क पर निर्मित होते हैं।";
"algs.info.f2l.recognition.p1" = "F2L पहचान का अर्थ है लक्ष्य कोने, उसके मिलान किनारे और खुले स्लॉट से उनके संबंध को ट्रैक करना। कुशल सॉल्वर पिछली जोड़ी को ख़त्म करने से पहले जोड़ी की स्थिति और सर्वोत्तम सम्मिलन पथ दोनों की पहचान करते हैं।";
"algs.info.f2l.recommended.p1" = "शुरुआती परत-दर-परत विधियों से आगे बढ़ते हुए प्रत्येक क्यूबर के लिए अनुशंसित। मजबूत F2L न केवल **CFOP** के लिए मूलभूत है, बल्कि अंतिम स्लॉट पर निर्मित कई उन्नत सबसेट सिस्टम को समझने के लिए भी है।";
"algs.info.f2l.quote.p1" = "\"फास्ट F2L शायद ही सबसे अधिक एल्गोरिदम को जानने के बारे में है। यह जोड़ियों को जल्दी देखने, अच्छे स्लॉट चुनने और क्यूब को **आगे देखने** के साथ चलते रहने के बारे में है।\"";
"algs.info.coll.title" = "COLL के बारे में";
