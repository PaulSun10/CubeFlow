"algs.info.cmll.section.recommended" = "के लिए अनुशंसित";
"algs.info.cmll.section.quote" = "उद्धरण";
"algs.info.cmll.overview.p1" = "**CMLL**, **कॉर्नर ऑफ़ द लास्ट लेयर** का संक्षिप्त रूप, एक कोर Roux चरण है जो पहले दो ब्लॉकों के पूरा होने के बाद सभी अंतिम-लेयर कोनों को एक एल्गोरिदम में हल करता है। एक बार CMLL हो जाने पर, घन को विधि के अंतिम किनारे चरण में कम कर दिया जाता है।";
"algs.info.cmll.history.p1" = "CMLL को **Roux विधि** के केंद्रीय भाग के रूप में विकसित किया गया है और यह उस दृष्टिकोण से जुड़े सबसे विशिष्ट एल्गोरिदम सेटों में से एक है। इसकी संरचना COLL जैसे कोने-केंद्रित परिवारों से निकटता से संबंधित है, लेकिन यह Roux के बहुत अलग समाधान प्रवाह के अंदर बैठती है।";
"algs.info.cmll.size.b1" = "पूरे सेट में आमतौर पर **42 एल्गोरिदम** के रूप में गिना जाता है";
"algs.info.cmll.size.b2" = "पूरा होने के बाद केवल अंतिम किनारा-समाधान चरण छोड़ता है";
"algs.info.cmll.size.b3" = "पहचान काफी हद तक आकार पर आधारित होती है और परिवारों को सीख लेने के बाद अक्सर यह सघन महसूस होता है";
"algs.info.cmll.size.b4" = "Roux में सबसे महत्वपूर्ण औपचारिक एल्गोरिदम मील के पत्थर में से एक";
"algs.info.cmll.insights.p1" = "CMLL व्यावहारिक है क्योंकि यह Roux को CFOP-जैसी अंतिम-परत संरचना में विधि को मजबूर किए बिना एक साफ और दोहराने योग्य एक-चरण कोने वाला फिनिश देता है।";
"algs.info.cmll.insights.p2" = "कई सॉल्वर्स पाते हैं कि एक बार जब वे इसके मजबूत पारिवारिक पैटर्न को पहचान लेते हैं तो CMLL अधिक प्रबंधनीय हो जाता है। सेट बड़ा है, लेकिन उन परिवारों को समझने के बाद मामले उतने ही स्वतंत्र महसूस नहीं होते हैं।";
"algs.info.cmll.insights.p3" = "यह यह भी दिखाता है कि Roux अपेक्षाकृत कम अंतिम-परत फैलाव के साथ कुशल क्यों रह सकता है: कोनों को सफाई से हल करें, फिर अंतिम किनारे वाले चरण को बाकी काम करने दें।";
"algs.info.cmll.recognition.p1" = "CMLL को दो Roux ब्लॉकों के निर्माण के बाद अंतिम परत के कोने के पैटर्न से पहचाना जाता है। व्यवहार में, कई सॉल्वर केस को जल्दी से लॉक करने के लिए शीर्ष-चेहरे के कोने के आकार के साथ-साथ थोड़ी मात्रा में साइड जानकारी का उपयोग करते हैं।";
"algs.info.cmll.recommended.p1" = "किसी भी गंभीर Roux सॉल्वर के लिए अनुशंसित। कई वैकल्पिक उन्नत उपसमुच्चय की तुलना में, CMLL एक आला साइड प्रोजेक्ट की तुलना में कोर विधि मील के पत्थर के बहुत करीब है।";
"algs.info.cmll.quote.p1" = "\"CMLL शक्तिशाली लगता है क्योंकि यह Roux को एक बहुत ही अनुशासित मध्य अंत देता है: कोनों को निर्णायक रूप से समाप्त किया जाता है, और विधि सीधे अपने अंतिम किनारे के काम में प्रवाहित हो सकती है।\"";
"algs.info.4a.title" = "लगभग 4 बजे";
"algs.info.4a.subtitle" = "4ए की परिभाषा, इतिहास और दक्षता";
