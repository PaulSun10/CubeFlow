"algs.info.l3e.structure.b2" = "छोटा अंतिम-परत किनारा सेट";
"algs.info.l3e.structure.b3" = "आमतौर पर अधिकतर सुलझे हुए शरीर के बाद प्रकट होता है";
"algs.info.l3e.structure.b4" = "सेट आकार की तुलना में तेज़ पहचान और कम रिग्रिप निष्पादन अधिक महत्वपूर्ण हैं";
"algs.info.l3e.insights.p1" = "Pyraminx आगे देखने और तरलता को भारी रूप से बदलने का पुरस्कार देता है, इसलिए L3E को केवल पृथक सूत्रों के रूप में नहीं सीखा जाना चाहिए।";
"algs.info.l3e.insights.p2" = "मामले की छोटी गिनती इसे जल्दबाजी करने के लिए आकर्षक बनाती है, लेकिन वास्तविक लक्ष्य सही कोण चुनना और अंतिम चालों के माध्यम से TPS को संरक्षित करना है।";
"algs.info.l3e.insights.p3" = "L3E बड़े अंतिम-किनारे सिस्टम के लिए अंतर्ज्ञान बनाने में भी मदद करता है क्योंकि वही चक्र विचार फिर से प्रकट होते हैं।";
"algs.info.l3e.recognition.p1" = "पहचान इस पर आधारित है कि अंतिम परत के कौन से तीन किनारे अनसुलझे रहते हैं और उनके रंग शीर्ष के चारों ओर कैसे चक्रित होते हैं।";
"algs.info.l3e.recommended.p1" = "Pyraminx सॉल्वरों के लिए अनुशंसित जो एक बुनियादी विधि जानते हैं और एक क्लीनर अंतिम-परत फिनिश चाहते हैं।";
"algs.info.l3e.quote.p1" = "L3E छोटा है, लेकिन Pyraminx पर छोटे सेट यह तय कर सकते हैं कि सॉल्व सुचारू रूप से समाप्त होता है या रुक जाता है।";
"algs.info.l4e.title" = "Pyraminx L4E के बारे में";
"algs.info.l4e.subtitle" = "वी-प्रथम शैली में अंतिम चार किनारों को Pyraminx हल करना";
"algs.info.l4e.overview.p1" = "**Pyraminx L4E** अंतिम चार किनारों को हल करता है, जो आमतौर पर वी-प्रथम शैली समाधान से जुड़ा होता है जहां अंतिम चरण को चार-किनारों की समस्या में बदल दिया जाता है।";
"algs.info.l4e.context.p1" = "वी-प्रथम दृष्टिकोण पहले वी आकार बनाते हैं, फिर शेष किनारों को हल करते हैं। L4E एल्गोरिथम फिनिश है जो उस पद्धति को प्रतिस्पर्धी बनाता है।";
"algs.info.l4e.structure.b1" = "Pyraminx L4E में **37 मामले** हैं";
"algs.info.l4e.structure.b2" = "वी-प्रथम शैली विधियों के लिए कोर फ़िनिश";
"algs.info.l4e.structure.b3" = "L3E से बड़ा और अधिक उन्नत";
"algs.info.l4e.structure.b4" = "मजबूत निरीक्षण योजना के साथ जोड़े जाने पर यह सबसे मूल्यवान है";
"algs.info.l4e.insights.p1" = "L4E शक्तिशाली है क्योंकि यह पहले वाले समाधान को एक स्वच्छ V के आसपास नियोजित करने देता है, फिर शेष किनारों को एक संरचित चरण में समाप्त करता है।";
"algs.info.l4e.insights.p2" = "सीखने का भार बुनियादी Pyraminx अंतिम परतों से बड़ा है, इसलिए मान्यता परिवार मायने रखते हैं। मामलों को डिस्कनेक्ट की गई तस्वीरों के बजाय किनारे चक्र और स्वैप के रूप में मानें।";
"algs.info.l4e.insights.p3" = "अच्छे L4E अभ्यास में वास्तविक वी-प्रथम समाधान से शुरुआत शामिल होनी चाहिए, क्योंकि मामले में संक्रमण विधि का हिस्सा है।";
"algs.info.l4e.recognition.p1" = "V बनने के बाद मान्यता शेष चार किनारों की स्थिति और झुकाव को पढ़ती है।";
"algs.info.l4e.recommended.p1" = "Pyraminx सॉल्वरों के लिए अनुशंसित जो बुनियादी तरीकों के स्थिर होने के बाद वी-फर्स्ट या अधिक उन्नत लास्ट-एज सिस्टम का पता लगाना चाहते हैं।";
"algs.info.l4e.quote.p1" = "L4E एक छोटे शुरुआती पहेली से Pyraminx को एक तेज एल्गोरिथम फिनिश के साथ एक योजना पहेली में बदल देता है।";
"algs.info.sarahsadvanced.title" = "Sarah's उन्नत के बारे में";
"algs.info.sarahsadvanced.subtitle" = "उन्नत Skewb Sarah's विधि में समाप्त करें";
"algs.info.sarahsadvanced.overview.p1" = "**Sarah's उन्नत** Skewb के लिए Sarah's विधि का उन्नत संस्करण है। पहली परत को हल करने के बाद, यह शेष कोनों और केंद्रों को एक साथ हल करता है।";
"algs.info.sarahsadvanced.context.p1" = "Sarah स्ट्रॉन्ग द्वारा आविष्कृत Sarah's विधि को व्यापक रूप से Skewb के लिए मुख्य गति-समाधान विधि माना जाता है। उन्नत विविधता को L2L-स्टाइल फ़िनिश के रूप में भी जाना जाता है।";
"algs.info.sarahsadvanced.structure.b1" = "Sarah's एडवांस्ड के पास इस लाइब्रेरी संरचना में **131 मामले** हैं";
"algs.info.sarahsadvanced.structure.b2" = "पहली परत हल होने के बाद शुरू होती है";
"algs.info.sarahsadvanced.structure.b3" = "शेष कोने और केंद्र समाधान को जोड़ता है";
"algs.info.sarahsadvanced.structure.b4" = "बड़ा सेट; चयनात्मक शिक्षा व्यावहारिक है";
"algs.info.sarahsadvanced.insights.p1" = "Skewb टर्न-लाइट है लेकिन पहचान-भारी है। Sarah's एडवांस्ड अधिक समाधानों को एक अंतिम चरण में ले जाता है, जिससे मामलों की संख्या तेजी से बढ़ जाती है।";
"algs.info.sarahsadvanced.insights.p2" = "विधि शक्तिशाली है क्योंकि Skewb की संरचना मामले के ज्ञात होने पर बहुत ही कम समय में समाप्त करने की अनुमति देती है। चुनौती मामले को बिना ज्यादा घुमाए देखने की है।";
"algs.info.sarahsadvanced.insights.p3" = "एक व्यावहारिक रास्ता यह है कि पहले सामान्य या एर्गोनोमिक मामलों को सीखें, फिर जैसे-जैसे आपकी प्रथम-स्तरीय योजना अधिक सुसंगत होती जाए, उसका विस्तार करें।";
"algs.info.sarahsadvanced.recognition.p1" = "पहली परत के बाद पहचान शुरू होती है: शेष कोने के पैटर्न और केंद्र की स्थिति को एक साथ पढ़ें, क्योंकि उन्नत फिनिश दोनों को हल करती है।";
"algs.info.sarahsadvanced.recommended.p1" = "Skewb सॉल्वरों के लिए अनुशंसित जो पहले से ही Sarah's शुरुआती या इंटरमीडिएट जानते हैं और एक गहरी, तेज़ फिनिशिंग प्रणाली चाहते हैं।";
"algs.info.sarahsadvanced.quote.p1" = "Sarah's एडवांस्ड गहराई तक जाने का Skewb का संस्करण है: कम कदम, पहचानने में अधिक जिम्मेदारी।";
