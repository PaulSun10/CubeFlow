"algs.info.megaminxcp.context.p1" = "CP Megaminx 4LLL का चौथा चरण है। कुछ सॉल्वर सभी मामलों को सीखते हैं, जबकि अन्य कम्यूटेटर या छोटे व्यावहारिक उपसमुच्चय का उपयोग करते हैं।";
"algs.info.megaminxcp.structure.b1" = "Megaminx CP में **15 मामले** हैं";
"algs.info.megaminxcp.structure.b2" = "Megaminx 4LLL का अंतिम चरण";
"algs.info.megaminxcp.structure.b3" = "किनारों को हल करने के बाद कोनों को क्रमबद्ध करता है";
"algs.info.megaminxcp.structure.b4" = "इसे पूरी तरह से सीखा जा सकता है या कम्यूटेटर के साथ पूरक किया जा सकता है";
"algs.info.megaminxcp.insights.p1" = "CP अक्सर ऐसा होता है जहां Megaminx समाधान अपने अंतिम प्रवाह को खो देते हैं। पहेली लगभग पूरी हो चुकी है, लेकिन पाँच-कोने की पहचान अभी भी धीमी हो सकती है।";
"algs.info.megaminxcp.insights.p2" = "परिवारों के रूप में CP सीखना बहुत मदद करता है। आप बार-बार घूमने के बजाय सुलझे हुए कोनों, आसन्न रिश्तों और चक्रों को तेजी से देखना चाहते हैं।";
"algs.info.megaminxcp.insights.p3" = "आकस्मिक सॉल्वरों के लिए, कम्यूटेटर फ़ॉलबैक स्वीकार्य है। गति के लिए, एक विश्वसनीय CP सेट फिनिश को और अधिक निर्णायक महसूस कराता है।";
"algs.info.megaminxcp.recognition.p1" = "पहचान इस पर आधारित है कि कौन से कोने पहले से ही अपनी जगह पर हैं और शेष कोने अंतिम परत के चारों ओर कैसे चक्र करते हैं।";
"algs.info.megaminxcp.recommended.p1" = "Megaminx सॉल्वरों के लिए अनुशंसित जो पहले से ही EO, CO, और EP जानते हैं और एक क्लीनर 4LLL फिनिश चाहते हैं।";
"algs.info.megaminxcp.quote.p1" = "Megaminx CP अंतिम हैंडशेक है: अंतिम परत उन्मुख और किनारा है, लेकिन कोनों को अभी भी सहमत होने की आवश्यकता है।";
