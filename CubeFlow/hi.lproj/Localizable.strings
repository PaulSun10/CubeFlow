"algs.info.ollcp.section.quote" = "उद्धरण";
"algs.info.ollcp.overview.p1" = "**OLLCP** **अंतिम परत के अभिविन्यास** और **कोने के क्रमपरिवर्तन** दोनों को एक चरण में हल करके OLL का विस्तार करता है। COLL की तरह, यह एक **EPLL** फिनिश छोड़ता है, लेकिन यह केवल किनारे-उन्मुख राज्यों के बजाय OLL राज्यों के व्यापक परिवार से शुरू होता है।";
"algs.info.ollcp.history.p1" = "OLLCP स्पीडक्यूबर्स से विकसित हुआ, यह देखते हुए कि कई OLL एल्गोरिदम भी कोने के क्रमपरिवर्तन को नियंत्रित करते हैं। समय के साथ, इन मामलों को एक बड़े संरचित सेट में सूचीबद्ध किया गया, जिसमें **COLL** और **CLL-जैसे किनारे-उन्मुख परिवार** जैसे उपसमूहों को अक्सर विशेष रूप से सीखने योग्य प्रवेश बिंदु के रूप में माना जाता है।";
"algs.info.ollcp.size.b1" = "आमतौर पर कुल मिलाकर **331 एल्गोरिदम** के रूप में गिना जाता है";
"algs.info.ollcp.size.b2" = "जब किनारे पहले से ही उन्मुख हों तो **COLL** को एक महत्वपूर्ण उपसमुच्चय के रूप में शामिल करता है";
"algs.info.ollcp.size.b3" = "OLLCP चरण के बाद केवल **EPLL** छोड़ता है";
"algs.info.ollcp.size.b4" = "आमतौर पर पूर्ण-एक-एक सेट के बजाय चयनात्मक रूप से सीखा जाता है";
"algs.info.ollcp.insights.p1" = "OLLCP एक दिलचस्प जगह पर बैठता है: COLL से बड़ा, लेकिन फिर भी ZBLL से बहुत छोटा। यह इसे उन सॉल्वरों के लिए आकर्षक बनाता है जो सबसे बड़े वन-लुक परिवारों के लिए प्रतिबद्ध हुए बिना बेहतर अंतिम-परत दक्षता चाहते हैं।";
"algs.info.ollcp.insights.p2" = "व्यवहार में, कई क्यूबर्स पहले पूर्ण OLLCP का लक्ष्य नहीं रखते हैं। वे मजबूत एर्गोनॉमिक्स, उपयोगी स्किप्स या परिचित पहचान वाले उपसमुच्चय चुनते हैं और बाकी को दीर्घकालिक परियोजना के रूप में मानते हैं।";
"algs.info.ollcp.insights.p3" = "OLLCP अंतिम-परत सिद्धांत के विभिन्न भागों को जोड़ने में भी मदद करता है। एक बार जब आप ओरिएंटेशन और कॉर्नर क्रमपरिवर्तन के बारे में एक साथ सोचना शुरू करते हैं, तो COLL, ZBLL और उन्नत अंतिम-स्लॉट सिस्टम जैसे सेट एक-दूसरे से संबंधित होना आसान हो जाते हैं।";
"algs.info.ollcp.recognition.p1" = "OLLCP को **OLL आकार** की पहचान करके और फिर इसके साथ आने वाले **कोने के क्रमपरिवर्तन** को निर्धारित करके पहचाना जाता है। सादे OLL की तुलना में, अतिरिक्त मान्यता बोझ ईपीएलएल के अंतिम क्रमपरिवर्तन चरण को कम करने के लिए भुगतान की गई कीमत है।";
"algs.info.ollcp.recommended.p1" = "उन्नत सॉल्वरों के लिए अनुशंसित जो पहले से ही **पूर्ण PLL** और पर्याप्त मात्रा में **OLL** जानते हैं, और जो मानक अंतिम-परत समाधान और बहुत बड़े वन-लुक सिस्टम के बीच अधिक यथार्थवादी कदम चाहते हैं।";
"algs.info.ollcp.quote.p1" = "\"OLLCP आकर्षक है क्योंकि यह परिचित OLL ढांचे को बरकरार रखता है, लेकिन एक बेहतर सवाल पूछता है: क्या यही पहचान मुफ्त में कोनों को भी हल कर सकती है?\"";
"algs.info.vls.title" = "VLS के बारे में";
"algs.info.vls.subtitle" = "VLS की परिभाषा, इतिहास और दक्षता";
"algs.info.vls.section.overview" = "सिंहावलोकन";
"algs.info.vls.section.history" = "इतिहास";
"algs.info.vls.section.size" = "आकार एवं दक्षता";
"algs.info.vls.section.insights" = "अंतर्दृष्टि";
"algs.info.vls.section.recognition" = "मान्यता";
"algs.info.vls.section.recommended" = "के लिए अनुशंसित";
"algs.info.vls.section.quote" = "उद्धरण";
"algs.info.vls.overview.p1" = "**VLS**, **वॉक लास्ट स्लॉट** का संक्षिप्त रूप, अंतिम F2L जोड़ी को इस तरह हल करता है कि अंतिम परत भी उन्मुख हो जाती है। जब यह काम करता है, तो यह सादे OLL को छोड़ देता है और सीधे PLL या किसी अन्य कम अंतिम-परत फिनिश में प्रवाहित होता है।";
"algs.info.vls.history.p1" = "VLS में सबसे प्रसिद्ध द्वार **विंटर वेरिएशन** है, जिसे 2005 में **लुकास विंटर** द्वारा प्रकाशित किया गया था। बाद में **मैट्स वाल्क**, **रोवे हेसलर** और अन्य जैसे सॉल्वरों द्वारा किए गए काम ने उस विचार को आज इस्तेमाल होने वाले व्यापक VLS परिवार में विस्तारित किया।";
"algs.info.vls.size.b1" = "अक्सर दर्पण के साथ **432 एल्गोरिदम**, या दर्पण के बिना **216 कोर केस** के रूप में गिना जाता है";
"algs.info.vls.size.b2" = "अंतिम-स्लॉट स्थिति पर निर्मित जहां लक्ष्य जोड़ी पहले ही बन चुकी है";
"algs.info.vls.size.b3" = "अंतिम परत को उन्मुख करते हुए अंतिम स्लॉट को हल करने के लिए डिज़ाइन किया गया है";
"algs.info.vls.size.b4" = "आम तौर पर **विंटर वेरिएशन** से शुरू करके सीखा जाता है, फिर उपसमुच्चय द्वारा उपसमुच्चय का विस्तार किया जाता है";
"algs.info.vls.insights.p1" = "VLS उच्च-मूल्य वाले उन्नत उपसमुच्चय के सबसे स्पष्ट उदाहरणों में से एक है: यह अंतिम स्लॉट पर हमला करता है, जो पहले से ही समाधान में एक प्रमुख मोड़ है, और इसे छोटी अंतिम परत की ओर एक पुल में बदल देता है।";
"algs.info.vls.insights.p2" = "अधिकांश सॉल्वर VLS को एक विशाल सेट के रूप में नहीं देखते हैं। वे सबसे आसान या सबसे अधिक बार दिखने वाले उपसमुच्चय से शुरू करते हैं, अक्सर विंटर वेरिएशन के माध्यम से, और बाद में ही तय करते हैं कि बड़ा परिवार गहन अध्ययन के लायक है या नहीं।";
"algs.info.vls.insights.p3" = "क्योंकि VLS अंतिम-स्लॉट निर्णय लेने के अंदर रहता है, इसकी व्यावहारिक ताकत काफी हद तक पहचान की गति पर निर्भर करती है। सैद्धांतिक रूप से शक्तिशाली केस केवल तभी उपयोगी होता है जब सॉल्वर F2L प्रवाह को नष्ट किए बिना इसका पता लगा सके।";
"algs.info.vls.recognition.p1" = "VLS को शेष अंतिम-परत किनारों और कोनों की अभिविन्यास स्थिति के साथ युग्मित अंतिम-स्लॉट टुकड़ों को देखकर पहचाना जाता है। कुशल पहचान स्लॉट पैटर्न और अंतिम-परत अभिविन्यास दोनों को एक साथ देखने पर निर्भर करती है।";
"algs.info.vls.recommended.p1" = "उन्नत **CFOP** सॉल्वरों के लिए अनुशंसित जिनके पास पहले से ही स्थिर F2L है और वे अंतिम स्लॉट से अंतिम-परत चरणों को कम करना चाहते हैं। यह उन क्यूबर्स के लिए विशेष रूप से आकर्षक है जो अंतिम-स्लॉट उपसमुच्चय जैसे **WV**, **ZBLS** और संबंधित सिस्टम का आनंद लेते हैं।";
"algs.info.vls.quote.p1" = "\"VLS शक्तिशाली है क्योंकि यह एक अलग अंतिम-परत चमत्कार की मांग नहीं करता है। यह पूछता है कि क्या अंतिम जोड़ी चुपचाप तेजी से खत्म कर सकती है।\"";
"algs.info.wv.title" = "WV के बारे में";
"algs.info.wv.subtitle" = "WV की परिभाषा, इतिहास और दक्षता";
"algs.info.wv.section.overview" = "सिंहावलोकन";
"algs.info.wv.section.history" = "इतिहास";
"algs.info.wv.section.size" = "आकार एवं दक्षता";
"algs.info.wv.section.insights" = "अंतर्दृष्टि";
"algs.info.wv.section.recognition" = "मान्यता";
"algs.info.wv.section.recommended" = "के लिए अनुशंसित";
"algs.info.wv.section.quote" = "उद्धरण";
"algs.info.wv.overview.p1" = "**WV**, **विंटर वेरिएशन** का संक्षिप्त रूप, अंतिम F2L जोड़ी को हल करता है, साथ ही उन मामलों में अंतिम परत को उन्मुख करता है जहां अंतिम परत के किनारे पहले से ही उन्मुख होते हैं। व्यवहार में, यह उन्नत अंतिम-स्लॉट सिद्धांत में सबसे अधिक पहुंच योग्य प्रवेश द्वारों में से एक है।";
"algs.info.wv.history.p1" = "विंटर वेरिएशन को **लुकास विंटर** द्वारा 2005 में प्रकाशित किया गया था और यह जल्द ही सबसे प्रसिद्ध उन्नत लास्ट-स्लॉट उपसमुच्चय में से एक बन गया। इसे अब व्यापक रूप से सामान्य F2L से बड़े सिस्टम जैसे **VLS** और **ZBLS** में पहला कदम माना जाता है।";
"algs.info.wv.size.b1" = "आमतौर पर **27 एल्गोरिदम** के रूप में गिना जाता है";
"algs.info.wv.size.b2" = "यह तब लागू होता है जब अंतिम जोड़ी उपलब्ध हो और **अंतिम परत के किनारे पहले से ही उन्मुख हों**";
"algs.info.wv.size.b3" = "स्लॉट को ख़त्म करके और अंतिम परत को एक साथ उन्मुख करके सादा OLL छोड़ देता है";
"algs.info.wv.size.b4" = "अक्सर बड़े अंतिम-स्लॉट परिवारों से पहले सीखा जाता है क्योंकि सेट कॉम्पैक्ट और व्यावहारिक होता है";
"algs.info.wv.insights.p1" = "WV आकर्षक है क्योंकि यह एक विशाल एल्गोरिदम प्रतिबद्धता की मांग किए बिना स्पष्ट दक्षता लाभ प्रदान करता है। कई CFOP सॉल्वरों के लिए, यह पहला उन्नत उपसमुच्चय है जो सीखने योग्य और तुरंत उपयोगी दोनों लगता है।";
"algs.info.wv.insights.p2" = "सेट एक महत्वपूर्ण वैचारिक बदलाव भी सिखाता है: अंतिम स्लॉट न केवल सफाई से खत्म करने के लिए कुछ है, बल्कि शुरू होने से पहले आखिरी परत को आकार देने का अवसर भी है।";
"algs.info.wv.insights.p3" = "अपने आकार और व्यावहारिक लाभ के कारण, WV अक्सर प्रवेश द्वार के रूप में कार्य करता है। जो सॉल्वर इसका आनंद लेते हैं वे बार-बार **VLS**, **ZBLS**, या अन्य एज-ओरिएंटेशन-जागरूक अंतिम-स्लॉट सिस्टम का पता लगाने के लिए आगे बढ़ते हैं।";
"algs.info.wv.recognition.p1" = "WV को अंतिम जोड़ी को देखकर और यह पुष्टि करके पहचाना जाता है कि अंतिम परत के किनारे पहले से ही उन्मुख हैं। वहां से, जोड़ी संरचना और सम्मिलन दिशा सटीक मामला निर्धारित करती है।";
"algs.info.wv.recommended.p1" = "स्थिर F2L वाले क्यूबर्स के लिए अनुशंसित जो अपना पहला गंभीर अंतिम-स्लॉट उपसमुच्चय चाहते हैं। यह विशेष रूप से CFOP सॉल्वरों के लिए अच्छा है जो सॉल्व के दौरान पहले से ही किनारे के ओरिएंटेशन को नोटिस करते हैं और अंतिम परत में अधिक कुशल बदलाव चाहते हैं।";
"algs.info.wv.quote.p1" = "\"विंटर वेरिएशन अक्सर पहला क्षण होता है जब एक सॉल्वर को पता चलता है कि अंतिम स्लॉट फिनिश F2L से अधिक कर सकता है - यह पूरी आखिरी परत को भी चुपचाप सरल बना सकता है।\"";
"algs.info.sv.title" = "एसवी के बारे में";
"algs.info.sv.subtitle" = "एसवी की परिभाषा, इतिहास और दक्षता";
"algs.info.sv.section.overview" = "सिंहावलोकन";
"algs.info.sv.section.history" = "इतिहास";
"algs.info.sv.section.size" = "आकार एवं दक्षता";
"algs.info.sv.section.insights" = "अंतर्दृष्टि";
"algs.info.sv.section.recognition" = "मान्यता";
"algs.info.sv.section.recommended" = "के लिए अनुशंसित";
"algs.info.sv.section.quote" = "उद्धरण";
"algs.info.sv.overview.p1" = "**एसवी**, जिसे आमतौर पर **समर वेरिएशन** कहा जाता है, WV-शैली के विचारों से संबंधित एक छोटा उन्नत अंतिम-स्लॉट परिवार है। यह चयनित अंतिम-स्लॉट मामलों पर ध्यान केंद्रित करता है जहां एक विशेष सम्मिलन अंतिम परत में एक क्लीनर या अधिक कुशल संक्रमण देता है।";
"algs.info.sv.history.p1" = "WV के विपरीत, एसवी को एकल ऐतिहासिक मील के पत्थर के रूप में कम और उन्नत अंतिम-स्लॉट तकनीकों की एक केंद्रित शाखा के लिए सामुदायिक लेबल के रूप में अधिक जाना जाता है। यह स्वाभाविक रूप से विकसित हुआ क्योंकि क्यूबर्स कुशल अंतिम-स्लॉट आवेषण के पीछे तर्क का विस्तार करते रहे।";
"algs.info.sv.size.b1" = "आमतौर पर इसे एक **केंद्रित उपसमुच्चय** के रूप में माना जाता है, न कि एक विशाल स्टैंडअलोन प्रणाली के रूप में";
"algs.info.sv.size.b2" = "**VLS** जैसे व्यापक परिवारों की तुलना में छोटे और अधिक चयनात्मक";
"algs.info.sv.size.b3" = "सबसे उपयोगी तब होता है जब एक सॉल्वर पहले से ही अंतिम-स्लॉट संरचना को आराम से पहचान लेता है";
"algs.info.sv.size.b4" = "अक्सर एक औपचारिक ऑल-एट-वन प्रोजेक्ट के बजाय केस-दर-केस सीखा जाता है";
"algs.info.sv.insights.p1" = "एसवी को एक सार्वभौमिक मील का पत्थर सेट के बजाय उन्नत अंतिम-स्लॉट सोच के व्यावहारिक विस्तार के रूप में समझा जाता है। इसका मूल्य उन मामलों को चुनने से आता है जहां भुगतान स्पष्ट है और मान्यता का बोझ प्रबंधनीय रहता है।";
"algs.info.sv.insights.p2" = "क्योंकि लेबल का उपयोग PLL या OLL जैसे सेटों की तुलना में थोड़ा अधिक शिथिल रूप से किया जाता है, सॉल्वर अक्सर एकल विहित शिक्षण पथ के बजाय क्यूरेटेड केस संग्रह के माध्यम से एसवी का सामना करते हैं।";
"algs.info.sv.insights.p3" = "वह लचीलापन वास्तव में एक ताकत हो सकता है: यदि कुछ मामले स्वाभाविक रूप से आपके समाधानों में फिट होते हैं, तो एसवी एल्गोरिदम के एक बहुत बड़े निकाय के लिए आपसे प्रतिबद्ध होने की मांग किए बिना अंत में सुधार कर सकता है।";
"algs.info.sv.recognition.p1" = "एसवी पहचान अन्य अंतिम-स्लॉट उपसमुच्चय के समान व्यापक सामग्रियों पर निर्भर करती है: अंतिम जोड़ी संरचना, उपलब्ध प्रविष्टि दिशा, और अंतिम-परत स्थिति जिसे आप संरक्षित या सुधारना चाहते हैं।";
"algs.info.sv.recommended.p1" = "उन्नत सॉल्वरों के लिए अनुशंसित जो पहले से ही WV, VLS, या ZBLS-शैली की सोच का आनंद लेते हैं और सीधे किसी अन्य विशाल परिवार में शामिल हुए बिना कुछ अधिक कुशल अंतिम-स्लॉट विकल्प चाहते हैं।";
"algs.info.sv.quote.p1" = "\"समर वेरिएशन एक प्रसिद्ध निश्चित सेट को याद करने के बारे में कम और अंतिम-स्लॉट मामलों को इकट्ठा करने के बारे में अधिक है जिन्हें अनदेखा करना बहुत ही कुशल है।\"";
"algs.info.zbls.title" = "ZBLS के बारे में";
"algs.info.zbls.subtitle" = "ZBLS की परिभाषा, इतिहास और दक्षता";
"algs.info.zbls.section.overview" = "सिंहावलोकन";
"algs.info.zbls.section.history" = "इतिहास";
"algs.info.zbls.section.size" = "आकार एवं दक्षता";
"algs.info.zbls.section.insights" = "अंतर्दृष्टि";
"algs.info.zbls.section.recognition" = "मान्यता";
"algs.info.zbls.section.recommended" = "के लिए अनुशंसित";
"algs.info.zbls.section.quote" = "उद्धरण";
"algs.info.zbls.overview.p1" = "**ZBLS**, **ZB लास्ट स्लॉट** का संक्षिप्त रूप, अंतिम परत के किनारों को उन्मुख करते हुए अंतिम F2L जोड़ी को हल करता है। यह सामान्य CFOP F2L और अंतिम-परत दक्षता प्रणालियों के व्यापक **ZB** परिवार के बीच प्रमुख पुलों में से एक है।";
"algs.info.zbls.history.p1" = "ZBLS **Zbigniew Zborski** और **Ron van Bruchem** द्वारा विकसित बड़ी **ZB पद्धति** से विकसित हुआ। जैसे-जैसे विधि विकसित हुई, स्पीडक्यूबर्स ने अंतिम-स्लॉट भाग को अपने स्वयं के सीखने योग्य परिवार में व्यवस्थित किया, क्योंकि यह ZBLL को सीखे बिना भी व्यावहारिक दक्षता प्रदान करता था।";
"algs.info.zbls.size.b1" = "एक **बड़ा अंतिम-स्लॉट परिवार**, WV जैसे कॉम्पैक्ट सेट से कहीं बड़ा";
"algs.info.zbls.size.b2" = "अंतिम परत के लिए **EO पूर्ण** छोड़ते समय अंतिम स्लॉट को हल करने के आसपास बनाया गया";
"algs.info.zbls.size.b3" = "अंत के लिए एक आधार के रूप में कार्य करता है जो **ZBLL** या अन्य एक-दिखने वाले समापन तक जारी रहता है";
"algs.info.zbls.size.b4" = "आमतौर पर चयनात्मक तरीके से सीखा जाता है क्योंकि अधिकांश क्यूबर्स के लिए पूरा परिवार इतना बड़ा होता है कि एक बार में निपटना संभव नहीं होता";
"algs.info.zbls.insights.p1" = "ZBLS मायने रखता है क्योंकि यह अंतिम स्लॉट की भूमिका को बदल देता है। केवल F2L को समाप्त करने के बजाय, अंतिम सम्मिलन मान्यता शुरू होने से पहले एक अधिक मजबूत अंतिम-परत स्थिति स्थापित करने का मौका बन जाता है।";
"algs.info.zbls.insights.p2" = "व्यावहारिक रूप से, कई सॉल्वर ZBLS को एक बड़े प्रोजेक्ट के रूप में नहीं देखते हैं। वे सबसे एर्गोनोमिक या लगातार मामलों को पहले सीखते हैं, विशेष रूप से वे जो स्वाभाविक रूप से WV- या VLS-शैली पहचान से जुड़ते हैं।";
"algs.info.zbls.insights.p3" = "सिद्धांत-दिमाग वाले क्यूबर्स के लिए, ZBLS भी सबसे स्पष्ट विंडो में से एक है कि उन्नत तरीके कैसे जुड़ते हैं: F2L संरचना, किनारे का अभिविन्यास, और अंतिम-परत योजना सभी एक ही स्थान पर मिलते हैं।";
"algs.info.zbls.recognition.p1" = "ZBLS को वांछित किनारे-अभिविन्यास परिणाम के साथ अंतिम जोड़ी को पढ़कर पहचाना जाता है। सटीक मामला इस बात पर निर्भर करता है कि जोड़ी को कैसे व्यवस्थित किया गया है और कौन सा सम्मिलन आपके इच्छित किनारे की स्थिति को संरक्षित या बनाता है।";
"algs.info.zbls.recommended.p1" = "मजबूत F2L और अंतिम-स्लॉट सिस्टम में गंभीर रुचि वाले उन्नत CFOP सॉल्वर के लिए अनुशंसित। यह उन क्यूबर्स के लिए विशेष रूप से प्रासंगिक है जो पहले से ही WV का आनंद लेते हैं या व्यापक ZB पद्धति के व्यावहारिक पक्ष को समझना चाहते हैं।";
"algs.info.zbls.quote.p1" = "\"जेडबीएलएस वह जगह है जहां अंतिम स्लॉट सफाई कार्य बनना बंद कर देता है और अंतिम परत के लिए पूर्ण रणनीतिक सेटअप बनना शुरू कर देता है।\"";
"algs.info.1lll.title" = "1LLL के बारे में";
"algs.info.1lll.subtitle" = "1LLL की परिभाषा, इतिहास और दक्षता";
"algs.info.1lll.section.overview" = "सिंहावलोकन";
"algs.info.1lll.section.history" = "इतिहास";
"algs.info.1lll.section.size" = "आकार एवं दक्षता";
"algs.info.1lll.section.insights" = "अंतर्दृष्टि";
"algs.info.1lll.section.recognition" = "मान्यता";
"algs.info.1lll.section.recommended" = "के लिए अनुशंसित";
"algs.info.1lll.section.quote" = "उद्धरण";
"algs.info.1lll.overview.p1" = "**1LLL**, **वन-लुक लास्ट लेयर** का संक्षिप्त रूप, एक एकल निश्चित सेट नहीं है बल्कि एक व्यापक विचार है: कई अलग-अलग तैयार राज्यों से एक एल्गोरिदम में संपूर्ण अंतिम परत को हल करना। **ZBLL** जैसे परिवार इसके सबसे प्रसिद्ध संरचित उदाहरणों में से हैं।";
"algs.info.1lll.history.p1" = "वाक्यांश 1LLL एक सुविधाजनक सामुदायिक शॉर्टहैंड बन गया क्योंकि स्पीडक्यूबर्स ने तेजी से कुशल अंतिम-परत सिस्टम का आयोजन किया। किसी एक ऐतिहासिक पद्धति का नामकरण करने के बजाय, यह अंतिम परत को एकल मान्यता प्राप्त फिनिश में ढहाने के व्यापक लक्ष्य का वर्णन करता है।";
"algs.info.1lll.size.b1" = "**कोई एकल निश्चित एल्गोरिदम गिनती नहीं है**, क्योंकि 1LLL कई परिवारों पर एक छत्रछाया है";
"algs.info.1lll.size.b2" = "1LLL विचार के अंतर्गत जाने-माने उपसमूहों में **ZBLL** और अन्य किनारे-वातानुकूलित वन-लुक सिस्टम शामिल हैं";
"algs.info.1lll.size.b3" = "कुल स्थान बहुत बड़ा है, इसलिए अधिकांश क्यूबर्स केवल चयनित परिवारों को ही सीखते हैं";
"algs.info.1lll.size.b4" = "इसकी दक्षता सीमा बेहद ऊंची है, लेकिन स्पीडक्यूबिंग में सीखने का बोझ भी सबसे भारी है";
"algs.info.1lll.insights.p1" = "1LLL को एक अवधारणा के रूप में सबसे अच्छा माना जाता है, न कि एक सामान्य मील का पत्थर सेट के रूप में। यह पूरी तरह से संपीड़ित अंतिम परत के विचार का प्रतिनिधित्व करता है, लेकिन व्यवहार में यह कई छोटी प्रणालियों में टूट जाता है, प्रत्येक की अपनी पहचान और पूर्वापेक्षाएँ होती हैं।";
"algs.info.1lll.insights.p2" = "यही कारण है कि लगभग कोई भी शाब्दिक अर्थ में \"पूर्ण 1LLL\" नहीं सीख पाता है। इसके बजाय, सॉल्वर संरचित उपसमुच्चय चुनते हैं जो उनकी पद्धति, पहचान की आदतों और याद रखने की भूख के अनुकूल होते हैं।";
"algs.info.1lll.insights.p3" = "फिर भी, 1LLL शब्दों में सोचना उपयोगी हो सकता है। यह समझाने में मदद करता है कि COLL, OLLCP, और ZBLL जैसे सेट संबंधित क्यों लगते हैं: वे सभी अंतिम परत को कम और कम सार्थक निर्णयों में सिकोड़ने के एक ही लक्ष्य की ओर बढ़ते हैं।";
"algs.info.1lll.recognition.p1" = "1LLL में मान्यता पूरी तरह से उपयोग किए जा रहे उपसमुच्चय पर निर्भर करती है। कुछ परिवार उन्मुख किनारों से शुरू होते हैं, कुछ अंतिम-स्लॉट स्थितियों से, और कुछ व्यापक OLL-शैली पैटर्न और अतिरिक्त क्रमपरिवर्तन विवरण से शुरू होते हैं।";
"algs.info.1lll.recommended.p1" = "सिद्धांत-दिमाग वाले उन्नत सॉल्वरों के लिए अनुशंसित, जो पहले से ही मुख्य अंतिम-परत परिवारों को समझते हैं और यह देखना चाहते हैं कि वे सिस्टम छोटे व्यावहारिक अगले सेट की तलाश करने वाले किसी भी व्यक्ति के बजाय बड़े वन-लुक ढांचे में कैसे फिट होते हैं।";
"algs.info.1lll.quote.p1" = "\"1LLL एक सेट कम है जिसे आप सीखना समाप्त करते हैं और एक क्षितिज अधिक है जो बताता है कि इतने सारे उन्नत अंतिम-परत सिस्टम एक ही विचार की ओर क्यों बढ़ते रहते हैं: सब कुछ एक ही बार में हल करें।\"";
"algs.info.advancedf2l.title" = "उन्नत के बारे में F2L";
"algs.info.advancedf2l.subtitle" = "उन्नत F2L की परिभाषा, इतिहास और दक्षता";
"algs.info.advancedf2l.section.overview" = "सिंहावलोकन";
"algs.info.advancedf2l.section.history" = "इतिहास";
"algs.info.advancedf2l.section.size" = "आकार एवं दक्षता";
"algs.info.advancedf2l.section.insights" = "अंतर्दृष्टि";
"algs.info.advancedf2l.section.recognition" = "मान्यता";
"algs.info.advancedf2l.section.recommended" = "के लिए अनुशंसित";
"algs.info.advancedf2l.section.quote" = "उद्धरण";
"algs.info.advancedf2l.overview.p1" = "**उन्नत F2L** बुनियादी सहज युग्मन से परे F2L के अधिक संरचित पक्ष को संदर्भित करता है। यह आम तौर पर अजीब जोड़ी स्थितियों, उच्च दक्षता वाले आवेषण और अंतिम-स्लॉट मामलों पर ध्यान केंद्रित करता है जहां एक अधिक औपचारिक एल्गोरिदम प्रवाह को संरक्षित कर सकता है या चाल गिनती को कम कर सकता है।";
"algs.info.advancedf2l.history.p1" = "जैसे-जैसे CFOP परिपक्व हुआ, क्यूबर्स ने धीरे-धीरे अजीब F2L मामलों को सूचीबद्ध किया जो शुद्ध अंतर्ज्ञान के बजाय निश्चित एल्गोरिदम के साथ हल करने लायक थे। समय के साथ, ये संग्रह सहज ज्ञान युक्त F2L और बड़े अंतिम-स्लॉट सिस्टम के बीच एक व्यावहारिक मध्य मैदान बन गए।";
"algs.info.advancedf2l.size.b1" = "अक्सर एक **केस संग्रह** के रूप में व्यवस्थित किया जाता है, न कि एक कठोर सार्वभौमिक सेट के रूप में";
"algs.info.advancedf2l.size.b2" = "आमतौर पर अजीब आवेषण, विशेष जोड़ी स्थिति और कुशल अंतिम-स्लॉट स्थितियों पर ध्यान केंद्रित किया जाता है";
"algs.info.advancedf2l.size.b3" = "लक्ष्य केवल कम चालें ही नहीं है, बल्कि बेहतर **आगे की ओर देखना** और स्वच्छ मोड़ भी है";
"algs.info.advancedf2l.size.b4" = "सहज F2L और **WV**, **VLS**, या **CLS** जैसे उपसमुच्चय के बीच एक पुल के रूप में कार्य करता है";
"algs.info.advancedf2l.insights.p1" = "उन्नत F2L मायने रखता है क्योंकि हर जोड़ी तुरंत ही हल करने लायक नहीं है। कुछ मामले इतने अजीब होते हैं कि एक स्थिर एल्गोरिदम चाल और सोचने का समय दोनों बचाता है।";
"algs.info.advancedf2l.insights.p2" = "पूर्ण अंतिम-परत सेट के विपरीत, उन्नत F2L आमतौर पर अवसरवादी रूप से सीखा जाता है। सॉल्वर एक-एक करके मामले जोड़ते हैं क्योंकि वे देखते हैं कि कौन से पैटर्न बार-बार उनके प्रवाह को बाधित करते हैं।";
"algs.info.advancedf2l.insights.p3" = "यह सेट को विशेष रूप से व्यावहारिक बनाता है: यह सामान्य समाधानों को तुरंत मजबूत करता है जबकि अधिक औपचारिक अंतिम-स्लॉट सिस्टम के लिए आवश्यक पैटर्न जागरूकता भी तैयार करता है।";
"algs.info.advancedf2l.recognition.p1" = "एडवांस्ड F2L में पहचान का अर्थ है कोने, किनारे और ओपन-स्लॉट संबंध को इतनी जल्दी पढ़ना कि यह तय किया जा सके कि मामला सहज रूप से हल किया गया है या ज्ञात उच्च दक्षता वाले इंसर्ट के साथ।";
"algs.info.advancedf2l.recommended.p1" = "उन क्यूबर्स के लिए अनुशंसित, जिनके पास पहले से ही स्थिर सहज ज्ञान युक्त F2L है और बहुत बड़े उन्नत सिस्टम के लिए प्रतिबद्ध होने से पहले बार-बार आने वाली बाधाओं को दूर करना चाहते हैं।";
"algs.info.advancedf2l.quote.p1" = "\"उन्नत F2L वह जगह है जहां अंतर्ज्ञान अस्पष्ट होना बंद हो जाता है और संरचित होना शुरू हो जाता है: आप अभी भी स्लॉट को समझते हैं, लेकिन आप यह भी जानते हैं कि कौन से अजीब मामले बेहतर उत्तर के लायक हैं।\"";
"algs.info.cls.title" = "CLS के बारे में";
"algs.info.cls.subtitle" = "CLS की परिभाषा, इतिहास और दक्षता";
"algs.info.cls.section.overview" = "सिंहावलोकन";
"algs.info.cls.section.history" = "इतिहास";
"algs.info.cls.section.size" = "आकार एवं दक्षता";
"algs.info.cls.section.insights" = "अंतर्दृष्टि";
"algs.info.cls.section.recognition" = "मान्यता";
"algs.info.cls.section.recommended" = "के लिए अनुशंसित";
"algs.info.cls.section.quote" = "उद्धरण";
"algs.info.cls.overview.p1" = "**CLS**, **अंतिम स्लॉट के कोनों** का संक्षिप्त रूप, अंतिम परत के कोनों को भी हल करते हुए अंतिम F2L जोड़ी को हल करता है। यह WV की तुलना में अधिक महत्वाकांक्षी अंतिम-स्लॉट परिवार है, क्योंकि भुगतान न केवल अभिविन्यास नियंत्रण है, बल्कि शेष अंतिम परत की बहुत मजबूत कमी है।";
"algs.info.cls.history.p1" = "CLS अधिक काम को अंतिम स्लॉट में धकेलने के व्यापक प्रयास से उभरा। जैसे ही क्यूबर्स ने पता लगाया कि अंतिम-स्लॉट आवेषण कोनों के साथ-साथ अभिविन्यास को कैसे प्रभावित कर सकता है, CLS उस उन्नत परिवार वृक्ष में पहचानने योग्य शाखाओं में से एक बन गया।";
"algs.info.cls.size.b1" = "एक **बड़ा अंतिम-स्लॉट परिवार**, WV जैसे कॉम्पैक्ट गेटवे सेट से भी बड़ा";
"algs.info.cls.size.b2" = "अंतिम परत के कोने की संरचना को हल करते हुए अंतिम जोड़ी को हल करने के आसपास बनाया गया";
"algs.info.cls.size.b3" = "बहुत कम शेष कार्य के साथ सीधे कम अंतिम-परत फिनिश की ओर ले जा सकता है";
"algs.info.cls.size.b4" = "आमतौर पर एकल-एक-बार परियोजना के बजाय चयनात्मक रूप से सीखा जाता है";
"algs.info.cls.insights.p1" = "CLS आकर्षक है क्योंकि यह अंतिम स्लॉट को सेटअप से परे और वास्तविक अंतिम-परत समाधान में धकेलता है। यह इसे वैचारिक रूप से शक्तिशाली बनाता है, भले ही अधिकांश सॉल्वरों के लिए सीखने का पूरा भार बहुत बड़ा हो।";
"algs.info.cls.insights.p2" = "व्यवहार में, कई सॉल्वर CLS को पूर्ण याद रखने के लक्ष्य के बजाय उच्च-मूल्य वाले मामलों के परिवार के रूप में मानते हैं। सबसे अच्छे मामले वे हैं जिनकी पहचान और एर्गोनॉमिक्स वास्तविक समाधानों में प्रबंधनीय रहते हैं।";
"algs.info.cls.insights.p3" = "CLS का अध्ययन करने से क्यूबिंग सिद्धांत का अधिक जुड़ा हुआ दृश्य बनाने में भी मदद मिलती है: स्लॉट संरचना, कोने पर नियंत्रण, और अंतिम-परत संपीड़न सभी एक निरंतर निर्णय का हिस्सा बन जाते हैं।";
"algs.info.cls.recognition.p1" = "CLS पहचान अंतिम जोड़ी को उस कोने की स्थिति के साथ पढ़ने पर निर्भर करती है जिसे आप संरक्षित करना या हल करना चाहते हैं। WV-शैली सेट की तुलना में, पहचान का बोझ अधिक है क्योंकि कोने की अधिक जानकारी मायने रखती है।";
"algs.info.cls.recommended.p1" = "उन्नत CFOP सॉल्वरों के लिए अनुशंसित जो पहले से ही अंतिम-स्लॉट सिस्टम का आनंद लेते हैं और ऐसे मामलों का पता लगाना चाहते हैं जो सामान्य आवेषण या सरल OLL-स्किपिंग उपसमुच्चय की तुलना में काफी अधिक काम करते हैं।";
"algs.info.cls.quote.p1" = "\"CLS एक अनुस्मारक है कि अंतिम स्लॉट सिर्फ F2L का अंत नहीं है; सही स्थिति में, यह पहले से ही अंत की शुरुआत है।\"";
