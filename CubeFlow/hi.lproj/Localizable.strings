"algs.info.ortegaoll.title" = "ओर्टेगा के बारे में OLL";
"algs.info.ortegaoll.subtitle" = "2x2 ओर्टेगा विधि में अभिविन्यास चरण";
"algs.info.ortegaoll.overview.p1" = "**ऑर्टेगा OLL** पहला चेहरा बनने के बाद 2x2 की अंतिम परत को उन्मुख करता है। इसे पूरी तरह से हल करने के लिए निचली परत की आवश्यकता नहीं होती है, यही कारण है कि ओर्टेगा परत-दर-परत दृष्टिकोण की तुलना में हल्का और लचीला रहता है।";
"algs.info.ortegaoll.context.p1" = "ऑर्टेगा एक व्यावहारिक 2x2 स्पीडसॉल्विंग विधि के रूप में लोकप्रिय हो गया क्योंकि यह केवल एक छोटे एल्गोरिदम सेट की मांग करता है: किसी भी चेहरे का निर्माण करें, विपरीत चेहरे को उन्मुख करें, फिर पीबीएल के साथ समाप्त करें। शुरुआती समाधान के बाद यह अक्सर पहली वास्तविक 2x2 विधि होती है।";
"algs.info.ortegaoll.structure.b1" = "ऑर्टेगा OLL पर **7 मामले** हैं";
"algs.info.ortegaoll.structure.b2" = "लक्ष्य केवल अभिविन्यास है, पूर्ण अंतिम-स्तर का समाधान नहीं";
"algs.info.ortegaoll.structure.b3" = "आमतौर पर इसके बाद **ऑर्टेगा पीबीएल** आता है";
"algs.info.ortegaoll.structure.b4" = "कम एल्गोरिदम गणना इसे एक मजबूत प्रथम गति विधि बनाती है";
"algs.info.ortegaoll.insights.p1" = "ऑर्टेगा OLL की ताकत यह है कि यह निरीक्षण को सरल रखता है। आपको केवल एक चेहरे की योजना बनाने की आवश्यकता है, पूरी परत की नहीं, इसलिए टाइमर शुरू होने से पहले कई समाधान देखना आसान हो जाता है।";
"algs.info.ortegaoll.insights.p2" = "क्योंकि पहले चेहरे के टुकड़ों को क्रमबद्ध नहीं किया जा सकता है, अंतिम समाधान की गुणवत्ता अगले आने वाले पीबीएल को पहचानने पर काफी हद तक निर्भर करती है। OLL और पीबीएल को दो अलग-अलग सूचियों के बजाय एक प्रवाह के रूप में अभ्यास किया जाना चाहिए।";
"algs.info.ortegaoll.insights.p3" = "कई क्यूबर्स के लिए, ओर्टेगा OLL CLL और EG में पुल भी है: यह अधिक शक्तिशाली अंतिम चरण के लिए क्रमपरिवर्तन छोड़ते समय पहले अभिविन्यास को हल करने का विचार सिखाता है।";
"algs.info.ortegaoll.recognition.p1" = "पहचान ऊपरी चेहरे पर उन्मुख स्टिकर के पैटर्न पर आधारित है। चूँकि केवल कुछ ही मामले हैं, मुख्य कौशल उस कोण को चुनना है जो स्वाभाविक रूप से तेज़ पीबीएल पहचान की ओर ले जाता है।";
"algs.info.ortegaoll.recommended.p1" = "शुरुआती से आगे बढ़ने वाले किसी भी व्यक्ति के लिए अनुशंसित 2x2। इसे पीबीएल के साथ सीखें, फिर बाद में तय करें कि CLL या EG तक जारी रखना है या नहीं।";
"algs.info.ortegaoll.quote.p1" = "ऑर्टेगा OLL छोटा है, लेकिन यह सबसे महत्वपूर्ण 2x2 आदतों में से एक सिखाता है: एक उपयोगी चेहरा बनाएं, फिर एक पठनीय अंतिम-परत स्थिति से समाप्त करें।";
"algs.info.ortegapbl.title" = "ओर्टेगा पीबीएल के बारे में";
"algs.info.ortegapbl.subtitle" = "ऑर्टेगा ओरिएंटेशन के बाद दोनों परतों को क्रमबद्ध करें";
"algs.info.ortegapbl.overview.p1" = "**ओर्टेगा पीबीएल** का अर्थ है **दोनों परतों का क्रमपरिवर्तन**। दोनों चेहरों के उन्मुख होने के बाद, पीबीएल 2x2 को समाप्त करने के लिए एक ही समय में ऊपरी और निचली परतों को क्रमबद्ध करता है।";
"algs.info.ortegapbl.context.p1" = "पीबीएल वह है जो ओर्टेगा को कुशल बनाता है: विधि पहली परत को पूरी तरह से हल करने में अतिरिक्त प्रयास खर्च नहीं करती है, क्योंकि अंतिम पीबीएल चरण दोनों परतों को एक साथ ठीक कर सकता है।";
"algs.info.ortegapbl.structure.b1" = "ओर्टेगा पीबीएल में **6 मामले** हैं";
"algs.info.ortegapbl.structure.b2" = "ओर्टेगा के अंतिम चरण के रूप में कार्य करता है";
"algs.info.ortegapbl.structure.b3" = "ऊपरी-परत, निचली-परत और दोनों-परत स्वैप को संभालता है";
"algs.info.ortegapbl.structure.b4" = "पहचान की गति अक्सर कच्ची एल्गोरिदम गति से अधिक मायने रखती है";
"algs.info.ortegapbl.insights.p1" = "पीबीएल कॉम्पैक्ट है, लेकिन यदि आप केवल शीर्ष परत को पहचानते हैं तो यह आश्चर्यजनक रूप से धीमा महसूस हो सकता है। मजबूत ऑर्टेगा सॉल्वर दोनों परतों को जल्दी से पढ़ना और AUF का स्पष्ट अनुमान लगाना सीखते हैं।";
"algs.info.ortegapbl.insights.p2" = "कुछ पीबीएल मामले ओर्टेगा के बाहर भी उपयोगी हैं, क्योंकि समान क्रमपरिवर्तन विचार EG और अन्य 2x2 एक-लुक सिस्टम में दिखाई देते हैं।";
"algs.info.ortegapbl.insights.p3" = "वास्तविक ऑर्टेगा स्क्रैम्बल्स से पीबीएल का अभ्यास करना केवल हल किए गए सेटअपों को ड्रिल करने से बेहतर है, क्योंकि निचली परत का अभिविन्यास और देखने का कोण इस बात को प्रभावित करता है कि केस कितनी जल्दी दिखाई देता है।";
"algs.info.ortegapbl.recognition.p1" = "देखें कि क्या शीर्ष परत में एक बार है, क्या निचली परत में एक बार है, और क्या दोनों परतों को आसन्न या विकर्ण स्वैप की आवश्यकता है।";
"algs.info.ortegapbl.recommended.p1" = "ऑर्टेगा OLL के तुरंत बाद अनुशंसित। विश्वसनीय पीबीएल के बिना, ओर्टेगा अधूरा महसूस करेगा, भले ही अभिविन्यास तेज़ हो।";
"algs.info.ortegapbl.quote.p1" = "पीबीएल ऑर्टेगा का भुगतान है: पहली परत को हल करने के लिए मजबूर करने के बजाय, आप अंतिम एल्गोरिदम को एक ही बार में दोनों परतों को साफ करने देते हैं।";
"algs.info.cll.title" = "CLL के बारे में";
"algs.info.cll.subtitle" = "हल की गई पहली परत के साथ अंतिम परत को एक-दिखें";
"algs.info.cll.overview.p1" = "**CLL**, या **अंतिम परत के कोने**, हल की गई पहली परत को संरक्षित करते हुए संपूर्ण 2x2 अंतिम परत को एक एल्गोरिदम में हल करता है।";
"algs.info.cll.context.p1" = "CLL क्लासिक उन्नत 2x2 मील के पत्थर में से एक है। यह EG से भी निकटता से संबंधित है: हल की गई पहली परत को EG-0 केस परिवार के रूप में देखा जा सकता है।";
"algs.info.cll.structure.b1" = "CLL में **40 मामले** हैं";
"algs.info.cll.structure.b2" = "एल्गोरिथम से पहले हल की गई पहली परत की आवश्यकता होती है";
"algs.info.cll.structure.b3" = "अभिविन्यास और क्रमपरिवर्तन को एक साथ हल करता है";
"algs.info.cll.structure.b4" = "अक्सर पूर्ण EG की तुलना में नियंत्रित करना आसान होता है क्योंकि निचली परत हल हो जाती है";
"algs.info.cll.insights.p1" = "CLL एक बहुत ही साफ समाधान प्रवाह देता है: एक परत बनाएं, एक अंतिम-परत केस को पहचानें, और समाप्त करें। पहली परत में ओर्टेगा चेहरे की तुलना में अधिक काम लगता है, लेकिन अंतिम चरण अधिक शक्तिशाली होता है।";
"algs.info.cll.insights.p2" = "कई क्यूबर्स EG से पहले CLL सीखते हैं क्योंकि पहचान अधिक स्थिर होती है। आप इसे किसी अन्य फॉर्मूला सेट के बजाय 2x2 उन्नत पारिस्थितिकी तंत्र के केंद्र के रूप में मान सकते हैं।";
"algs.info.cll.insights.p3" = "अच्छे CLL अभ्यास में प्रथम-स्तर की योजना शामिल होनी चाहिए। यदि परत बहुत अधिक समय लेती है, तो एक-दिखने वाली अंतिम परत वास्तव में अधिक समय नहीं बचाएगी।";
"algs.info.cll.recognition.p1" = "मान्यता कोने के क्रमपरिवर्तन के साथ अंतिम-परत अभिविन्यास आकार को जोड़ती है। अधिकांश सॉल्वर पहले अभिविन्यास परिवार की पहचान करते हैं, फिर पुष्टि करते हैं कि कौन सा क्रमपरिवर्तन संस्करण मौजूद है।";
"algs.info.cll.recommended.p1" = "ऑर्टेगा आरामदायक होने के बाद अनुशंसित है और आप तुरंत पूर्ण EG सीखने का भार उठाए बिना एक गंभीर 2x2 अपग्रेड चाहते हैं।";
"algs.info.cll.quote.p1" = "CLL वह जगह है जहां 2x2 एक कम 3x3 की तरह कम और अपनी स्वयं की एक-दिखने वाली पहेली की तरह अधिक महसूस होने लगता है।";
"algs.info.eg1.title" = "EG-1 के बारे में";
"algs.info.eg1.subtitle" = "EG निकटवर्ती निचली-परत स्वैप वाले मामले";
"algs.info.eg1.overview.p1" = "**EG-1** 2x2 EG विधि का हिस्सा है। यह एक निर्मित चेहरे से एक एल्गोरिदम में क्यूब को खत्म करता है जहां नीचे की परत में हल होने के बजाय आसन्न स्वैप संबंध होता है।";
"algs.info.eg1.context.p1" = "एरिक अकर्सडिज्क और गुन्नार क्रिग से जुड़ी EG विधि को दो-चरणीय 2x2 गति विधि के रूप में प्रस्तावित किया गया था: एक चेहरा बनाएं, फिर पूरे क्यूब को एक एल्गोरिदम के साथ हल करें। EG-1 इसके प्रमुख केस परिवारों में से एक है।";
"algs.info.eg1.structure.b1" = "EG-1 में **40 मामले** हैं";
"algs.info.eg1.structure.b2" = "एक निर्मित चेहरे का उपयोग करता है, जरूरी नहीं कि एक सुलझी हुई परत हो";
"algs.info.eg1.structure.b3" = "निचली परत की स्थिति एक आसन्न स्वैप पैटर्न है";
"algs.info.eg1.structure.b4" = "उच्च भुगतान, लेकिन मान्यता और AUF अनुशासन की मांग है";
"algs.info.eg1.insights.p1" = "EG-1 आकर्षक है क्योंकि कई झगड़ों में आसान चेहरे होते हैं। यदि आप निरीक्षण के दौरान चेहरा और अंतिम मामला देख सकते हैं, तो समाधान अत्यंत प्रत्यक्ष हो सकता है।";
"algs.info.eg1.insights.p2" = "लागत यह है कि एल्गोरिथम के लिए पहला चेहरा सही ढंग से संरेखित होना चाहिए। यह प्री-AUF और पोस्ट-AUF को CLL की तुलना में अधिक महत्वपूर्ण बनाता है।";
"algs.info.eg1.insights.p3" = "कई सॉल्वर पूर्ण EG सीखने से पहले चुनिंदा रूप से EG-1 का उपयोग करते हैं। CLL से आगे यह अक्सर सबसे व्यावहारिक पहला कदम होता है क्योंकि निकटवर्ती निचली अवस्थाएँ सामान्य और पठनीय होती हैं।";
"algs.info.eg1.recognition.p1" = "पहचान निचले चेहरे के रिश्ते से शुरू होती है, फिर सटीक एल्गोरिदम चुनने के लिए ऊपरी परत के कोने पैटर्न का उपयोग करती है।";
"algs.info.eg1.recommended.p1" = "उन्नत 2x2 सॉल्वरों के लिए अनुशंसित जो पहले से ही CLL जानते हैं और आसान फेस बिल्ड को पूर्ण वन-लुक फ़िनिश में परिवर्तित करना चाहते हैं।";
"algs.info.eg1.quote.p1" = "EG-1 एक अलग तरह की गति को पुरस्कृत करता है: न केवल तेजी से मुड़ना, बल्कि एक उपयोगी अनसुलझे चेहरे को एक पूर्ण समाधान के रूप में देखना जो घटित होने की प्रतीक्षा कर रहा है।";
"algs.info.eg2.title" = "EG-2 के बारे में";
"algs.info.eg2.subtitle" = "EG विकर्ण तल-परत स्वैप वाले मामले";
"algs.info.eg2.overview.p1" = "**EG-2** एक निर्मित चेहरे से 2x2 को पूरा करता है जहां निचली परत में विकर्ण स्वैप संबंध होता है। यह CLL और EG-1 से परे दूसरा बड़ा EG परिवार है।";
"algs.info.eg2.context.p1" = "EG-2 पूर्ण EG विधि से संबंधित है, लेकिन कई सॉल्वर इसे EG-1 के बाद बाद में सीखते हैं क्योंकि कुछ मामलों को टाला जा सकता है या व्यावहारिक समाधान में परिवर्तित किया जा सकता है।";
"algs.info.eg2.structure.b1" = "EG-2 में **40 मामले** हैं";
"algs.info.eg2.structure.b2" = "विकर्ण तल-परत स्वैप के साथ निर्मित चेहरे का उपयोग करता है";
"algs.info.eg2.structure.b3" = "उस अवस्था से घन को एक एल्गोरिदम में पूरा करता है";
"algs.info.eg2.structure.b4" = "आमतौर पर देर से उन्नत 2x2 सेट के रूप में माना जाता है";
"algs.info.eg2.insights.p1" = "EG-2 बहुत शक्तिशाली हो सकता है, लेकिन यह CLL से कम क्षमाशील है क्योंकि निचली परत हल नहीं हुई है और केस को सही ढंग से संरेखित किया जाना चाहिए।";
"algs.info.eg2.insights.p2" = "कुछ क्यूबर्स पूर्ण EG-2 में देरी करते हैं और इसके बजाय CLL जैसे विकल्पों या प्रथम-चेहरे विकल्पों का उपयोग करते हैं जो सबसे कठिन मामलों से बचते हैं। यह एक वैध व्यावहारिक मार्ग है, संपूर्ण प्रणाली को सीखने में विफलता नहीं।";
"algs.info.eg2.insights.p3" = "यदि आप EG-2 सीखते हैं, तो इसे केवल पृथक एल्ग प्रशिक्षकों के बजाय निरीक्षण-शैली के फेस बिल्ड से ड्रिल करें। मान तब प्रकट होता है जब चेहरे और अंतिम चरण की एक साथ योजना बनाई जाती है।";
"algs.info.eg2.recognition.p1" = "पहले निचले फलक पर विकर्ण संबंध को पहचानें, फिर ऊपरी परत के कोने के मामले को पहचानें और आवश्यक AUF करें।";
"algs.info.eg2.recommended.p1" = "गंभीर 2x2 सॉल्वरों के लिए अनुशंसित जो पहले से ही CLL और EG-1 जानते हैं और अधिक संपूर्ण वन-लुक टूलकिट चाहते हैं।";
"algs.info.eg2.quote.p1" = "EG-2 केवल अधिक एल्गोरिदम नहीं है; यह पहले चेहरे को एक सुलझी हुई परत के बजाय एक लचीले लॉन्च बिंदु के रूप में मानने की प्रतिबद्धता है।";
"algs.info.ollparity.title" = "4x4 OLL समता के बारे में";
"algs.info.ollparity.subtitle" = "4x4 कमी के बाद अभिविन्यास समता";
"algs.info.ollparity.overview.p1" = "**4x4 OLL समता** परिचित अंतिम-परत स्थिति है जहां पहेली को 3x3-जैसी स्थिति में कम करने के बाद एक किनारे फ़्लिप किया हुआ दिखाई देता है।";
"algs.info.ollparity.context.p1" = "समानता सम-परत क्यूब्स पर दिखाई देती है क्योंकि केंद्र और किनारे की जोड़ी ऐसी स्थिति बना सकती है जो वास्तविक 3x3 पर नहीं हो सकती है। OLL समता उस समस्या का अभिविन्यास-दिखने वाला संस्करण है।";
"algs.info.ollparity.structure.b1" = "यह लाइब्रेरी **3 व्यावहारिक OLL समता एल्गोरिदम** को कवर करती है";
"algs.info.ollparity.structure.b2" = "आमतौर पर एज पेयरिंग के बाद और सामान्य OLL/PLL पूरा होने से पहले दिखाई देता है";
"algs.info.ollparity.structure.b3" = "कम किनारे की ओरिएंटेशन स्थिति को ठीक करता है";
"algs.info.ollparity.structure.b4" = "कई मामलों को याद रखने की तुलना में विस्तृत मोड़ और स्लाइस नियंत्रण अधिक मायने रखते हैं";
"algs.info.ollparity.insights.p1" = "OLL समता कोई सामान्य OLL मामला नहीं है। यह एक न्यूनीकरण विरूपण साक्ष्य है, इसलिए सबसे अच्छा समाधान आमतौर पर 3x3 की तरह तर्क करने की कोशिश करने के बजाय एक समर्पित समता एल्गोरिथ्म है।";
"algs.info.ollparity.insights.p2" = "निष्पादन की गुणवत्ता बहुत मायने रखती है क्योंकि समता एल्गोरिदम लंबे और स्लाइस-भारी होते हैं। एक स्थिर पकड़ और साफ़ वाइड-टर्न लय अस्पष्ट विकल्पों का जल्दी पीछा करने की तुलना में अधिक उपयोगी है।";
"algs.info.ollparity.insights.p3" = "एक बार समता तय हो जाने पर, समाधान सामान्य 3x3-शैली अंतिम-परत तर्क पर वापस आ जाता है।";
"algs.info.ollparity.recognition.p1" = "पहचान सीधी है: कटौती के बाद, अंतिम परत ऐसी दिखती है जैसे एक किनारे की जोड़ी फ़्लिप हो गई है या 3x3 पर OLL स्थिति अन्यथा असंभव है।";
"algs.info.ollparity.recommended.p1" = "जैसे ही आप 4x4 को कमी या Yau के साथ हल करना शुरू करते हैं, इसकी अनुशंसा की जाती है। यह अनिवार्य ज्ञान है, वैकल्पिक उन्नत सेट नहीं।";
"algs.info.ollparity.quote.p1" = "4x4 OLL समता वह क्षण है जब घटा हुआ घन आपको याद दिलाता है कि यह वास्तव में कभी 3x3 नहीं था।";
"algs.info.pllparity.title" = "4x4 PLL समता के बारे में";
"algs.info.pllparity.subtitle" = "4x4 कमी के बाद क्रमपरिवर्तन समता";
"algs.info.pllparity.overview.p1" = "**4x4 PLL समता** एक अंतिम-परत क्रमपरिवर्तन समस्या है जहां घटा हुआ घन एक स्वैप स्थिति तक पहुंचता है जो मानक 3x3 पर असंभव होगा।";
"algs.info.pllparity.context.p1" = "OLL समता की तरह, PLL समता एक सम-परत पहेली को कम करने से आती है। कम 3x3 मॉडल में एक विषम क्रमपरिवर्तन छोड़ते हुए केंद्रों और युग्मित किनारों को हल किया जा सकता है।";
"algs.info.pllparity.structure.b1" = "यह लाइब्रेरी **22 PLL समता मामले और एल्गोरिदम** को कवर करती है";
"algs.info.pllparity.structure.b2" = "अक्सर दो-किनारे-जोड़ी स्वैप या आसन्न-दिखने वाली अंतिम-परत असंभवता के रूप में प्रकट होता है";
"algs.info.pllparity.structure.b3" = "आमतौर पर अंतिम PLL चरण से पहले या उसके दौरान हल किया जाता है";
"algs.info.pllparity.structure.b4" = "कई प्रकार मौजूद हैं, लेकिन अधिकांश सॉल्वरों के लिए एक छोटा विश्वसनीय टूलकिट पर्याप्त है";
"algs.info.pllparity.insights.p1" = "PLL समता वह है जहां कमी दक्षता और 3x3 मान्यता मिलती है। मामला एक परिचित PLL जैसा लग सकता है जब तक कि एक असंभव स्वैप न रह जाए।";
"algs.info.pllparity.insights.p2" = "कुछ सॉल्वर लगभग हर चीज़ के लिए एक मुख्य एल्गोरिदम का उपयोग करते हैं; अन्य लोग आसन्न, विकर्ण, या पहचान-विशिष्ट प्रकार सीखते हैं। सही विकल्प इस बात पर निर्भर करता है कि आप कितना 4x4 हल करते हैं।";
"algs.info.pllparity.insights.p3" = "क्योंकि PLL समता अक्सर समाधान के अंत के करीब पहुंचती है, शांत निष्पादन मूल्यवान है। यहां एक लॉकअप पिछले चरणों के बहुत सारे अच्छे काम को मिटा सकता है।";
"algs.info.pllparity.recognition.p1" = "एक कम अंतिम परत की तलाश करें जहां शेष क्रमपरिवर्तन के लिए वेजेज की एक जोड़ी की अदला-बदली की आवश्यकता होगी या अन्यथा सामान्य 3x3 समता का उल्लंघन होगा।";
"algs.info.pllparity.recommended.p1" = "प्रत्येक 4x4 सॉल्वर के लिए अनुशंसित। पहले एक भरोसेमंद एल्गोरिदम सीखें, फिर तेज़ वेरिएंट तभी जोड़ें जब आप अक्सर घटना को हल करते हों।";
"algs.info.pllparity.quote.p1" = "PLL समता कोई अजीब बात नहीं है PLL; यह एक सम-परत वाले घन को 3x3 बनने का दिखावा करने की कीमत है।";
"algs.info.l2e.title" = "5x5 L2E के बारे में";
"algs.info.l2e.subtitle" = "5x5 कमी में अंतिम दो किनारे";
"algs.info.l2e.overview.p1" = "**L2E**, या **अंतिम दो किनारे**, 5x5 पर अंतिम किनारा-युग्मन चरण है। यह 3x3 की तरह पहेली को हल करने से पहले अंतिम अनसुलझी उलझनों को हल करता है।";
"algs.info.l2e.context.p1" = "कटौती और Yau-शैली 5x5 समाधान में, अधिकांश किनारों को स्वतंत्र रूप से जोड़ा जा सकता है, लेकिन अंतिम दो को अक्सर विशिष्ट मामलों की आवश्यकता होती है। L2E उस बाधा के लिए कॉम्पैक्ट एल्गोरिथम टूलकिट है।";
"algs.info.l2e.structure.b1" = "यह लाइब्रेरी **13 एल2ई मामले** को कवर करती है";
"algs.info.l2e.structure.b2" = "एज पेयरिंग के अंत के पास उपयोग किया जाता है";
"algs.info.l2e.structure.b3" = "अंतिम दो डेज को साफ-सुथरे तरीके से खत्म करने का लक्ष्य है";
"algs.info.l2e.structure.b4" = "अच्छे सेटअप विकल्प कम कर सकते हैं कि कितने मामलों की आवश्यकता महसूस होती है";
"algs.info.l2e.insights.p1" = "L2E एक विशाल विधि के बारे में कम और अंतिम अजीब एज-पेयरिंग स्टॉप को हटाने के बारे में अधिक है। यह समाधान को 3x3 चरण से ठीक पहले रुकने से बचाता है।";
"algs.info.l2e.insights.p2" = "कई मामलों का समाधान यह समझकर किया जा सकता है कि पंख कैसे जुड़ते और बदलते हैं, न कि केवल एक छवि को याद करके। वह समझ 6x6 और 7x7 पर भी मदद करती है।";
"algs.info.l2e.insights.p3" = "यथार्थवादी आंशिक एज-पेयरिंग स्थितियों के बाद L2E को ड्रिल करना सबसे अच्छा अभ्यास है, क्योंकि सेटअप और केस चयन कौशल का हिस्सा हैं।";
"algs.info.l2e.recognition.p1" = "मान्यता इस बात पर केंद्रित है कि शेष दो विंग जोड़े आगे, पीछे और स्लाइस स्थिति में कैसे विभाजित हैं, साथ ही क्या एक छोटा सेटअप राज्य को एक परिचित मामले में बदल सकता है।";
"algs.info.l2e.recommended.p1" = "एक बार अनुशंसित किया जाता है कि आप 5x5 केंद्रों और अधिकांश किनारों को आराम से पूरा कर सकते हैं लेकिन फिर भी अंतिम दो किनारों पर समय बर्बाद कर सकते हैं।";
"algs.info.l2e.quote.p1" = "L2E बिग-क्यूब बिल्डिंग और परिचित 3x3 फिनिश के बीच छोटा गेट है।";
"algs.info.l2c.title" = "5x5 L2C के बारे में";
"algs.info.l2c.subtitle" = "5x5 केंद्र भवन में अंतिम दो केंद्र";
"algs.info.l2c.overview.p1" = "**L2C**, या **अंतिम दो केंद्र**, एज पेयरिंग या बाद में कमी के चरणों को जारी रखने से पहले 5x5 पर अंतिम केंद्र-निर्माण मामलों को कवर करता है।";
"algs.info.l2c.context.p1" = "5x5 पर, केंद्र एक-दूसरे के सापेक्ष तय होते हैं, लेकिन अंतिम दो केंद्रों का कुशलतापूर्वक निर्माण करना अभी भी अजीब हो सकता है। L2C एल्गोरिदम उन अंतिम केंद्र मामलों को संरचना देते हैं।";
"algs.info.l2c.structure.b1" = "यह लाइब्रेरी **18 एल2सी मामले** को कवर करती है";
"algs.info.l2c.structure.b2" = "अंतिम दो केंद्रों को पूरा करते समय उपयोग किया जाता है";
"algs.info.l2c.structure.b3" = "केंद्र के टुकड़ों को व्यवस्थित करते समय पहले से निर्मित केंद्रों को संरक्षित करता है";
"algs.info.l2c.structure.b4" = "अधिकतर कमी-दक्षता सेट, अंतिम-परत सेट नहीं";
"algs.info.l2c.insights.p1" = "L2C मायने रखता है क्योंकि केंद्र निर्माण शेष 5x5 समाधान के लिए लय निर्धारित करता है। यदि अंतिम केंद्र अनाड़ी हैं, तो एज पेयरिंग शुरू होने से पहले ही सॉल्व प्रवाह खो देता है।";
"algs.info.l2c.insights.p2" = "कुछ सॉल्वर L2C को अधिकतर सहजता से हल करते हैं, जबकि अन्य ज्ञात मामलों के एक छोटे समूह को पसंद करते हैं। सबसे अच्छा तरीका वह है जो लुकअहेड और केंद्र संरक्षण को स्थिर रखता है।";
"algs.info.l2c.insights.p3" = "L2C सीखने से सामान्य बड़े-घन केंद्र अंतर्ज्ञान में भी सुधार होता है, विशेष रूप से कैसे टुकड़े तैयार केंद्रों को नष्ट किए बिना स्लाइस के माध्यम से आगे बढ़ते हैं।";
"algs.info.l2c.recognition.p1" = "पहचान अंतिम दो केंद्रीय चेहरों पर शेष केंद्रीय टुकड़ों के पैटर्न पर आधारित है और क्या उन्हें जोड़ा जा सकता है, बदला जा सकता है, या एक साफ स्लाइस अनुक्रम के साथ डाला जा सकता है।";
"algs.info.l2c.recommended.p1" = "5x5 सॉल्वरों के लिए अनुशंसित जो पहले से ही केंद्र निर्माण को समझते हैं लेकिन अंतिम केंद्रों पर कम रुकना चाहते हैं।";
"algs.info.l2c.quote.p1" = "अच्छा L2C अंतिम केंद्रों को टुकड़ों के बिखराव से एक छोटे, नियोजित निर्माण चरण में बदल देता है।";
"algs.info.sq1cs.title" = "SQ1 घन आकार के बारे में";
"algs.info.sq1cs.subtitle" = "Square-1 को घन आकार में लौटा रहा हूँ";
"algs.info.sq1cs.overview.p1" = "**Square-1 घन आकार** अधिकांश Square-1 विधियों का पहला प्रमुख चरण है। यह पहेली को मनमाने आकार से वापस घन आकार में बदल देता है ताकि बाद में परत और क्रमपरिवर्तन चरणों को लागू किया जा सके।";
"algs.info.sq1cs.context.p1" = "घन आकार Square-1 के केंद्र में है क्योंकि पहेली हाथापाई करते समय आकार बदलती है। Vandenbergh और Lin जैसी विधियां अधिक एल्गोरिथम एंडगेम शुरू होने से पहले क्यूब आकार तक पहुंचने पर निर्भर करती हैं।";
"algs.info.sq1cs.structure.b1" = "Square-1 इस वर्गीकरण में क्यूब शेप में **170 आकार के मामले** हैं";
"algs.info.sq1cs.structure.b2" = "आमतौर पर Square-1 हल का पहला चरण";
"algs.info.sq1cs.structure.b3" = "पतंग, मुट्ठी, स्कैलप और ढाल जैसे आकार के नाम आम पहचान वाले एंकर हैं";
"algs.info.sq1cs.structure.b4" = "दक्षता आकार परिवारों को पहचानने पर निर्भर करती है, न कि हर पथ को समान रूप से याद रखने पर";
"algs.info.sq1cs.insights.p1" = "घन आकार वह जगह है जहां Square-1 NxN पहेलियों से सबसे अलग महसूस होता है। आप सिर्फ टुकड़े नहीं हिला रहे हैं; आप नियंत्रित कर रहे हैं कि कौन से मोड़ संभव हैं।";
"algs.info.sq1cs.insights.p2" = "मजबूत सॉल्वर अक्सर आकार परिवर्तन में सोचते हैं। प्रत्येक स्थिति को एक अलग एल्गोरिदम के रूप में देखने के बजाय, वे सीखते हैं कि कैसे सामान्य आकार सरल आकार में और फिर घन आकार में प्रवाहित होते हैं।";
"algs.info.sq1cs.insights.p3" = "क्योंकि आकार कानूनी चालों को प्रभावित करता है, नामों और दृश्य छायाचित्रों के साथ जानबूझकर किया गया अभ्यास शीघ्र ही फल देता है।";
"algs.info.sq1cs.recognition.p1" = "पहचान ऊपर और नीचे की परत के आकार युग्म पर आधारित है। पतंग/पतंग या मुट्ठी/स्कैलप जैसे नाम सीखने से प्रत्येक स्थिति को एक मौखिक हैंडल मिलता है, जिससे ड्रिलिंग बहुत आसान हो जाती है।";
"algs.info.sq1cs.recommended.p1" = "डीप एंडगेम एल्गोरिदम से पहले प्रत्येक Square-1 सॉल्वर के लिए अनुशंसित। घन-आकार के प्रवाह के बिना, शेष विधि प्रवाहित नहीं हो सकती।";
"algs.info.sq1cs.quote.p1" = "घन आकार Square-1 की भाषा है: एक बार जब आकृतियों के नाम हो जाते हैं, तो पहेली पढ़ने योग्य होने लगती है।";
"algs.info.sq1co.title" = "SQ1 कॉर्नर ओरिएंटेशन के बारे में";
"algs.info.sq1co.subtitle" = "Square-1 कोनों को सही परतों पर रखना";
"algs.info.sq1co.overview.p1" = "**SQ1 कॉर्नर ओरिएंटेशन** घन आकार के बाद कोनों को सही परतों में लाता है। Vandenbergh-शैली को हल करने में, यह शुरुआती चरणों में से एक है जो पहेली को क्रमपरिवर्तन के लिए तैयार करता है।";
"algs.info.sq1co.context.p1" = "Vandenbergh विधि पोस्ट-क्यूब-आकार के प्रवाह को परतों को सही करने के लिए कोनों, परतों को सही करने के लिए किनारों, फिर कोने और किनारे के क्रमपरिवर्तन के रूप में वर्णित करती है। CO उन परत-सुधार चरणों में से पहला है।";
"algs.info.sq1co.structure.b1" = "SQ1 CO में **7 मामले** हैं";
"algs.info.sq1co.structure.b2" = "घन आकार के बाद आता है";
"algs.info.sq1co.structure.b3" = "कोने-परत सुधार को बाद के क्रमपरिवर्तन से अलग करता है";
"algs.info.sq1co.structure.b4" = "छोटा सेट, लेकिन विधि लय के लिए महत्वपूर्ण";
"algs.info.sq1co.insights.p1" = "CO ग्लैमरस नहीं है, लेकिन यह एंडगेम को व्यवस्थित रखता है। कोनों को सही परतों पर जल्दी रखने से, बाद में CP मामलों को वर्गीकृत करना बहुत आसान हो जाता है।";
"algs.info.sq1co.insights.p2" = "क्योंकि सेट छोटा है, लक्ष्य तुरंत पहचान और बहुत स्थिर स्लैश टाइमिंग होना चाहिए।";
"algs.info.sq1co.insights.p3" = "CO और EO को तैयारी के चरणों की एक जोड़ी के रूप में मानें: साथ में वे एक आकार Square-1 को क्रमपरिवर्तन के लिए तैयार चीज़ में बदल देते हैं।";
"algs.info.sq1co.recognition.p1" = "पहचान इस बात पर केंद्रित है कि क्या ऊपरी और निचली परत के कोने उनकी वर्तमान परतों पर हैं या उन्हें स्लैश में बदलने की आवश्यकता है।";
"algs.info.sq1co.recommended.p1" = "Square-1 सॉल्वर सीखने Vandenbergh या किसी समान परत-सुधार एंडगेम के लिए अनुशंसित।";
"algs.info.sq1co.quote.p1" = "CO घन आकार के बाद शांत रीसेट है: कोने आकार के टुकड़े बनना बंद कर देते हैं और फिर से परत के टुकड़े बन जाते हैं।";
"algs.info.sq1eo.title" = "SQ1 एज ओरिएंटेशन के बारे में";
"algs.info.sq1eo.subtitle" = "Square-1 किनारों को सही परतों पर रखना";
"algs.info.sq1eo.overview.p1" = "**SQ1 एज ओरिएंटेशन** क्यूब आकार और कोने ओरिएंटेशन के बाद किनारों को सही परतों में लाता है। यह CP, EP, और समता प्रबंधन के लिए पहेली तैयार करता है।";
"algs.info.sq1eo.context.p1" = "Vandenbergh-शैली Square-1 में, EO CO के समान तर्क का पालन करता है: क्रमपरिवर्तन से परत सुधार को अलग करें ताकि एंडगेम को साफ चरणों में हल किया जा सके।";
"algs.info.sq1eo.structure.b1" = "SQ1 EO में **7 मामले** हैं";
"algs.info.sq1eo.structure.b2" = "आमतौर पर CO का अनुसरण करता है";
"algs.info.sq1eo.structure.b3" = "किनारों के लिए परत सुधार पूरा करता है";
"algs.info.sq1eo.structure.b4" = "अच्छी EO पहचान CP और EP को कम अराजक महसूस कराती है";
"algs.info.sq1eo.insights.p1" = "EO वह जगह है जहां Square-1 एंडगेम का अनुमान लगाया जाना शुरू होता है। एक बार जब किनारे सही परतों पर होते हैं, तो क्रमपरिवर्तन के मामलों के बारे में तर्क करना बहुत आसान हो जाता है।";
"algs.info.sq1eo.insights.p2" = "सेट इतना छोटा है कि आपको स्वचालित निष्पादन का लक्ष्य रखना चाहिए, लेकिन फिर भी वास्तविक समाधान संदर्भों में इसका अभ्यास करें क्योंकि स्लैश संरेखण मायने रखता है।";
"algs.info.sq1eo.insights.p3" = "EO आपको पहले समानता पर ध्यान देने में भी मदद करता है, क्योंकि अभिविन्यास चरण समाप्त होने के बाद पहेली की परत संरचना स्पष्ट हो जाती है।";
"algs.info.sq1eo.recognition.p1" = "पहचान इस पर आधारित है कि कौन से किनारे ऊपरी या निचली परत से संबंधित हैं और क्या वर्तमान परत व्यवस्था पहले से ही सही है या नियंत्रित स्वैप की आवश्यकता है।";
"algs.info.sq1eo.recommended.p1" = "Vandenbergh जैसी चरणबद्ध विधि का उपयोग करके प्रत्येक Square-1 सॉल्वर के लिए अनुशंसित।";
"algs.info.sq1eo.quote.p1" = "EO के बाद, Square-1 आकारहीन महसूस करना बंद कर देता है और क्रमपरिवर्तन पहेली की तरह व्यवहार करना शुरू कर देता है।";
"algs.info.sq1cp.title" = "SQ1 कॉर्नर क्रमपरिवर्तन के बारे में";
"algs.info.sq1cp.subtitle" = "उनकी परतों के भीतर Square-1 कोनों को क्रमबद्ध करना";
"algs.info.sq1cp.overview.p1" = "**SQ1 कॉर्नर क्रमपरिवर्तन** घन आकार और परत अभिविन्यास पूरा होने पर कोनों को क्रमपरिवर्तित करता है। यह Square-1 एंडगेम का कोने को सुलझाने वाला हिस्सा है।";
"algs.info.sq1cp.context.p1" = "Vandenbergh में, CP कोनों और किनारों को सही परतों पर रखे जाने के बाद आता है। यह पृथक्करण केस सेट को अपेक्षाकृत छोटा और पठनीय रखता है।";
"algs.info.sq1cp.structure.b1" = "SQ1 CP में **8 मामले** हैं";
"algs.info.sq1cp.structure.b2" = "CO और EO के बाद आता है";
"algs.info.sq1cp.structure.b3" = "किनारे के क्रमपरिवर्तन से पहले कोने के क्रम को हल करता है";
"algs.info.sq1cp.structure.b4" = "अक्सर फिंगरट्रिक-भारी स्लैश अनुक्रमों के साथ अभ्यास किया जाता है";
"algs.info.sq1cp.insights.p1" = "CP इस बात का एक अच्छा उदाहरण है कि Square-1 विधियों का मंचन क्यों किया जाता है: एक बार जब टुकड़े सही परतों पर होते हैं, तो कोने का क्रमपरिवर्तन एक कॉम्पैक्ट समस्या बन जाता है।";
"algs.info.sq1cp.insights.p2" = "मुख्य चुनौती मात्रा नहीं बल्कि आत्मविश्वास है। CP में एक छोटी सी हिचकिचाहट अक्सर एल्गोरिदम की लंबाई से अधिक समाधान को बाधित करती है।";
"algs.info.sq1cp.insights.p3" = "अच्छी CP पहचान EP या समता में परिवर्तन को भी आसान बनाती है क्योंकि आप समझते हैं कि कोनों को ठीक करने के बाद क्या बचता है।";
"algs.info.sq1cp.recognition.p1" = "प्रत्येक परत के चारों ओर कोने के क्रम को देखें और पहचानें कि क्या कोनों को आसन्न स्वैप, विकर्ण स्वैप की आवश्यकता है, या पहले से ही हल किए गए हैं।";
"algs.info.sq1cp.recommended.p1" = "एक बार अनुशंसित CO और EO स्थिर हैं। CP मुख्य Square-1 एंडगेम सेट में से एक है, वैकल्पिक अतिरिक्त नहीं।";
"algs.info.sq1cp.quote.p1" = "CP वह जगह है जहां Square-1 हल होने लगता है, भले ही किनारों पर अभी भी अंतिम शब्द हो।";
"algs.info.sq1parity.title" = "SQ1 समता के बारे में";
"algs.info.sq1parity.subtitle" = "एंडगेम में Square-1 समता को संभालना";
"algs.info.sq1parity.overview.p1" = "**एसक्यू1 पैरिटी** एंडगेम राज्यों को कवर करती है जहां सामान्य क्रमपरिवर्तन प्रवाह को समता-विशिष्ट फिक्स की आवश्यकता होती है, अक्सर किनारे क्रमपरिवर्तन चरण के आसपास।";
"algs.info.sq1parity.context.p1" = "Vandenbergh विधि समता को अंतिम चरण के रूप में सूचीबद्ध करती है, लेकिन इसे किनारे क्रमपरिवर्तन के साथ भी जोड़ा जा सकता है। आधुनिक Square-1 अभ्यास अक्सर समता को पता लगाने और अंत में एकीकृत करने वाली चीज़ के रूप में मानता है।";
"algs.info.sq1parity.structure.b1" = "यह लाइब्रेरी **5 SQ1 समता मामले** को कवर करती है";
"algs.info.sq1parity.structure.b2" = "आमतौर पर CP के बाद और EP के आसपास दिखाई देता है";
"algs.info.sq1parity.structure.b3" = "अलग से हल किया जा सकता है या किनारे क्रमपरिवर्तन के साथ जोड़ा जा सकता है";
"algs.info.sq1parity.structure.b4" = "मान्यता मायने रखती है क्योंकि समता बदलती है जो EP खत्म करना उचित है";
"algs.info.sq1parity.insights.p1" = "समता एक कारण है Square-1 एंडगेम फिसलन भरा महसूस हो सकता है। पहेली सुलझने के करीब लग सकती है, लेकिन एक सामान्य EP समाधान पर्याप्त नहीं है।";
"algs.info.sq1parity.insights.p2" = "एक छोटे सेट के रूप में समता सीखना उपयोगी है, लेकिन वास्तविक लक्ष्य यह जानना है कि इसे कब आपकी EP पसंद को प्रभावित करना चाहिए।";
"algs.info.sq1parity.insights.p3" = "यदि आप बाद में Lin या अधिक उन्नत Square-1 सिस्टम सीखते हैं, तो समता जागरूकता और भी महत्वपूर्ण हो जाती है क्योंकि यह PLL-शैली की समाप्ति को बदल देती है।";
"algs.info.sq1parity.recognition.p1" = "पहचान आमतौर पर CP के बाद शेष किनारे के क्रमपरिवर्तन से आती है: यदि किनारे की स्थिति को सामान्य EP प्रवाह द्वारा हल नहीं किया जा सकता है, तो समता प्रबंधन की आवश्यकता होती है।";
"algs.info.sq1parity.recommended.p1" = "बेसिक CP और EP के बाद अनुशंसित समझ में आता है। समता को एक रहस्यमय आपातकालीन एल्गोरिदम के रूप में हमेशा के लिए न छोड़ें।";
"algs.info.sq1parity.quote.p1" = "SQ1 समता केवल एक अपवाद नहीं है; यह एंडगेम भाषा का हिस्सा है।";
"algs.info.sq1ep.title" = "SQ1 एज क्रमपरिवर्तन के बारे में";
"algs.info.sq1ep.subtitle" = "Square-1 में अंतिम किनारे का क्रमपरिवर्तन";
"algs.info.sq1ep.overview.p1" = "**SQ1 एज क्रमपरिवर्तन** Square-1 समाधान के अंत के पास शेष किनारे क्रम को हल करता है, आमतौर पर घन आकार, अभिविन्यास और कोने क्रमपरिवर्तन पूरा होने के बाद।";
"algs.info.sq1ep.context.p1" = "Vandenbergh-शैली विधियां अक्सर EP और समता के साथ समाप्त होती हैं, और उन चरणों को सॉल्वर के एल्गोरिदम सेट के आधार पर अलग या संयोजित किया जा सकता है।";
"algs.info.sq1ep.structure.b1" = "SQ1 EP में **49 मामले** हैं";
"algs.info.sq1ep.structure.b2" = "Vandenbergh एंडगेम का अंतिम प्रमुख चरण";
"algs.info.sq1ep.structure.b3" = "समता के साथ निकटता से बातचीत करता है";
"algs.info.sq1ep.structure.b4" = "CO, EO, या CP से बड़ा सेट, इसलिए उपसमुच्चय अभ्यास से मदद मिलती है";
"algs.info.sq1ep.insights.p1" = "EP वह जगह है जहां Square-1 एंडगेम वॉल्यूम मायने रखना शुरू कर देता है। पहले के चरण सघन हैं, लेकिन अंतिम किनारे के मामले अधिक व्यापक रूप से शाखाबद्ध हो सकते हैं।";
"algs.info.sq1ep.insights.p2" = "सभी EP मामलों को समान रूप से मानने के बजाय, यह उन्हें स्वैप और चक्र द्वारा समूहित करने में मदद करता है। यह पहचान को अधिक संरचित बनाता है और एक विशाल सूची की भावना को कम करता है।";
"algs.info.sq1ep.insights.p3" = "समता-जागरूक EP विशेष रूप से मूल्यवान है क्योंकि यह अंत में समता को एक अलग पैनिक बटन के रूप में मानने से बचता है।";
"algs.info.sq1ep.recognition.p1" = "मान्यता ऊपर और नीचे की परतों पर शेष किनारे चक्रों पर ध्यान केंद्रित करती है, साथ ही यह भी कि क्या राज्य को सामान्य EP या समता-सम्मिलित फिनिश के रूप में संभाला जाना चाहिए।";
"algs.info.sq1ep.recommended.p1" = "CO, EO, और CP के बाद अनुशंसित स्थिर हैं। Square-1 एंडगेम स्पीड को बेहतर बनाने के लिए EP स्वाभाविक अगली जगह है।";
"algs.info.sq1ep.quote.p1" = "EP Square-1 में अर्थ की अंतिम परत है: एक बार जब आप किनारे के चक्रों को पढ़ सकते हैं, तो अंत यादृच्छिक महसूस करना बंद कर देता है।";
"algs.info.lin.title" = "Lin के बारे में";
"algs.info.lin.subtitle" = "एक Square-1 एंडगेम फ्रेमवर्क PLL-स्टाइल फ़िनिश के आसपास बनाया गया है";
"algs.info.lin.overview.p1" = "**Lin** एक उन्नत Square-1 विधि परिवार है जो मूल Vandenbergh फिनिश का बिल्कुल पालन करने के बजाय समता-जागरूक PLL-शैली चरणों के आसपास एंडगेम का पुनर्गठन करता है।";
"algs.info.lin.context.p1" = "Lin आधुनिक Square-1 स्पीडसॉल्विंग का तेज, अधिक प्रत्यक्ष समापन की ओर प्रयास का हिस्सा है। यह परिचित घन-आकार और अभिविन्यास विचारों को रखता है, फिर अंतिम क्रमपरिवर्तन कार्य को व्यवस्थित करने के तरीके को बदलता है।";
"algs.info.lin.structure.b1" = "Lin इस लाइब्रेरी संरचना में **115 मामले** हैं";
"algs.info.lin.structure.b2" = "इसमें Lin PLL, Lin समता PLL, और Lin PLL +1 स्टाइल फ़िनिश शामिल हैं";
"algs.info.lin.structure.b3" = "Square-1 अभिविन्यास और क्रमपरिवर्तन बुनियादी सिद्धांतों पर बनाता है";
"algs.info.lin.structure.b4" = "Vandenbergh के बाद सबसे अच्छी सीख एंडगेम पहचान पहले से ही आरामदायक है";
"algs.info.lin.insights.p1" = "Lin, Square-1 बेसिक्स का शुरुआती प्रतिस्थापन नहीं है। यह तब और अधिक समझ में आता है जब आप पहले से ही समझ जाते हैं कि CO, EO, CP, EP, और समता क्यों मौजूद है।";
"algs.info.lin.insights.p2" = "लाभ एक अधिक एकीकृत समापन है: प्रत्येक एंडगेम अपवाद को अलग से मानने के बजाय, Lin कई मामलों को PLL-जैसे मान्यता परिवारों में समूहित करता है।";
"algs.info.lin.insights.p3" = "क्योंकि सेट बड़ा है, चयनात्मक सीखना उचित है। उन मामलों से शुरुआत करें जो अक्सर सामने आते हैं या एंडगेम अनुक्रमों को प्रतिस्थापित करते हैं जिन्हें आप पहले से ही नापसंद करते हैं।";
"algs.info.lin.recognition.p1" = "पहचान सेटअप चरणों के बाद शेष क्रमपरिवर्तन और समता संबंध को पढ़ने, फिर उपयुक्त Lin PLL-शैली फिनिश चुनने पर निर्भर करती है।";
"algs.info.lin.recommended.p1" = "उन्नत Square-1 सॉल्वरों के लिए अनुशंसित, जिनके पास पहले से ही विश्वसनीय Vandenbergh-शैली सॉल्व है और वे अधिक शक्तिशाली एंडगेम चाहते हैं।";
"algs.info.lin.quote.p1" = "Lin Square-1 के अव्यवस्थित दिखने वाले अंत को अंतिम परत की भाषा के करीब में बदल देता है।";
"algs.info.megaminxeo.title" = "Megaminx EO के बारे में";
"algs.info.megaminxeo.subtitle" = "Megaminx 4LLL में एज ओरिएंटेशन";
"algs.info.megaminxeo.overview.p1" = "**Megaminx EO** अंतिम परत के किनारों को सामान्य 4-लुक Megaminx अंतिम परत के पहले चरण के रूप में उन्मुख करता है।";
"algs.info.megaminxeo.context.p1" = "Megaminx अंतिम परत को अक्सर 4LLL संरचना में सिखाया जाता है: किनारों को ओरिएंट करें, कोनों को ओरिएंट करें, किनारों को पर्म्यूट करें, फिर कोनों को पर्म्यूट करें। EO उस सिस्टम में छोटा प्रवेश बिंदु है।";
"algs.info.megaminxeo.structure.b1" = "Megaminx EO में **3 मामले** हैं";
"algs.info.megaminxeo.structure.b2" = "Megaminx 4LLL का पहला चरण";
"algs.info.megaminxeo.structure.b3" = "3x3 OLL किनारों की भावना के समान किनारे अभिविन्यास पैटर्न का उपयोग करता है";
"algs.info.megaminxeo.structure.b4" = "बहुत कम एल्गोरिदम गणना, उच्च व्यावहारिक मूल्य";
"algs.info.megaminxeo.insights.p1" = "EO छोटा है, लेकिन यह अंतिम परत के बाकी हिस्सों को परिभाषित करता है। एक बार जब किनारे उन्मुख हो जाते हैं, तो कोने का उन्मुखीकरण साफ हो जाता है और समाधान एक संरचित पथ में प्रवेश करता है।";
"algs.info.megaminxeo.insights.p2" = "कई 3x3 विचार यहां स्थानांतरित होते हैं, लेकिन पांच-तरफा अंतिम परत पहचान कोण और फिंगरट्रिक बदल देती है।";
"algs.info.megaminxeo.insights.p3" = "CO के साथ EO का अभ्यास करें ताकि 4LLL के पहले दो लुक एक निरंतर अभिविन्यास चरण की तरह महसूस हों।";
"algs.info.megaminxeo.recognition.p1" = "पहचान इस पर आधारित है कि कितने अंतिम-परत किनारे शीर्ष केंद्र के सापेक्ष अंतिम-परत के रंग को सही ढंग से दिखाते हैं।";
"algs.info.megaminxeo.recommended.p1" = "शुरुआती अंतिम-परत विधियों से परे प्रत्येक Megaminx सॉल्वर सीखने के लिए अनुशंसित।";
"algs.info.megaminxeo.quote.p1" = "Megaminx EO एक बैठक में सीखने के लिए काफी छोटा है, लेकिन पूरी अंतिम परत को आकार देने के लिए काफी महत्वपूर्ण है।";
"algs.info.megaminxco.title" = "Megaminx CO के बारे में";
"algs.info.megaminxco.subtitle" = "Megaminx 4LLL में कॉर्नर ओरिएंटेशन";
"algs.info.megaminxco.overview.p1" = "**Megaminx CO** किनारे के अभिविन्यास के बाद अंतिम परत के कोनों को उन्मुख करता है। यह सामान्य 4LLL Megaminx अंतिम-परत संरचना में दूसरा रूप है।";
"algs.info.megaminxco.context.p1" = "स्पीडसॉल्विंग संसाधन अक्सर Megaminx 4LLL को EO, CO, EP, और CP के रूप में वर्णित करते हैं। CO, EO का कोना-अभिमुखीकरण प्रतिरूप है और 3x3 के ओसीएलएल विचारों से मिलता-जुलता है, जिसे पांच-कोने वाली अंतिम परत में अनुकूलित किया गया है।";
"algs.info.megaminxco.structure.b1" = "Megaminx CO में **16 मामले** हैं";
"algs.info.megaminxco.structure.b2" = "आमतौर पर EO का अनुसरण करता है";
"algs.info.megaminxco.structure.b3" = "कोनों को उन्मुख करते समय किनारे के उन्मुखीकरण को सुरक्षित रखता है";
"algs.info.megaminxco.structure.b4" = "बड़े PLL-शैली सेट से पहले एक प्रबंधनीय मध्य चरण";
"algs.info.megaminxco.insights.p1" = "CO वह जगह है जहां Megaminx आखिरी परत अपनी पहेली की तरह महसूस होने लगती है। कुछ 3x3 ओसीएलएल आदतें स्थानांतरित हो जाती हैं, लेकिन केस के आकार और घुमाव अलग-अलग अभ्यास के लायक हैं।";
"algs.info.megaminxco.insights.p2" = "क्योंकि 16 मामले हैं, एक सपाट सूची को याद करने की तुलना में कोने के पैटर्न के आधार पर समूह बनाना अधिक प्रभावी है।";
"algs.info.megaminxco.insights.p3" = "अच्छा CO निष्पादन EP और CP को साफ़-साफ़ सेट करता है, इसलिए AUF और समाप्ति कोण को नज़रअंदाज न करें।";
"algs.info.megaminxco.recognition.p1" = "पहचान EO हल होने के बाद पांच अंतिम-परत कोनों के अभिविन्यास पैटर्न पर आधारित है।";
"algs.info.megaminxco.recommended.p1" = "EO के बाद अनुशंसित. यह स्थिर Megaminx 4LLL के लिए मुख्य सेटों में से एक है।";
"algs.info.megaminxco.quote.p1" = "Megaminx CO 3x3 सॉल्वरों का स्वागत करने के लिए काफी परिचित है, लेकिन ऑटोपायलट को दंडित करने के लिए काफी अलग है।";
