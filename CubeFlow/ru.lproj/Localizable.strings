"algs.item.f2l.title" = "F2L";
"algs.item.f2l.description" = "F2L решает первые два слоя, соединяя угол и край и вставляя их вместе.";
"algs.item.oll.title" = "OLL";
"algs.item.oll.description" = "OLL ориентирует все части последнего слоя так, чтобы верхняя грань стала одного сплошного цвета.";
"algs.item.pll.title" = "PLL";
"algs.item.pll.description" = "PLL меняет местами все части последнего слоя после того, как они уже ориентированы.";
"algs.item.advancedf2l.title" = "Advanced F2L";
"algs.item.advancedf2l.description" = "Advanced F2L расширяет стандартную вставку пар более специализированными решениями для конкретных случаев первых двух слоев.";
"algs.item.coll.title" = "COLL";
"algs.item.coll.description" = "COLL решает и ориентирует все углы последнего слоя, когда края уже ориентированы.";
"algs.item.wv.title" = "Winter Variation (WV)";
"algs.item.wv.description" = "Зимняя вариация решает последнюю пару F2L, ориентируя при этом все края последнего слоя.";
"algs.item.sv.title" = "Summer Variation (SV)";
"algs.item.sv.description" = "Летний вариант решает последнюю пару F2L, ориентируя при этом все углы последнего слоя.";
"algs.item.cls.title" = "Corner Last Slot (CLS)";
"algs.item.cls.description" = "CLS решает последний слот F2L, управляя последним слоем в одном алгоритме.";
"algs.item.sbls.title" = "Second Block Last Slot";
"algs.item.sbls.description" = "Second Block Last Slot завершает последний слот второго блока в Roux при подготовке последнего слоя.";
"algs.item.cmll.title" = "CMLL";
"algs.item.cmll.description" = "CMLL решает все углы последнего слоя в Roux после завершения первых двух блоков.";
"algs.item.4a.title" = "Edge Orientation (4a)";
"algs.item.4a.description" = "Ориентация ребер (4a) ориентирует оставшиеся ребра в Roux перед последним шагом решения ребер.";
"algs.item.zbll.title" = "ZBLL";
"algs.item.zbll.description" = "ZBLL решает последний слой в одном алгоритме, когда ребра ориентированы.";
"algs.item.vls.title" = "VLS";
"algs.item.vls.description" = "VLS решает последнюю пару F2L, ориентируя при этом все углы последнего слоя.";
"algs.item.ollcp.title" = "OLLCP";
"algs.item.ollcp.description" = "OLLCP ориентирует последний слой, сохраняя при этом перестановку углов.";
"algs.item.zbls.title" = "ZBLS";
"algs.item.zbls.description" = "ZBLS решает последнюю пару F2L, ориентируя края последнего слоя.";
"algs.item.1lll.title" = "1LLL";
"algs.item.1lll.description" = "1LLL решает весь последний слой с помощью одного алгоритма.";
"algs.item.ortegaoll.title" = "Ortega OLL";
"algs.item.ortegaoll.description" = "Ортега OLL ориентирует все наклейки на последнем слое для 2x2 перед перестановкой.";
"algs.item.ortegapbl.title" = "Ortega PBL";
"algs.item.ortegapbl.description" = "Ortega PBL меняет местами оба слоя в 2x2 после завершения ориентации.";
"algs.item.cll.title" = "CLL";
