"algs.info.f2l.overview.p1" = "**F2L**, viết tắt của **First Two Layers**, giải quyết một cặp cạnh góc và chèn nó vào khe của nó cùng một lúc. Trong CFOP hiện đại, nó thay thế cách tiếp cận cũ hơn dành cho người mới bắt đầu là giải riêng lớp thứ hai và là cốt lõi của việc giải nhanh trước lớp cuối cùng.";
"algs.info.f2l.history.p1" = "Trong speedcubing hiện đại, F2L thường được học như một phần của cấu trúc phương pháp lớn hơn, không phải các công thức rời rạc.";
"algs.info.f2l.size.b1" = "F2L là một bộ trọng tâm, không phải danh sách lớn cần học một lần";
