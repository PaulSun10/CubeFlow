"algs.info.ortegaoll.title" = "Giới thiệu Ortega OLL";
"algs.info.ortegaoll.subtitle" = "Cấu trúc, hiệu quả và ghi chú luyện tập cho Ortega OLL";
"algs.info.ortegaoll.overview.p1" = "**Ortega OLL** định hướng lớp cuối cùng của 2x2 sau khi mặt đầu tiên được tạo. Nó không yêu cầu lớp dưới cùng phải được giải quyết hoàn toàn, đó là lý do tại sao Ortega vẫn nhẹ và linh hoạt so với các phương pháp tiếp cận từng lớp.";
"algs.info.ortegaoll.context.p1" = "Trong speedcubing hiện đại, Ortega OLL thường được học như một phần của cấu trúc phương pháp lớn hơn, không phải các công thức rời rạc.";
"algs.info.ortegaoll.structure.b1" = "Ortega OLL có **7 trường hợp** trong cách phân loại này";
"algs.info.ortegaoll.structure.b2" = "Dùng subset và mẫu nhận diện để luyện ổn định hơn";
"algs.info.ortegaoll.structure.b3" = "Dùng subset và mẫu nhận diện để luyện ổn định hơn";
"algs.info.ortegaoll.structure.b4" = "Dùng subset và mẫu nhận diện để luyện ổn định hơn";
