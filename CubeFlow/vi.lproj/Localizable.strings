"algs.info.zbll.section.quote" = "Trích dẫn";
"algs.info.zbll.overview.p1" = "**ZBLL**, viết tắt của **Zborowski-Bruchem Last Layer**, là một bộ thuật toán nâng cao dùng để giải **toàn bộ lớp cuối cùng trong một lần di chuyển** khi **tất cả các cạnh của lớp trên cùng đã được định hướng**. Nó kết hợp nhận dạng và hoán vị thành một bước duy nhất, thường tạo ra các giải pháp lớp cuối cùng rất hiệu quả.";
"algs.info.zbll.history.p1" = "Trong speedcubing hiện đại, zbll thường được học như một phần của cấu trúc phương pháp lớn hơn, không phải các công thức rời rạc.";
"algs.info.zbll.size.b1" = "zbll có **472 trường hợp** trong cách phân loại này";
"algs.info.zbll.size.b2" = "Dùng subset và mẫu nhận diện để luyện ổn định hơn";
"algs.info.zbll.size.b3" = "Dùng subset và mẫu nhận diện để luyện ổn định hơn";
"algs.info.zbll.size.b4" = "Dùng subset và mẫu nhận diện để luyện ổn định hơn";
"algs.info.zbll.insights.p1" = "Giá trị của nó rõ nhất khi nhận diện nhanh, thực hiện ổn định và luyện trong bối cảnh giống solve thật.";
"algs.info.zbll.insights.p2" = "Giá trị của nó rõ nhất khi nhận diện nhanh, thực hiện ổn định và luyện trong bối cảnh giống solve thật.";
"algs.info.zbll.insights.p3" = "Giá trị của nó rõ nhất khi nhận diện nhanh, thực hiện ổn định và luyện trong bối cảnh giống solve thật.";
"algs.info.zbll.recognition.p1" = "Nhận diện bắt đầu từ mẫu chính, rồi xác nhận bằng các chi tiết vị trí và hướng để phân biệt những trường hợp giống nhau.";
"algs.info.zbll.recommended.p1" = "Phù hợp sau khi nền tảng zbll đã ổn và bạn muốn giai đoạn này nhanh, gọn hơn.";
